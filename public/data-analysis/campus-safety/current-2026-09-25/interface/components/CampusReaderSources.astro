---
import context from '../data/campus-school-context.json';
const {institutions}=Astro.props;
const schools=[...institutions].sort((a:any,b:any)=>a.officialName.localeCompare(b.officialName));
---
<section id="reader-sources" class="analysis-section reader-sources" aria-labelledby="reader-sources-heading" data-campus-verbatim>
  <details><summary id="reader-sources-heading">School guide sources</summary><ol>{schools.map((s:any,index:number)=><li id={`reader-source-${s.id}`} tabindex="-1"><strong>[S{index+1}] {s.officialName}</strong>. {context[s.id].sources.map((source:any)=><a data-citation-exempt href={source.url}>{source.label}</a>)} <a data-reader-return={s.id} href="#reader-reading">Return to this school’s explanation</a></li>)}</ol>
  <p id="reader-source-calculations" tabindex="-1">[R1] Counts, editions, geographic scope and calculations: <a data-citation-exempt href="/data-analysis/campus-safety/current-2026-09-25/source_cells.csv">source-cell ledger</a>, <a data-citation-exempt href="/data-analysis/campus-safety/current-2026-09-25/rates.csv">calculated rates</a>, <a data-citation-exempt href="/data-analysis/campus-safety/current-2026-09-25/source_inventory.json">institutional inventory</a>. <a href="#reader-reading">Return to the explanation</a>.</p>
  <p id="reader-source-population" tabindex="-1">[R2] Housing occupancy: <a data-citation-exempt href="https://www.auditor.ca.gov/wp-content/uploads/2025/10/2024-111-Report.pdf#page=62">California State Auditor, Tables A.1–A.2</a>. Enrollment: <a data-citation-exempt href="https://nces.ed.gov/ipeds/use-the-data/download-access-database">Integrated Postsecondary Education Data System complete files</a>. Population records: <a data-citation-exempt href="/data-analysis/campus-safety/data/housing_occupancy.csv">housing occupancy</a> and <a data-citation-exempt href="/data-analysis/campus-safety/data/enrollment_denominators.csv">enrollment</a>. <a href="#reader-reading">Return to the explanation</a>.</p>
  </details>
</section>
