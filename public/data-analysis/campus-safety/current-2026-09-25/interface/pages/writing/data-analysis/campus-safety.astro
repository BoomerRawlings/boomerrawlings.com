---
import { getCollection, render } from 'astro:content';
import { readFileSync } from 'node:fs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CampusExplorer from '../../../components/CampusExplorer.astro';
import CampusGeography from '../../../components/CampusGeography.astro';
import CampusReader from '../../../components/CampusReader.astro';
import CampusReaderSources from '../../../components/CampusReaderSources.astro';
import CampusReferences from '../../../components/CampusReferences.astro';
import CampusAbbreviations from '../../../components/CampusAbbreviations.astro';
import 'katex/dist/katex.min.css';
import '../../../styles/data-analysis.css';
import '../../../styles/campus-safety.css';
const entry = (await getCollection('archive')).find(e=>e.data.slug==='campus-safety')!;
const {Content} = await render(entry);
const base='/data-analysis/campus-safety';
const revision=`${base}/current-2026-09-25`;
const federalData=JSON.parse(readFileSync(`public${base}/data/dataset.json`,'utf8'));
const data=JSON.parse(readFileSync(`public${revision}/dataset.json`,'utf8'));
const geography=JSON.parse(readFileSync(`public${revision}/geography.json`,'utf8'));
const inventory=JSON.parse(readFileSync(`public${revision}/source_inventory.json`,'utf8'));
const coverage=JSON.parse(readFileSync(`public${revision}/coverage.json`,'utf8'));
const cases=JSON.parse(readFileSync(`public${revision}/case_study.json`,'utf8'));
const periods=[2022,2023,2024,'pooled'];
const n=(v:number)=>v.toLocaleString('en-US');
const example=(unitid:string,period:number|string)=>cases.find((r:any)=>r.unitid===unitid&&r.period===period);
---
<BaseLayout title={entry.data.title} description={entry.data.description} pageType="article" publishedTime="2026-09-25">
  <CampusAbbreviations institutions={data.institutions}><CampusReferences>
  <div class="analysis-page campus-study" data-campus-study>
    <header class="analysis-intro">
      <nav class="analysis-back" aria-label="Breadcrumb"><a href="/writing/">Writing</a><span aria-hidden="true"> / </span><a href="/writing/data-analysis/">Data Analysis</a></nav>
      <h1>Campus safety, in proportion.</h1>
      <p class="analysis-deck">Explore reported crime across 42 universities, with student populations and reporting context alongside the numbers.</p>
    </header>
    <section class="reader-overview" aria-labelledby="reader-overview-heading">
      <h2 id="reader-overview-heading">What this study tells us</h2>
      <p>A larger crime total does not, by itself, mean a university is less safe. This study puts reported offenses in context: the population, location and year covered. Rates per 1,000 residents help account for population size; they do not measure a student’s chance of experiencing crime. <a data-campus-citation href={`${revision}/rates.csv`}>Current counts, populations and rates</a> <a data-campus-citation href="https://bjs.ojp.gov/content/pub/pdf/ccsvsftr.pdf#page=131">Bureau of Justice Statistics: campus survey and reported-crime comparison</a></p>
      <p>The starting focus is student housing. For 2024, {coverage.available_rates['2024'].residents} of the 42 schools have enough verified data for a rate combining the listed housing offenses. Missing rates mean a comparison is unavailable, not that no crimes were reported. Housing is also included in the wider on-campus total, so those counts should not be added together. <a data-campus-citation href={`${revision}/coverage.json`}>Current coverage and exclusion record</a> <a data-campus-citation href="https://www.ecfr.gov/current/title-34/subtitle-B/chapter-VI/part-668/subpart-D/section-668.46">Federal definitions and reporting geography</a></p>
      <p class="reader-overview-next">Choose a region or school below for a plain-English breakdown by year, type of report and location. Detailed tables, methods and the downloadable report follow.</p>
    </section>
    <CampusReader data={data} />
    <details id="campus-technical" class="reader-technical"><summary>Detailed comparisons, geographic breakdowns and research methods</summary>
    <nav class="analysis-section-nav" aria-label="Study sections"><a href="#explorer">Rate explorer</a><a href="#report-geography">Geography</a><a href="#case-study">Housing comparison</a><a href="#source-inventory">Current sources</a><a href="#methods">Methods &amp; related research</a><a href="#downloads">Data &amp; audits</a><a href="#sources">Sources</a></nav>
    <p class="analysis-note campus-explorer-sources">Default counts use the current institutional reports identified in the source inventory <a data-campus-citation href={`${revision}/source_inventory.json`}>Current official-source inventory</a>. The archived 2025 federal collection remains selectable <a data-campus-citation href="https://ope.ed.gov/campussafety/api/dataFiles/file?fileName=Crime2025EXCEL.zip">Federal bulk data</a>. Housing populations come from the California State Auditor and dated institutional housing records <a data-campus-citation href={`${revision}/population_sources.csv`}>Population sources, dates and scope</a>; fall enrollment for the optional comparison comes from IPEDS <a data-campus-citation href="https://nces.ed.gov/ipeds/use-the-data/download-access-database">IPEDS enrollment files</a>. Every current count retains its source edition, year, location, page and processing status <a data-campus-citation href={`${revision}/source_cells.csv`}>Current source-cell ledger</a>.</p>
    <p class="analysis-note">Select a column heading to sort; select it again to reverse the order. Abbreviations are written out on first use. Hover over or focus an abbreviation for its full name or definition. <a data-campus-citation href={`${base}/data/PRESENTATION_REVISION.md`}>Abbreviation definitions and sources</a>.</p>
    <CampusExplorer data={data} federalData={federalData} />
    <CampusGeography data={geography} dataUrl={`${revision}/geography.json`} />
    <section id="case-study" class="analysis-section" aria-labelledby="campus-case-heading">
      <div class="analysis-section-title"><span>02</span><div><h2 id="campus-case-heading">Housing reports: the time window matters</h2><p>A worked comparison from the originating UC and San Diego State research.</p></div></div>
      <p>Current institutional reports give <strong>20</strong> residential-facility rape offenses at UC San Diego <a data-campus-citation href="https://www.police.ucsd.edu/docs/annualclery.pdf#page=142">UCSD 2025 report, reissued February 2026, p. 142</a> and <strong>1</strong> at SDSU's main campus for report year 2024 <a data-campus-citation href="https://police.sdsu.edu/_resources/files/asr_2026_newdraft.pdf#page=7">SDSU 2026 report, p. 7</a>. Against documented fall housing occupancy <a data-campus-citation href="https://www.auditor.ca.gov/wp-content/uploads/2025/10/2024-111-Report.pdf#page=62">State Auditor, Tables A.1–A.2</a>, that is <strong>0.91</strong> and <strong>0.12 per 1,000 residents</strong>. Across 2022–2024, the current versioned pooled ratios are <strong>0.73</strong> and <strong>0.74</strong>.</p>
      <aside class="analysis-notice"><strong>Why SDSU reports three for 2024.</strong> One residential rape offense is included in one on-campus offense. Two more were reported in noncampus geography; public property contributes zero. Thus <strong>1 + 2 + 0 = 3</strong> across the three nonoverlapping reporting areas. The earlier figure of one was a housing/on-campus count, not the all-geography total. Both report editions agree on those 2024 values. Dividing all three by the housing-only population would change the numerator's geographic scope. <a data-campus-citation href="https://police.sdsu.edu/_resources/files/asr_2026_newdraft.pdf#page=7">SDSU 2026 report, p. 7</a> <a data-campus-citation href="https://police.sdsu.edu/_resources/files/annual-security-reports/2025-annual-security-report-finalized-08-18-25.pdf#page=7">SDSU 2025 report, p. 7</a></aside>
      <p class="analysis-note">A separate revision affects 2023: SDSU housing rape changes from 7 in the 2025 report to 8 in the 2026 report. Its 2022–2024 pooled count therefore changes from 17 to 18, and its ratio from 0.70 to 0.74 per 1,000. The 2022 value retains its older report attribution because the newest edition begins in 2023. The current 2025 main-campus figures are housing 10, campus total 11, noncampus 5, public 0: combined 16. Report edition 2026 does not mean calendar-year 2026 data. <a data-campus-citation href="https://police.sdsu.edu/_resources/files/asr_2026_newdraft.pdf#page=7">SDSU 2026 report, p. 7</a> <a data-campus-citation href={`${revision}/case_study.json`}>Versioned housing calculations and sources</a></p>
      <p class="analysis-note">These are approximate descriptive ratios. Housing boundaries are not fully matched to the population inventory; reports need not involve resident students. Neither similarity nor difference establishes equivalent safety or victimization risk.</p>
      <div class="analysis-table-scroll" tabindex="0" role="region" aria-label="UC San Diego and SDSU main-campus housing comparison"><table><caption>Residential-facility rape offenses / actual fall housing occupancy</caption><thead><tr><th scope="col">Report period</th><th scope="col">UC San Diego: count / population</th><th scope="col">Rate per 1,000</th><th scope="col">SDSU main: count / population</th><th scope="col">Rate per 1,000</th></tr></thead><tbody>{periods.map(period=>{const u=example('110680',period);const s=example('122409',period);return <tr><th scope="row">{period==='pooled'?'2022–2024 pooled':period}</th><td>{n(u.asr_housing_rape_count)} / {n(u.fall_occupancy_sum)}</td><td>{u.rate_per_1000.toFixed(2)}</td><td>{n(s.asr_housing_rape_count)} / {n(s.fall_occupancy_sum)}</td><td>{s.rate_per_1000.toFixed(2)}</td></tr>;})}</tbody></table></div>
      <p class="analysis-note">Pooled denominators sum three fall snapshots, not unique people. SDSU uses the 2025 edition for 2022 and the 2026 edition for 2023–2024. Table sources: <a data-campus-citation href="https://www.police.ucsd.edu/docs/annualclery.pdf#page=142">UCSD 2025 ASR, p. 142</a> <a data-campus-citation href="https://police.sdsu.edu/_resources/files/annual-security-reports/2025-annual-security-report-finalized-08-18-25.pdf#page=7">SDSU 2025 ASR, p. 7</a> <a data-campus-citation href="https://www.auditor.ca.gov/wp-content/uploads/2025/10/2024-111-Report.pdf#page=62">State Auditor, Tables A.1–A.2</a>. <a data-campus-citation href="https://police.sdsu.edu/_resources/files/asr_2026_newdraft.pdf#page=7">SDSU 2026 report, p. 7</a> <a data-citation-exempt href={`${revision}/case_study.json`}>Download the current calculation</a>.</p>
    </section>
    <section id="source-inventory" class="analysis-section" aria-labelledby="current-sources-heading">
      <div class="analysis-section-title"><span>03</span><div><h2 id="current-sources-heading">Current source inventory</h2><p>All 42 institutions searched. Each entry distinguishes the official listing, retrieved edition, table coverage and verification limits.</p></div></div>
      <p>Checked 25 September 2026. A retrieved report may contain revised older years, incomplete geographic coverage or inconsistent labels. An inaccessible source is not certified current. Exact retrieval times, source hashes, raw cells and decisions accompany the downloads. <a data-campus-citation href={`${revision}/source_inventory.json`}>Dated institutional source inventory</a> <a data-campus-citation href={`${revision}/source_cells.csv`}>Source cells and analysis decisions</a></p>
      <div class="analysis-table-scroll" tabindex="0" role="region" aria-label="Current institutional sources"><table class="campus-source-inventory"><caption>Official annual reports and verification status</caption><thead><tr><th scope="col">Institution</th><th scope="col">Editions / data years</th><th scope="col">Verification and qualifications</th><th scope="col">Official sources</th></tr></thead><tbody>{inventory.map((item:any)=><tr><th scope="row">{item.institution}</th><td>{item.editions.join(', ')}<br /><span class="analysis-note">{item.report_years.length?item.report_years.join(', '):'Years not verified'}</span></td><td>{item.verification}<details><summary>Scope and source limits</summary>{item.qualifications.map((note:string)=><p>{note}</p>)}</details></td><td><a data-campus-citation href={item.landing_url}>{item.institution}: official annual-report listing</a>{item.report_url&&<a data-campus-citation href={item.report_url}>{item.institution}: annual report identified in this review</a>}</td></tr>)}</tbody></table></div>
    </section>
    <section id="source-notes" class="analysis-section" aria-labelledby="campus-source-heading">
      <div class="analysis-section-title"><span>03</span><div><h2 id="campus-source-heading">Source details that change interpretation</h2><p>Documented discrepancies and counting conventions remain visible in the results.</p></div></div>
      <div class="campus-case-grid">
        <article><h3>One disclosure can contain many offenses</h3><p>UC Santa Cruz's 2025 report explains that <strong>21 of its 38 residential rape offenses reported in 2024</strong> were disclosed in a single report. The published offense count is retained. It cannot be relabeled as 38 people or 38 report forms. <a data-campus-citation href="https://bpb-us-w2.wpmucdn.com/wordpress.ucsc.edu/dist/d/120/files/2026/05/UC-Santa-Cruz-2025-Annual-Security-Fire-Safety-Report-FINAL-Republished-May-6-2026.pdf#page=11">UCSC report, reissued May 2026, p. 11, footnote 6</a></p></article>
        <article><h3>Federal and campus tables can differ</h3><p>UCSD's 2022 on-campus rape count is <strong>14 in the frozen federal file</strong> and <strong>15 in its 2025 ASR</strong>; the noncampus count is 4 versus 5. The updated explorer uses the current report; the federal values remain selectable as an archived source. The original 36-cell comparison is preserved alongside the expanded source audit. <a data-campus-citation href={`${base}/data/asr_federal_rape_comparison.csv`}>Inspect all 36 source-cell comparisons</a> <a data-campus-citation href="https://www.police.ucsd.edu/docs/annualclery.pdf#page=142">UCSD 2025 ASR, p. 142</a> <a data-campus-citation href="https://ope.ed.gov/campussafety/api/dataFiles/file?fileName=Crime2025EXCEL.zip">2025 federal collection</a></p></article>
        <article><h3>Enrollment definitions require consistency</h3><p>For fall 2024, IPEDS reports <strong>41,137 students at SDSU</strong>; its Common Data Set and the State Auditor use <strong>39,373</strong>. The full population difference remains unresolved. The enrollment explorer uses IPEDS consistently across all institutions and years. <a data-campus-citation href={`${base}/data/DENOMINATORS.md`}>Review the denominator reconciliation</a> <a data-campus-citation href="https://asir.sdsu.edu/Documents/CommonDataSets/CDS_2024-25.pdf#page=3">SDSU Common Data Set, p. 3</a> <a data-campus-citation href="https://www.auditor.ca.gov/wp-content/uploads/2025/10/2024-111-Report.pdf#page=62">State Auditor, Tables A.1–A.2</a></p></article>
        <article><h3>Missing coverage is not a zero</h3><p>Current-source coverage differs from the frozen federal snapshot. Source conflicts, missing years and unverified reports withhold affected rates. Population coverage is especially limited for 2025: an available count does not guarantee an available rate. Explicitly absent geography is distinguished from an unreported column. <a data-campus-citation href={`${revision}/coverage.json`}>Current coverage and exclusion record</a></p></article>
      </div>
    </section>
    <section id="methods" class="analysis-section" aria-labelledby="campus-methods-heading">
      <div class="analysis-section-title"><span>04</span><div><h2 id="campus-methods-heading">Methods and related research</h2><p>Definitions, formulas, source alignment and interpretive limits.</p></div></div>
      <article class="analysis-prose"><Content /></article>
    </section>
    <section id="downloads" class="analysis-section" aria-labelledby="campus-downloads-heading">
      <div class="analysis-section-title"><span>05</span><div><h2 id="campus-downloads-heading">Data, sources and audit record</h2><p>Inspect the inputs and calculations behind the website.</p></div></div>
      <div class="analysis-downloads"><a href={`${revision}/campus-safety-current-report.pdf`}><strong>Current research report</strong><span>Geographic reconciliation, current source review, methods and limits · PDF</span></a><a href={`${revision}/campus-safety-current-reproducibility.zip`}><strong>Current data and audit package</strong><span>Source cells, versioned calculations, code and verification · ZIP</span></a><a href={`${revision}/rates.csv`}><strong>Current annual and pooled rates</strong><span>All categories; missing and withheld values retained · CSV</span></a><a href={`${revision}/source_cells.csv`}><strong>Source-cell ledger</strong><span>Raw values, source editions, geographic scope and calculation decisions · CSV</span></a><a href={`${revision}/source_inventory.json`}><strong>Current source inventory</strong><span>All 42 institutions, retrieval dates and qualification · JSON</span></a><a href={`${revision}/artifact_manifest.json`}><strong>Current artifact manifest</strong><span>File sizes and SHA-256 checksums · JSON</span></a></div>
      <p class="analysis-note"><a href={`${revision}/population_sources.csv`}>Population sources and scope · CSV</a> · <a href={`${revision}/expansion/population_candidates.csv`}>Housing-source search and exclusions · CSV</a> · <a href={`${revision}/EXPANSION_AMENDMENT.md`}>Coverage expansion record</a></p>
      <details class="analysis-details"><summary>Preserved federal snapshot and original report</summary><p>These files preserve the original 2025 federal collection and earlier analysis. Some counts and the SDSU pooled case have since been revised. Use the current report above for the updated findings; the archived source remains selectable in the explorer.</p><p><a href={`${base}/downloads/campus-safety-report.pdf`}>Archived original report · PDF</a> · <a href={`${base}/downloads/campus-safety-reproducibility.zip`}>Archived reproducibility package · ZIP</a> · <a href={`${base}/data/annual_rates.csv`}>Archived annual rates</a> · <a href={`${base}/data/pooled_rates.csv`}>Archived pooled rates</a> · <a href={`${base}/data/artifact_manifest.json`}>Archived artifact manifest</a></p></details>
      <div class="campus-audits"><article><h3>Calculations and data</h3><p>Independent source joins, arithmetic, pooled denominators, missingness and category reconciliation.</p><a href={`${revision}/CURRENT_DATA_AUDIT.md`}>Read the current numerical audit</a></article><article><h3>Methods and presentation</h3><p>Comparable primary research, mathematical notation and responsive website/PDF checks.</p><a href={`${base}/data/RESEARCH_REVIEW.md`}>Related research</a> · <a href={`${revision}/VISUAL_AUDIT.md`}>Current visual audit</a></article><article><h3>Sources and citations</h3><p>A separate claim-by-claim audit of source support, locators and qualification.</p><a href={`${revision}/CURRENT_CITATION_AUDIT.md`}>Read the current citation audit</a></article></div>
      <p class="analysis-note">This study reports documented administrative measures. It is not externally peer reviewed, and source verification does not establish complete reporting or matched personal exposure. Study snapshot: 25 September 2026.</p>
    </section>
    </details>
    <CampusReaderSources institutions={data.institutions} />
  </div>
  </CampusReferences></CampusAbbreviations>
</BaseLayout>
<script>
  // Preserve direct links into the detailed research while keeping the opening view readable.
  function revealStudyTarget(){
    let id;try{id=decodeURIComponent(location.hash.slice(1));}catch{return;}
    const target=document.getElementById(id);if(!target)return;
    let parent=target.parentElement;
    while(parent){if(parent instanceof HTMLDetailsElement)parent.open=true;parent=parent.parentElement;}
    target.scrollIntoView({block:'start'});
  }
  window.addEventListener('hashchange',revealStudyTarget);
  if(location.hash)revealStudyTarget();
  document.addEventListener('click',event=>{
    const link=(event.target as Element)?.closest<HTMLAnchorElement>('a[href^="#"]');
    if(link?.hash===location.hash)revealStudyTarget();
  });
</script>
