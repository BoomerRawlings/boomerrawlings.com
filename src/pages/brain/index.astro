---
import { categories, topics, sources } from '../../../public/brain/curriculum.js';
import '../../styles/brain.css';
import '../../styles/brain-practice.css';
import '../../styles/brain-cards-visuals.css';
import '../../styles/brain-structure-picker.css';
import '../../styles/brain-recognition.css';
import '../../styles/brain-navigation.css';
import '../../styles/brain-courses.css';
import '../../styles/brain-lectures.css';
import '../../styles/brain-lecture-presenter.css';
import BrainStructurePicker from '../../components/BrainStructurePicker.astro';
import BrainFlashcards from '../../components/BrainFlashcards.astro';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Explore neuroscience across eight scales: an interactive 3D brain atlas, pathways, neurons, synapses, neurotransmitters, channels and plasticity. Layered explanations and active recall." />
  <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
  <meta name="referrer" content="no-referrer" />
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'" />
  <link rel="canonical" href="https://boomerrawlings.com/brain/" />
  <link rel="icon" href="/brain/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#080e16" />
  <title>Brain — Neuroscience study guide · Boomer Rawlings</title>
</head>
<body>
  <a class="skip-link" href="#workspace">Skip to explorer</a>
  <header class="site-header">
    <a class="wordmark" href="/brain/" aria-label="Brain home"><svg class="brain-mark" viewBox="0 0 44 44" aria-hidden="true"><g class="logo-orbit logo-orbit-a"><ellipse cx="22" cy="22" rx="18" ry="9"/><circle class="logo-electron" cx="40" cy="22" r="2"/></g><g class="logo-orbit logo-orbit-b"><ellipse cx="22" cy="22" rx="18" ry="9"/><circle class="logo-electron" cx="4" cy="22" r="1.6"/></g><circle class="logo-core" cx="22" cy="22" r="3"/></svg><span>BRAIN<span class="wordmark-sub">Neuroscience atlas</span></span></a>
    <nav class="main-nav" aria-label="Study modes"><button data-mode="explore" aria-pressed="true">Explore <span>01</span></button><button data-mode="paths" aria-pressed="false">Study sequences <span>02</span></button><button data-mode="recall" aria-pressed="false">Practice <span>03</span></button><button data-mode="lectures" aria-pressed="false">Lectures <span>04</span></button></nav>
    <a class="owner-link" href="/">Boomer Rawlings <span aria-hidden="true">↗</span></a>
  </header>
  <main>
    <section class="intro" aria-labelledby="page-title"><h1 id="page-title">Neuroscience study guide</h1></section>
    <section id="brain-courses" aria-label="Course study materials"></section>
    <section id="lectures-panel" aria-labelledby="lectures-heading" tabindex="-1" hidden></section>
    <section id="paths-panel" class="mode-panel" hidden aria-labelledby="paths-heading"><div class="section-heading"><div><h2 id="paths-heading">Study sequences</h2></div><p>Ordered topics covering anatomy and mechanisms. Progress is saved in this browser.</p></div><div id="journey-cards" class="journey-cards"></div></section>
    <section id="recall-panel" class="practice-panel" hidden aria-labelledby="recall-heading">
      <div class="practice-heading"><div><h2 id="recall-heading">Practice</h2><p>Animated flashcards, explanations, and applied recall.</p></div><div class="practice-switch" role="group" aria-label="Practice format"><button data-practice-format="cards" aria-pressed="true">Flashcards</button><button data-practice-format="questions" aria-pressed="false">Questions</button></div></div>
      <BrainFlashcards />
      <div id="question-practice" class="quiz-practice" hidden><div class="section-heading"><h3>Practice questions</h3><label class="recall-filter">Practice scope<select id="recall-scope"><option value="all">All topics</option>{categories.map(c=><option value={c.id}>{c.title}</option>)}</select></label></div><div id="recall-start" class="recall-start"><p>Ten questions with explanations and review of incorrect answers.</p><button class="primary" id="start-recall">Start a round <span>↗</span></button><button class="subtle" id="review-missed" hidden>Review missed questions</button></div><div id="recall-quiz" hidden><div class="recall-progress"><span id="recall-counter"></span><span id="recall-score"></span></div><progress id="recall-progress" max="10" value="0" aria-label="Recall round progress"></progress><h3 id="recall-question" tabindex="-1"></h3><div id="recall-answers"></div><div id="recall-feedback" role="status" hidden></div><div class="recall-actions"><button id="recall-next" class="primary" hidden>Next question →</button><button id="recall-explore" class="subtle" hidden>Explore this concept ↗</button></div></div><div id="recall-result" hidden></div></div>
    </section>
    <div id="active-journey" class="active-journey" hidden><span id="journey-label"></span><div><button id="journey-prev" aria-label="Previous journey topic">←</button><span id="journey-step"></span><button id="journey-next" aria-label="Next journey topic">→</button><button id="journey-practice">Practice sequence</button><button id="journey-exit" class="subtle">Exit sequence</button></div></div>
    <section id="workspace" class="workspace" aria-label="Interactive neuroscience atlas" tabindex="-1">
      <aside class="library" aria-label="Topic library"><div class="library-top"><span class="eyebrow">Topics</span><button id="bookmarks-filter" aria-pressed="false" title="Show saved topics" aria-label="Show saved topics">☆</button></div><label class="search-wrap"><span aria-hidden="true">⌕</span><input id="topic-search" type="search" autocomplete="off" placeholder="Search topics…" aria-label="Search neuroscience topics" /><kbd>/</kbd></label><div class="library-count" id="library-count">{topics.length} topics</div><select id="mobile-topic" aria-label="Choose a neuroscience topic"><option value="">Choose a topic</option>{categories.map(c=><optgroup label={c.title}>{topics.filter(t=>t.category===c.id).map(t=><option value={t.id}>{t.title}</option>)}</optgroup>)}</select><nav id="topic-library" aria-label="Neuroscience scales">{categories.map((category,index)=><details class="topic-group" data-category={category.id} open={index===0}><summary><span class="chapter-number">{(index+1).toString().padStart(2,'0')}</span><span>{category.title}</span><span class="category-count">{topics.filter(t=>t.category===category.id).length}</span></summary><div class="topic-items">{topics.filter(t=>t.category===category.id).map(topic=><button class="topic-item" data-topic={topic.id}><span>{topic.title}</span><span class="topic-indicator" aria-hidden="true">↗</span></button>)}</div></details>)}</nav><p id="empty-library" hidden>No matching concepts. Try “dopamine,” “myelin,” or “memory.”</p><div class="study-progress"><span id="study-progress-label">Study progress · 0/{topics.length}</span><progress id="study-progress" max={topics.length} value="0" aria-label="Topics marked understood"></progress><span>Stored on this device</span></div></aside>
      <div class="viewer-column"><div class="viewer-topline"><div><span class="eyebrow" id="scene-category">01 / Anatomy</span><h2 id="scene-title">The human brain</h2></div><span id="scale-badge" class="scale-badge">Organ scale</span></div><nav class="model-trail" id="model-trail" aria-label="Exploration trail"></nav><div id="model-representations" class="model-representations" role="group" aria-label="Model views" hidden></div><div class="viewer-stage"><div id="brain-viewer" role="group" aria-label="Interactive three-dimensional neuroscience model. Use the topic library and model controls to explore."></div><div class="viewer-loader" id="viewer-loading"><span class="loading-orbit"></span><span>Loading model…</span></div><div class="model-fallback" id="model-fallback" hidden><svg viewBox="0 0 180 150" aria-hidden="true"><path d="M87 125C55 140 20 111 30 88 7 68 29 31 51 37 53 12 85 8 93 30 113 6 146 28 140 49 170 51 177 87 150 98 151 124 113 143 99 120M93 30 93 120M51 37Q82 35 65 60M30 88Q55 78 62 100M140 49Q118 43 120 69M150 98Q120 79 115 107"/></svg><h3>3D model unavailable</h3><p>The 3D canvas is unavailable on this browser. All explanations, study sequences and recall questions remain available.</p></div><div class="stage-corner"><span class="corner-cross">+</span><span id="model-kind">3D study atlas</span></div><div class="detail-meter" aria-label="Model detail"><span id="detail-name">Overview</span><span class="detail-dots" id="detail-dots" aria-hidden="true">● ○ ○ ○</span></div><div id="model-selection" class="model-selection" hidden><strong id="selection-name"></strong><span id="selection-description"></span></div><div class="viewer-hint">Hover to identify <span>·</span> Click to focus <span>·</span> Scroll to zoom</div></div><div class="structure-controls"><BrainStructurePicker /><button id="model-enter" hidden>Open related topic ↗</button><button id="model-unfocus" hidden aria-label="Return to whole model">↶ Whole model</button></div><div class="model-timeline" id="model-timeline" hidden><div class="timeline-heading"><span id="animation-step"></span><span id="animation-time"></span></div><input id="animation-scrub" type="range" min="0" max="1000" value="0" aria-label="Animation position"/><div id="animation-steps" class="animation-steps"></div><p id="animation-description"></p></div><div class="viewer-controls" role="group" aria-label="3D model controls"><select id="model-view" aria-label="Camera view"><option value="perspective">Default view</option><option value="lateral">Right lateral</option><option value="superior">Superior</option><option value="anterior">Anterior</option></select><button id="model-zoom-out" aria-label="Zoom out">−</button><button id="model-zoom-in" aria-label="Zoom in">+</button><button id="model-reset" title="Reset camera"><span aria-hidden="true">↺</span> Reset</button><button id="model-explode" aria-pressed="false"><span aria-hidden="true">⌘</span> Separate</button><button id="model-labels" aria-pressed="true"><span aria-hidden="true">⊙</span> Labels</button><button id="model-motion" aria-pressed="true"><span aria-hidden="true">Ⅱ</span> Motion</button><button id="model-fullscreen" aria-label="Expand model" title="Expand model"><span aria-hidden="true">⛶</span></button></div><p id="separation-note" class="separation-note" hidden>Separated view · positions displaced for inspection. Reassemble to restore anatomical relationships.</p><p id="model-provenance" class="model-provenance" aria-live="polite">Loading model provenance…</p></div>
      <article class="reader" aria-labelledby="topic-title"><div class="reader-top"><span class="eyebrow" id="topic-number">Topic 001</span><button id="bookmark-topic" aria-pressed="false" aria-label="Save this topic" title="Save this topic">☆</button></div><h2 id="topic-title" tabindex="-1">The human brain</h2><p class="topic-subtitle" id="topic-subtitle"></p><div class="depth-tabs" role="tablist" aria-label="Explanation depth"><button role="tab" id="depth-essentials" data-depth="essentials" aria-selected="true" aria-controls="topic-content">Essentials</button><button role="tab" id="depth-mechanism" data-depth="mechanism" aria-selected="false" aria-controls="topic-content" tabindex="-1">Mechanism</button><button role="tab" id="depth-advanced" data-depth="advanced" aria-selected="false" aria-controls="topic-content" tabindex="-1">Advanced</button></div><div class="reader-scroll"><section id="visual-recognition" class="visual-recognition" aria-label="Visual recognition reference"></section><div id="topic-content" role="tabpanel" aria-labelledby="depth-essentials" tabindex="0"><p>Choose a topic to explore its structure, connections and mechanisms.</p></div><div class="connections"><p class="eyebrow">Related topics</p><div id="topic-connections"></div></div><details class="topic-sources"><summary>Evidence & further reading <span>↗</span></summary><ol id="topic-sources"></ol></details></div><div class="reader-footer"><button id="mark-understood" aria-pressed="false"><span>○</span> Mark understood</button><button id="topic-practice">Review cards ↗</button><button id="next-topic" title="Next topic" aria-label="Next topic">→</button></div></article>
    </section>
    <section class="scale-journey" aria-label="Topics by subject"><div><span class="eyebrow">Topics by subject</span></div><div id="scale-links">{categories.map((c,i)=><button data-scale={c.id}><span>{(i+1).toString().padStart(2,'0')}</span>{c.title}<b>↗</b></button>)}</div></section>
    <details class="source-ledger" id="sources"><summary><span>Sources & model credits<small>References, provenance and study instructions</small></span><span>+</span></summary><div class="ledger-grid"><section><h2>How to study</h2><p>BRAIN: Boomer’s Ridiculously Ambitious Interactive Neuroscience.</p><p>Start with Essentials. Explain the mechanism in your own words, then test it in Practice. Flashcards cover recall, mechanisms and applications; rate your retrieval to schedule a review. Follow connections across scales; a brain region is never a complete explanation of a behavior.</p><p>“Understood” and saved topics are your own study markers, stored locally in this browser. They are not an assessment of mastery.</p><a href="/psyc/">Open the original photographic anatomy quiz ↗</a></section><section><h2>About the models</h2><p>Human anatomy is derived from the Allen Human Reference Atlas 3D (2020), used under CC BY 4.0. Atlas boundaries are a reference framework; individual brains vary.</p><p>White matter uses HCP1065 population tractography. Measured neuron morphology, PubChem molecular conformers, and six experimental channel structures add detail at smaller scales. Each scene identifies its data and its schematic additions; animations illustrate mechanisms, not measured trajectories.</p><p>Tract reference sections use the <a href="https://www.bic.mni.mcgill.ca/ServicesAtlases/ICBM152NLin2009" target="_blank" rel="noopener noreferrer">ICBM2009a asymmetric MRI template</a> (Fonov et al., 2009, 2011). Copyright © 1993–2004 Louis Collins, McConnell Brain Imaging Centre, Montreal Neurological Institute, McGill University. Permission to use, copy, modify, and distribute this software and its documentation for any purpose and without fee is granted, provided that this copyright notice appears in all copies. Provided “as is,” without express or implied warranty.</p><a href="/brain/models/tracts/reference-mri.json">MRI source, derivation &amp; full permission notice ↗</a><br/><a href="/brain/models/atlas-landmarks.json">Ventricular landmark provenance ↗</a><br/><a href="/brain/models/credits.json">Anatomy & tract credits ↗</a><br/><a href="/brain/models/atlas-details.json">Regional atlas geometry & provenance ↗</a><br/><a href="/brain/models/micro-credits.json">Cell & molecular model credits ↗</a><p>Protein ribbons use deposited wwPDB helix/sheet annotations. Display orientation is rigidly aligned to the <a href="https://opm.phar.umich.edu/" target="_blank" rel="noopener noreferrer">Orientations of Proteins in Membranes database</a> (Lomize et al., University of Michigan). This predicts membrane placement; it does not alter the experimental conformation. Structural formulas retain PubChem connectivity, charges and stereochemistry; the Met-enkephalin 3D view is a computed conformer.</p><a href="/brain/reference/molecules/manifest.json">Chemical reference provenance ↗</a><br/><a href="/brain/models/protein-orientation.json">Protein orientation sources &amp; alignment validation ↗</a></section><section><h2>Reference library</h2><ul>{Object.values(sources).map(source=><li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<span> ↗</span></a></li>)}</ul></section></div></details>
    <noscript><section class="no-script-guide"><h2>Neuroscience study guide</h2><p>JavaScript enables interactive models, search and recall. The complete written guide remains below.</p>{topics.map(topic=><details><summary>{topic.title}</summary>{['essentials','mechanism','advanced'].map(depth=><section><h3>{depth}</h3><p>{topic[depth].summary}</p><ul>{topic[depth].bullets.map(b=><li>{b}</li>)}</ul></section>)}</details>)}</section></noscript>
  </main>
  <footer class="site-footer"><a href="/">Boomer Rawlings</a><a href="#sources">Sources & model credits ↗</a></footer>
  <div id="announcement" class="sr-only" role="status" aria-live="polite"></div>
  <script>import '../../scripts/brain/app';</script>
</body>
</html>
