---
const {directEntry=false}=Astro.props;
const canonical='https://boomerrawlings.com/stars/'+(directEntry?'jumpin/':'');
const title='Stars — an ambient constellation screensaver';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | Boomer Rawlings</title><meta name="description" content="Gently drifting stars occasionally resolve into 88 audited constellation figures. Choose a clock, Scripps surf and sky, and quiet reminders."/><link rel="canonical" href={canonical}/><link rel="stylesheet" href="/stars-assets/stars.css?v=20261019-ambient-settings"/></head>
<body data-direct-entry={directEntry ? "jumpin" : undefined}>
 <canvas id="stars" tabindex="-1" aria-label="Ambient stars and occasional named constellations"></canvas>
 <dialog id="settings" open={!directEntry} aria-labelledby="stars-title">
  <div class="eyebrow">BOOMER RAWLINGS / AMBIENT DISPLAY</div><div class="settings-heading"><h1 id="stars-title">Stars</h1><div class="jump-start"><button id="jump-in" class="jump-in" type="button">Jump in <span aria-hidden="true">↗</span></button><p>10-second constellations · 5-minute reminders</p></div></div>

  <p class="intro">Drifting points, familiar figures, a little sense of time. Jump straight in, or choose what stays on your screen.</p>
  <svg class="settings-line" viewBox="0 0 720 12" fill="none" aria-hidden="true"><path d="M2 3H455L464 9H718"/><g><circle cx="2" cy="3" r="1.5"/><circle cx="455" cy="3" r="1.5"/><circle cx="464" cy="9" r="1.5"/><circle cx="718" cy="9" r="1.5"/></g></svg><form id="settings-form">
   <div class="settings-grid">
    <label>Clock<select name="clock"><option value="12">12 hour · AM / PM</option><option value="24">24 hour</option><option value="off">No clock</option></select></label>
    <label>Time zone<input name="zone" list="timezones" value="system" autocomplete="off" spellcheck="false" aria-describedby="zone-help"/><datalist id="timezones"><option value="system">System time zone</option><option value="America/Los_Angeles"/><option value="America/New_York"/><option value="Europe/London"/><option value="Asia/Tokyo"/><option value="Australia/Sydney"/><option value="UTC"/></datalist></label>
    <div class="settings-toggles"><label class="check"><input name="seconds" type="checkbox" checked/><span>Include seconds</span></label>
    <label class="check"><input name="surf" type="checkbox" checked/><span>Scripps offshore waves</span></label>
    <label class="check"><input name="sky" type="checkbox" checked/><span>Sunrise, sunset &amp; moon phase</span></label></div>
    <label class="slider-setting" for="tips"><span id="tips-label">Self-care reminders</span><output id="tips-value" for="tips">Every 5 minutes</output><input id="tips" name="tips" type="range" min="0" max="6" step="1" value="1" aria-labelledby="tips-label" aria-valuetext="Every 5 minutes"/><span class="slider-ends"><span>Off</span><span>Hourly</span></span></label>
    <label class="slider-setting" for="constellation-interval"><span id="constellation-label">Constellation frequency</span><output id="constellation-value" for="constellation-interval">Every 10 seconds</output><input id="constellation-interval" name="constellationInterval" type="range" min="10" max="60" step="5" value="10" aria-labelledby="constellation-label" aria-valuetext="Every 10 seconds"/><span class="slider-ends"><span>10 seconds</span><span>1 minute</span></span></label>
   </div>
   <p id="zone-help" class="note">“system” follows your device. Or enter an IANA time zone, such as Europe/Paris. Sun and moon events stay at Scripps Pier, San Diego. Waves are an offshore model estimate from Open-Meteo, not breaking surf height.</p>
   <p class="note">Reminders stay for 30 seconds. Your choices are remembered on this device.</p>

   <label class="check fullscreen-choice"><input name="fullscreen" type="checkbox"/><span>Start in fullscreen</span></label>
   <p id="settings-error" role="alert"></p>
   <div class="actions"><button class="primary" type="submit">Apply settings <span aria-hidden="true">↗</span></button><a href="/work/stars/">About the project</a></div>
  </form>
  <p class="hint">Move your pointer or tap to reveal controls. Press S or Esc for settings.</p>
  <noscript><p>JavaScript is needed to animate the stars and save these settings.</p></noscript>
 </dialog>
 <nav id="controls" aria-label="Screensaver controls" hidden><button id="edit" type="button">Settings <kbd>S</kbd></button><button id="fullscreen" type="button">Fullscreen</button><a href="/work/stars/">Project</a></nav>
 <p id="screen-status" class="sr-only" role="status"></p>
 <script is:inline src="/stars-assets/suncalc.js" defer></script><script is:inline src="/stars-assets/sky.js" defer></script><script is:inline src="/stars-assets/effects.js" defer></script><script is:inline src="/stars-assets/reminder-messages.js" defer></script><script is:inline src="/stars-assets/constellation-data.js" defer></script><script is:inline src="/stars-assets/constellations.js?v=20261019-ambient-settings" defer></script><script is:inline type="module" src="/stars-assets/stars.js?v=20261019-jumpin"></script>
</body></html>
