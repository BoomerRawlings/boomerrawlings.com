---
import { getCollection } from 'astro:content';
import CuratorGuide from '../../components/CuratorGuide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const displayDate = (entry: Awaited<ReturnType<typeof getCollection<'archive'>>>[number]) =>
  entry.data.publishedDate ?? entry.data.date ?? entry.data.producedDate;

const entries = (await getCollection('archive', ({ data }) => data.status === 'published'))
  .sort((a, b) => {
    const firstDate = displayDate(a);
    const secondDate = displayDate(b);
    if (!firstDate && !secondDate) return a.data.title.localeCompare(b.data.title);
    if (!firstDate) return 1;
    if (!secondDate) return -1;
    return secondDate.valueOf() - firstDate.valueOf() || a.data.title.localeCompare(b.data.title);
  });
---

<BaseLayout title="All Work" description="Projects and writing by Boomer Rawlings in one view, with only verified dates shown.">
  <section class="page-intro page-intro--guided">
    <p class="eyebrow">Across disciplines</p>
    <h1>All Work</h1>
    <p class="page-deck">All published work in one view. Where a date appears, it is verified.</p>
    <CuratorGuide
      headingId="curator-all-work"
      messages={[
        `I like this view because it puts ${entries.filter(({ data }) => data.type === 'work').length} projects beside ${entries.filter(({ data }) => data.type === 'writing').length} pieces of writing without separating them into different rooms.`,
        'Look for recurring concerns: attention, evidence, privacy, and the work required to make complex material usable.',
        'The ABM proposal is a useful bridge between the psychological questions and the systems thinking.',
      ]}
      nextExhibit={{ href: '/writing/attention-bias-modification-aggression/', label: 'ABM research proposal' }}
    />
  </section>
  <section class="archive-table" aria-label="All work">
    {entries.map((entry) => (
      <a class="archive-row" href={entry.data.externalUrl ?? '/' + entry.data.type + '/' + entry.data.slug + '/'}>
        <span>{displayDate(entry)?.getUTCFullYear() ?? '—'}</span>
        <span>{entry.data.type}</span>
        <span>{entry.data.title}</span>
      </a>
    ))}
  </section>
</BaseLayout>
