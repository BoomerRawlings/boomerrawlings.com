---
import { getCollection } from 'astro:content';
import CuratorGuide from '../../components/CuratorGuide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatMonthYear, isoMonth } from '../../lib/dates';

type ArchiveEntry = Awaited<ReturnType<typeof getCollection<'archive'>>>[number];

const displayDate = (entry: ArchiveEntry) => {
  const value = entry.data.type === 'writing'
    ? entry.data.producedDate ?? entry.data.publishedDate
    : entry.data.date ?? entry.data.publishedDate ?? entry.data.producedDate;
  if (!value) return undefined;
  if (value instanceof Date) return value;

  const [year, month = 1, day = 1] = value.split('-').map(Number);
  return new Date(Date.UTC(year, month - 1, day));
};

const displayKind = (entry: ArchiveEntry) => {
  if (entry.data.type === 'writing') {
    return entry.data.writingKind === 'academic' ? 'Academic writing' : 'Personal writing';
  }

  return entry.data.type === 'work'
    ? (entry.data.projectStage ? 'WIP project' : 'Project')
    : entry.data.type.charAt(0).toUpperCase() + entry.data.type.slice(1);
};

const entries = (await getCollection('archive', ({ data }) => data.status === 'published'))
  .sort((a, b) => {
    const firstDate = displayDate(a);
    const secondDate = displayDate(b);
    if (!firstDate && !secondDate) return a.data.title.localeCompare(b.data.title);
    if (!firstDate) return 1;
    if (!secondDate) return -1;
    return secondDate.valueOf() - firstDate.valueOf() || a.data.title.localeCompare(b.data.title);
  });
---

<BaseLayout
  title="All Work"
  description="Browse every published project and academic paper by Boomer Rawlings in one chronological index, with only verified dates shown."
>
  <section class="page-intro page-intro--guided">
    <p class="eyebrow">Across disciplines</p>
    <h1>All Work</h1>
    <p class="page-deck">All published work in one view. Where a date appears, it is verified.</p>
    <CuratorGuide
      headingId="curator-all-work"
      messages={[
        "This is the easiest place to wander. Boomer's software projects and academic writing share the same room.",
        "Boomer keeps returning to hard questions in different forms. How can evidence be checked, files stay under their owner's control, and difficult information become easier to use?",
        "Let's begin with his May 2025 essay on financial education and real savings accounts.",
      ]}
      nextExhibit={{ href: '/writing/social-justice-through-financial-literacy/', label: 'Financial literacy essay' }}
    />
  </section>
  <section class="archive-table" aria-label="All work">
    {entries.map((entry) => (
      <a class="archive-row" href={entry.data.externalUrl ?? '/' + entry.data.type + '/' + entry.data.slug + '/'}>
        {displayDate(entry) ? (
          <time class="archive-date" datetime={isoMonth(displayDate(entry)!)}>
            {formatMonthYear(displayDate(entry)!)}
          </time>
        ) : (
          <span class="archive-date">—</span>
        )}
        <span class="archive-kind">{displayKind(entry)}</span>
        <span class="archive-title">{entry.data.title}</span>
      </a>
    ))}
  </section>
</BaseLayout>
