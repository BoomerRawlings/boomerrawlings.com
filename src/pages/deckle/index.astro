---
const deckleUrl = 'https://deckle.boomerrawlings.chatgpt.site/';
const title = 'Deckle';
const description = 'An unlisted reading-diary prototype for tracking books, reviews, authors, and lists.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'none'; frame-src https://deckle.boomerrawlings.chatgpt.site; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'"
    />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f2e9" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#deckle-frame">Skip to Deckle</a>
    <main>
      <p class="loading-status" aria-hidden="true">Opening Deckle…</p>
      <iframe
        id="deckle-frame"
        src={deckleUrl}
        title="Deckle reading-diary prototype"
        loading="eager"
        referrerpolicy="no-referrer"
        sandbox="allow-downloads allow-forms allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
        allow="clipboard-write"
      ></iframe>
      <a class="direct-link" href={deckleUrl} target="_blank" rel="noopener noreferrer">
        Open Deckle directly ↗
      </a>
    </main>
  </body>
</html>

<style>
  :root {
    background: #f6f2e9;
    color: #28251f;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body,
  main {
    height: 100%;
    margin: 0;
    overflow: hidden;
    width: 100%;
  }

  main {
    isolation: isolate;
    position: relative;
  }

  iframe {
    background: #f6f2e9;
    border: 0;
    height: 100%;
    inset: 0;
    position: absolute;
    width: 100%;
    z-index: 1;
  }

  .loading-status {
    inset: 50% auto auto 50%;
    margin: 0;
    position: absolute;
    transform: translate(-50%, -50%);
  }

  .direct-link,
  .skip-link {
    background: rgba(24, 22, 18, 0.88);
    color: #fff;
    font-size: 0.875rem;
    line-height: 1;
    padding: 0.7rem 0.8rem;
    position: fixed;
    text-decoration: none;
    transition: opacity 160ms ease, transform 160ms ease;
    z-index: 3;
  }

  .direct-link {
    bottom: 0.75rem;
    opacity: 0.82;
    right: 0.75rem;
  }

  .direct-link:hover,
  .direct-link:focus-visible {
    opacity: 1;
    transform: translateY(-0.1rem);
  }

  .skip-link {
    left: 0;
    opacity: 0;
    top: 0;
    transform: translateY(-110%);
  }

  .skip-link:focus {
    opacity: 1;
    transform: translateY(0);
  }

  .direct-link:focus-visible,
  .skip-link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .direct-link,
    .skip-link {
      transition: none;
    }
  }
</style>
