---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/teko/latin-500.css';
import '../../styles/brain-teaching.css';
import '../../styles/roomie-booking.css';
import '../../styles/roomie-branding.css';
import { roomies, catalogUpdatedAt, type CatalogCourse, type CourseMeeting, type CourseSection } from '../../data/roomie-booking';

const dateLabel = (value: string | null) => {
  if (!value) return '';
  const date = new Date(`${value.slice(0, 10)}T12:00:00Z`);
  return Number.isNaN(date.getTime()) ? value : date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
};
const timeLabel = (value: string | null) => {
  if (!value) return 'TBA';
  const match = value.match(/^(\d{1,2}):(\d{2})(?::\d{2})?\s*(am|pm)?$/i);
  if (!match) return value;
  const hours = Number(match[1]);
  return `${hours % 12 || 12}:${match[2]} ${match[3]?.toUpperCase() || (hours >= 12 ? 'PM' : 'AM')}`;
};
const dayLabel = (value: string | null) => value ? ({ M: 'Monday', T: 'Tuesday', W: 'Wednesday', R: 'Thursday', F: 'Friday', S: 'Saturday', U: 'Sunday' }[value] || value) : '';
const kindLabel = (value: string) => ({ class: 'Class', lecture: 'Lecture', discussion: 'Discussion', lab: 'Lab', seminar: 'Seminar', final: 'Final exam', midterm: 'Midterm', exam: 'Exam', ot: 'Other meeting' }[value.toLowerCase()] || value);
const isExam = (meeting: CourseMeeting) => /exam|midterm|final/i.test(meeting.kind);
const weekdayOrder = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];
const classMeetings = (section: CourseSection) => {
  const groups = new Map<string, CourseMeeting & { days: string[] }>();
  for (const meeting of section.meetings.filter(meeting => !isExam(meeting))) {
    const key = JSON.stringify([meeting.kind, meeting.date, meeting.startTime, meeting.endTime, meeting.location, meeting.startDate, meeting.endDate]);
    let group = groups.get(key);
    if (!group) {
      group = { ...meeting, days: [] };
      groups.set(key, group);
    }
    const day = dayLabel(meeting.day);
    if (day && !group.days.includes(day)) group.days.push(day);
  }
  return [...groups.values()].map(meeting => ({
    ...meeting,
    days: meeting.days.sort((a, b) => weekdayOrder.indexOf(a) - weekdayOrder.indexOf(b)),
  }));
};
const examMeetings = (sections: CourseSection[]) => {
  const exams = new Map<string, CourseMeeting & { sectionCodes: string[] }>();
  for (const section of sections) {
    for (const meeting of section.meetings.filter(isExam)) {
      const key = JSON.stringify([meeting.kind, meeting.date, meeting.day, meeting.startTime, meeting.endTime, meeting.location, meeting.startDate, meeting.endDate]);
      const existing = exams.get(key);
      if (existing) {
        if (!existing.sectionCodes.includes(section.code)) existing.sectionCodes.push(section.code);
      } else exams.set(key, { ...meeting, sectionCodes: [section.code] });
    }
  }
  return [...exams.values()].sort((a, b) => (a.date || '').localeCompare(b.date || '') || (a.startTime || '').localeCompare(b.startTime || ''));
};
const groupsForCourse = (course: CatalogCourse) => [
  ...course.options.map((option, index) => ({ ...option, key: String(index), unassigned: false })),
  ...(course.unassignedSections.length ? [{ key: 'unassigned', label: 'Other listed sections', bookingUrl: null, sections: course.unassignedSections, unassigned: true }] : []),
];
const missingDetailsNote = (course: CatalogCourse) => {
  const meetings = groupsForCourse(course).flatMap(group => group.sections.flatMap(section => section.meetings));
  const gaps = [
    meetings.some(meeting => !meeting.location) ? 'locations' : '',
    meetings.some(meeting => meeting.kind === 'class' && (!meeting.startDate || !meeting.endDate)) ? 'class date ranges' : '',
  ].filter(Boolean);
  return gaps.length ? `The public catalog does not list all ${gaps.join(' or ')}. Available exam dates appear below.` : '';
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'" />
    <meta name="theme-color" content="#0f1d30" />
    <meta name="description" content="Winter 2027 course booking shortcuts for 0311." />
    <link rel="canonical" href="https://boomerrawlings.com/0311/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Boomer's Better Booking" />
    <meta property="og:title" content="Boomer's Better Booking" />
    <meta property="og:description" content="Winter 2027 course booking shortcuts for 0311." />
    <meta property="og:url" content="https://boomerrawlings.com/0311/" />
    <meta property="og:image" content="https://boomerrawlings.com/0311/social-preview-v1.png" />
    <meta property="og:image:secure_url" content="https://boomerrawlings.com/0311/social-preview-v1.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Boomer's Better Booking in cream and gold on navy. 0311 / Winter 2027." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Boomer's Better Booking" />
    <meta name="twitter:description" content="Winter 2027 course booking shortcuts for 0311." />
    <meta name="twitter:image" content="https://boomerrawlings.com/0311/social-preview-v1.png" />
    <meta name="twitter:image:alt" content="Boomer's Better Booking in cream and gold on navy. 0311 / Winter 2027." />
    <title>Boomer's Better Booking</title>
  </head>
  <body class="teaching-shell roomie-shell">
    <a class="teaching-skip" href="#roomie-main">Skip to courses</a>
    <main id="roomie-main" class="course-library roomie-library">
      <div class="library-intro">
        <div class="booking-brand">
          <p class="teaching-eyebrow"><span class="booking-speed-mark" aria-hidden="true"><i></i><i></i><i></i></span>0311 / WINTER 2027</p>
          <h1><span class="booking-owner">Boomer's</span> <span>Better Booking</span></h1>
        </div>
        <div class="booking-steps" aria-label="How to book">
          <p><span class="booking-step-number" aria-hidden="true">01</span><span><span class="visually-hidden">Step One: </span><button class="tss-login-button" type="button" data-tss-login disabled>Sign in with UCSD</button></span></p>
          <p><span class="booking-step-number" aria-hidden="true">02</span><span><span class="visually-hidden">Step Two: </span>Click <span class="tss-book-inner tss-book-example">Book</span> below.</span></p>
          <p><span class="booking-step-number" aria-hidden="true">03</span><span><span class="visually-hidden">Step Three: </span>Feel good about not dealing with TSS.</span></p>
        </div>
        <div class="tss-session" data-tss-session data-state="checking">
          <div class="tss-session-line">
            <span class="tss-session-status" role="status" aria-live="polite" data-tss-session-status>Checking sign-in…</span>
            <button type="button" data-tss-logout hidden>Sign out</button>
            <button type="button" data-tss-inspect hidden>Check session</button>
          </div>
          <p class="tss-account-note">UCSD sign-in opens in a private Cloudflare-hosted browser session. Sign out when you finish.</p>
          <p class="tss-probe-note" data-tss-probe-note>Login test — booking unavailable.</p>
          <p class="tss-job-status" role="status" aria-live="polite" data-tss-job-status></p>
          <button type="button" data-tss-review hidden>Review in TSS</button>
        </div>
      </div>

      <div class="library-toolbar roomie-toolbar">
        <div class="roomie-filter">
          <label for="roomie-select">Roomie</label>
          <select id="roomie-select" aria-controls="roomie-collection" data-roomie-filter>
            <option value="all">All roomies</option>
            {roomies.map(roomie => <option value={roomie.room}>{roomie.room} · {roomie.name}</option>)}
          </select>
        </div>
        <button type="button" data-expand-roomies aria-controls="roomie-collection">Expand all</button>
      </div>
      <p class="visually-hidden" role="status" aria-live="polite" data-roomie-status>Showing all {roomies.length} roomies.</p>

      <div id="roomie-collection" class="module-collection">
        {roomies.map(roomie => (
          <details id={`room-${roomie.room}`} class="course-module roomie-card" data-roomie-card data-room-number={roomie.room}>
            <summary>
              <span class="module-number" aria-label={`Room ${roomie.room}`}>{roomie.room}</span>
              <span class="module-heading">
                <small>{roomie.major || 'Major pending'}</small>
                <strong>{roomie.name}</strong>
              </span>
              <span class="module-count">{roomie.courses.length} {roomie.courses.length === 1 ? 'course' : 'courses'}</span>
              <span class="disclosure-icon" aria-hidden="true">+</span>
            </summary>
            <div class="module-assets">
              {roomie.courses.some(course => course.kind === 'options') && <p class="catalog-updated">Course details updated {dateLabel(catalogUpdatedAt)} · Times shown in Pacific time</p>}
              {roomie.courses.length > 0 ? roomie.courses.map(course => course.kind === 'selected' ? (
                <div class={`asset-row course-row category-${course.categoryStyle}`}>
                  <span class="asset-type">{course.category}</span>
                  <span class="asset-row-text">
                    <strong>{course.title}</strong>
                    <small>{course.code} · {course.sections.length === 1 ? 'Section' : 'Sections'} {course.sections.join(' · ')}</small>
                  </span>
                  <div class="booking-actions">
                    <button class="tss-book" type="button" data-tss-book data-book-route={course.bookingUrl} aria-label={`Book ${course.title} in TSS`}>
                      <span class="tss-book-inner">Book</span>
                    </button>
                    <a class="tss-direct-booking" href={course.bookingUrl} target="_blank" rel="noopener noreferrer" aria-label={`Go to booking for ${course.title} in TSS, opens in a new tab`}><span class="tss-book-inner">Go to booking</span></a>
                  </div>
                </div>
              ) : (
                <details class={`course-options category-${course.categoryStyle}`} data-course-options>
                  <summary class="asset-row course-row">
                    <span class="asset-type">{course.category}</span>
                    <span class="asset-row-text">
                      <strong>{course.title}</strong>
                      <small>{course.code} · {course.options.length} {course.options.length === 1 ? 'booking option' : 'booking options'}</small>
                    </span>
                    <span class="disclosure-icon" aria-hidden="true">+</span>
                  </summary>
                  <div class="course-options-content">
                    {missingDetailsNote(course) && <p class="course-details-note">{missingDetailsNote(course)}</p>}
                    {groupsForCourse(course).map(group => (
                      <section class:list={['booking-option', { 'booking-option-unassigned': group.unassigned }]} aria-labelledby={`option-${roomie.room}-${course.code}-${group.key}`}>
                        <div class="booking-option-heading">
                          <h2 id={`option-${roomie.room}-${course.code}-${group.key}`}>{group.unassigned ? group.label : <><span class="option-number">Option {Number(group.key) + 1}</span><span class="option-section-codes">{group.label}</span></>}</h2>
                          {!group.unassigned && (group.bookingUrl ? (
                            <div class="booking-actions">
                              <button class="tss-book" type="button" data-tss-book data-book-route={group.bookingUrl} aria-label={`Book ${course.code}, ${group.label} in TSS`}><span class="tss-book-inner">Book</span></button>
                              <a class="tss-direct-booking" href={group.bookingUrl} target="_blank" rel="noopener noreferrer" aria-label={`Go to booking for ${course.code}, ${group.label} in TSS, opens in a new tab`}><span class="tss-book-inner">Go to booking</span></a>
                            </div>
                          ) : (
                            <button class="tss-book" type="button" disabled aria-label={`Booking link unavailable for ${course.code}, ${group.label}`} title="Booking link not available for this option"><span class="tss-book-inner">Book</span></button>
                          ))}
                        </div>
                        {group.unassigned && <p class="option-note">These sections are not linked to a complete booking option.</p>}
                        {!group.unassigned && !group.bookingUrl && <p class="option-note">Booking link not available yet.</p>}
                        {group.sections.map(section => (
                          <div class="option-section">
                            <div class="option-section-heading">
                              <h3>{kindLabel(section.type)} <span>{section.code}</span></h3>
                              <p>{section.instructors.length ? section.instructors.join(', ') : 'Instructor TBA'}</p>
                            </div>
                            <div class="section-meetings" role="list" aria-label={`${section.code} meetings`}>
                              {classMeetings(section).length ? classMeetings(section).map(meeting => (
                                <div class="section-meeting" role="listitem">
                                  <div class="meeting-when">
                                    <strong>{meeting.date ? [meeting.days.join(', '), dateLabel(meeting.date)].filter(Boolean).join(' · ') : meeting.days.join(', ') || 'Day TBA'}</strong>
                                    <span>{meeting.startTime ? `${timeLabel(meeting.startTime)}${meeting.endTime ? `–${timeLabel(meeting.endTime)}` : ''}` : 'Time TBA'}</span>
                                    {(meeting.startDate || meeting.endDate) && <small>{meeting.startDate && dateLabel(meeting.startDate)}{meeting.startDate && meeting.endDate && '–'}{meeting.endDate && dateLabel(meeting.endDate)}</small>}
                                  </div>
                                  <div class="meeting-location"><span>Location</span><strong>{meeting.location || 'Not listed'}</strong></div>
                                </div>
                              )) : (
                                <div class="section-meeting" role="listitem"><div class="meeting-when"><strong>Day TBA</strong><span>Time TBA</span></div><div class="meeting-location"><span>Location</span><strong>Not listed</strong></div></div>
                              )}
                            </div>
                          </div>
                        ))}
                        {examMeetings(group.sections).length > 0 && (
                          <details class="option-exams">
                            <summary>{examMeetings(group.sections).length} {examMeetings(group.sections).length === 1 ? 'exam date' : 'exam dates'}</summary>
                            <div class="exam-meetings" role="list" aria-label={`${group.label} exam dates`}>
                              {examMeetings(group.sections).map(meeting => (
                                <div class="section-meeting exam-meeting" role="listitem">
                                  <div class="meeting-when">
                                    <strong>{kindLabel(meeting.kind)} · {meeting.date ? [dayLabel(meeting.day), dateLabel(meeting.date)].filter(Boolean).join(', ') : 'Date TBA'}</strong>
                                    <span>{meeting.startTime ? `${timeLabel(meeting.startTime)}${meeting.endTime ? `–${timeLabel(meeting.endTime)}` : ''}` : 'Time TBA'}</span>
                                    <small>{meeting.sectionCodes.join(' · ')}</small>
                                    {(meeting.startDate || meeting.endDate) && <small>{meeting.startDate && dateLabel(meeting.startDate)}{meeting.startDate && meeting.endDate && '–'}{meeting.endDate && dateLabel(meeting.endDate)}</small>}
                                  </div>
                                  <div class="meeting-location"><span>Location</span><strong>{meeting.location || 'Not listed'}</strong></div>
                                </div>
                              ))}
                            </div>
                          </details>
                        )}
                      </section>
                    ))}
                    {!course.options.length && !course.unassignedSections.length && <p class="roomie-empty">Sections not listed yet.</p>}
                    {course.courseUrl && <a class="course-detail-link" href={course.courseUrl}>View {course.code} in TSS</a>}
                  </div>
                </details>
              )) : <p class="roomie-empty">Courses not added yet.</p>}
            </div>
          </details>
        ))}
      </div>
      <p class="library-footnote">Book uses your signed-in UCSD account. Check TSS to confirm enrollment.</p>
    </main>
    <script>import '../../scripts/roomie-booking';</script>
    <script>import '../../scripts/roomie-tss-bridge';</script>
  </body>
</html>

