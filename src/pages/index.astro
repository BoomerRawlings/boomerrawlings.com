---
import { getCollection } from 'astro:content';
import CuratorGuide from '../components/CuratorGuide.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const publishedEntries = await getCollection('archive', ({ data }) => data.status === 'published');
const selectedWork = publishedEntries
  .filter(({ data }) => data.type === 'work' && data.featured)
  .sort((a, b) => {
    const order = [
      'horizon',
      'paperfield',
      'workline',
      'research-publishing-systems',
      'organizing-icloud-media',
    ];
    return order.indexOf(a.data.slug) - order.indexOf(b.data.slug);
  });

const counts = {
  work: publishedEntries.filter(({ data }) => data.type === 'work').length,
  research: publishedEntries.filter(({ data }) => data.type === 'research').length,
  writing: publishedEntries.filter(({ data }) => data.type === 'writing').length,
  photography: publishedEntries.filter(({ data }) => data.type === 'photography').length,
};

const contents = [
  ['Projects', '/work/', counts.work],
  ['All Work', '/all/', publishedEntries.length],
  ['Research', '/research/', counts.research],
  ['Writing', '/writing/', counts.writing],
  ['Photography', '/photography/', counts.photography],
] as const;
---

<BaseLayout>
  <section class="home-intro">
    <div class="home-overview">
      <h1>Projects, research, writing, and photography by Boomer Rawlings.</h1>
      <CuratorGuide
        variant="home"
        heading="Pip says"
        messages={[
          `Hi, I’m Pip. I’ll point out useful connections among ${counts.work} projects and ${counts.writing} pieces of writing without getting in your way.`,
          'Use Contents when you know the medium; use All Work when you want everything mixed together.',
          'Horizon is the broadest first stop because it connects files, projects, research, and focused work.',
        ]}
        nextExhibit={{ href: '/work/horizon/', label: 'Horizon' }}
      />
    </div>

    <section class="contents" aria-labelledby="contents-heading">
      <div class="contents-heading">
        <h2 id="contents-heading">Contents</h2>
        <span>Published</span>
      </div>
      <ul>
        {contents.map(([label, href, count]) => (
          <li>
            <a href={href}>
              <span>{label}</span>
              <span class="contents-leader" aria-hidden="true"></span>
              <span class="contents-count" aria-label={`${count} published`}>{count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </section>

  <section class="project-ledger" aria-labelledby="projects-heading">
    <div class="project-ledger-title">
      <h2 id="projects-heading">Projects</h2>
      <p>Selected<br />projects</p>
    </div>
    <div class="project-register">
      <div class="ledger-columns" aria-hidden="true">
        <span>No.</span>
        <span>Type</span>
        <span>Project</span>
        <span>Description</span>
      </div>
      <ul class="ledger-list">
        {selectedWork.map((entry, index) => (
          <li>
            <a href={'/work/' + entry.data.slug + '/'}>
              <span class="ledger-index">{String(index * 10).padStart(2, '0')}</span>
              <span class="ledger-type">Project</span>
              <strong>{entry.data.title}</strong>
              <span class="ledger-description">{entry.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
