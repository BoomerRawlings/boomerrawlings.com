---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const publishedEntries = await getCollection('archive', ({ data }) => data.status === 'published');
const selectedWork = publishedEntries
  .filter(({ data }) => data.type === 'work' && data.featured)
  .sort((a, b) => {
    const order = [
      'horizon',
      'paperfield',
      'workline',
      'research-publishing-systems',
      'icloud-media-archive',
    ];
    return order.indexOf(a.data.slug) - order.indexOf(b.data.slug);
  });

const counts = {
  work: publishedEntries.filter(({ data }) => data.type === 'work').length,
  research: publishedEntries.filter(({ data }) => data.type === 'research').length,
  writing: publishedEntries.filter(({ data }) => data.type === 'writing').length,
  photography: publishedEntries.filter(({ data }) => data.type === 'photography').length,
};

const contents = [
  ['Projects', '/work/', counts.work],
  ['Archive', '/archive/', publishedEntries.length],
  ['Research', '/research/', counts.research],
  ['Writing', '/writing/', counts.writing],
  ['Photography', '/photography/', counts.photography],
] as const;
---

<BaseLayout>
  <section class="home-intro">
    <h1>Projects, research, writing, and photography by Boomer Rawlings.</h1>

    <section class="contents" aria-labelledby="contents-heading">
      <div class="contents-heading">
        <h2 id="contents-heading">Contents</h2>
        <span>Published</span>
      </div>
      <ul>
        {contents.map(([label, href, count]) => (
          <li>
            <a href={href}>{label}</a>
            <span aria-label={`${count} published`}>{count}</span>
          </li>
        ))}
      </ul>
    </section>
  </section>

  <section class="project-ledger" aria-labelledby="projects-heading">
    <h2 id="projects-heading">Projects</h2>
    <div class="ledger-columns" aria-hidden="true">
      <span>Type</span>
      <span>Record</span>
      <span>Description</span>
    </div>
    <ul class="ledger-list">
      {selectedWork.map((entry) => (
        <li>
          <a href={'/work/' + entry.data.slug + '/'}>
            <span class="ledger-type">Project</span>
            <strong>{entry.data.title}</strong>
            <span class="ledger-description">{entry.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
