---
import { getCollection } from 'astro:content';
import CuratorGuide from '../components/CuratorGuide.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const publishedEntries = await getCollection('archive', ({ data }) => data.status === 'published');
const selectedWork = publishedEntries
  .filter(({ data }) => data.type === 'work' && data.featured)
  .sort((a, b) => {
    const order = [
      'horizon',
      'paperfield',
      'research-briefing-assistant',
      'pocketllm',
      'workline',
      'research-publishing-systems',
      'organizing-icloud-media',
    ];
    return order.indexOf(a.data.slug) - order.indexOf(b.data.slug);
  });

const counts = {
  work: publishedEntries.filter(({ data }) => data.type === 'work').length,
  writing: publishedEntries.filter(({ data }) => data.type === 'writing').length,
};

const contents = [
  {
    label: 'Academics',
    href: '/cv/',
    detail: '2025–26',
    detailLabel: 'Academic profile, Spring 2025 to Spring 2026',
  },
  {
    label: 'Writing',
    href: '/writing/',
    detail: `${counts.writing} pieces`,
    detailLabel: `${counts.writing} published writing pieces`,
  },
  {
    label: 'Projects',
    href: '/work/',
    detail: `${counts.work} projects`,
    detailLabel: `${counts.work} published projects`,
  },
  {
    label: 'All Work',
    href: '/all/',
    detail: `${publishedEntries.length} entries`,
    detailLabel: `${publishedEntries.length} published entries`,
  },
] as const;
---

<BaseLayout description="Portfolio of Boomer Rawlings: psychology, local-first software, research systems, academic writing, and visual work.">
  <section class="home-intro">
    <div class="home-overview">
      <h1>Projects, research, and writing by Boomer Rawlings.</h1>
      <CuratorGuide
        variant="home"
        heading="Pip says"
        messages={[
          "Hi! I'm Pip! I'll guide you through Boomer's portfolio.",
          'This portfolio has broad coverage, from academic papers and research software to experimental interfaces and photography.',
          'ABOUT will be our first stop, giving you some background information about Boomer.',
        ]}
        nextExhibit={{ href: '/about/', label: 'About' }}
      />
    </div>

    <section class="contents" aria-labelledby="contents-heading">
      <div class="contents-heading">
        <h2 id="contents-heading">Contents</h2>
        <span>Overview</span>
      </div>
      <ul>
        {contents.map(({ label, href, detail, detailLabel }) => (
          <li>
            <a href={href}>
              <span>{label}</span>
              <span class="contents-leader" aria-hidden="true"></span>
              <span class="contents-count" aria-label={detailLabel}>{detail}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </section>

  <section class="project-ledger" aria-labelledby="projects-heading">
    <div class="project-ledger-title">
      <h2 id="projects-heading">Projects</h2>
      <p>Selected<br />projects</p>
    </div>
    <div class="project-register">
      <div class="ledger-columns" aria-hidden="true">
        <span>Type</span>
        <span>Project</span>
        <span>Description</span>
      </div>
      <ul class="ledger-list">
        {selectedWork.map((entry) => (
          <li>
            <a href={'/work/' + entry.data.slug + '/'}>
              <span class="ledger-type">{entry.data.projectStage ? 'WIP project' : 'Project'}</span>
              <strong>{entry.data.title}</strong>
              <span class="ledger-description">{entry.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
