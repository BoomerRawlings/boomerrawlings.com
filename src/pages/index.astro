---
import { getCollection } from 'astro:content';
import CuratorGuide from '../components/CuratorGuide.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatMonthYear, isoMonth } from '../lib/dates';

const publishedEntries = await getCollection('archive', ({ data }) => data.status === 'published');
const highlightOrder = [
  'scads-2026',
  'brain-study-guide',
  'crime-and-heat',
  'campus-safety',
  'horizon',
  'paperfield',
  'pocketllm',
  'organizing-icloud-media',
];
const selectedWork = publishedEntries
  .filter(({ data }) => data.featured && highlightOrder.includes(data.slug))
  .sort((a, b) => highlightOrder.indexOf(a.data.slug) - highlightOrder.indexOf(b.data.slug));

const counts = {
  work: publishedEntries.filter(({ data }) => data.type === 'work').length,
  writing: publishedEntries.filter(({ data }) => data.type === 'writing' || data.type === 'data-analysis').length,
};

const contents = [
  {
    key: 'academics',
    label: 'Academics',
    href: '/cv/',
    detail: '2025–26',
    detailLabel: 'Academic profile, Spring 2025 to Spring 2026',
  },
  {
    key: 'writing',
    label: 'Writing',
    href: '/writing/',
    detail: `${counts.writing} pieces`,
    detailLabel: `${counts.writing} published writing pieces`,
  },
  {
    key: 'projects',
    label: 'Projects',
    href: '/work/',
    detail: `${counts.work} projects`,
    detailLabel: `${counts.work} published projects`,
  },
  {
    key: 'all-work',
    label: 'All Work',
    href: '/all/',
    detail: `${publishedEntries.length} entries`,
    detailLabel: `${publishedEntries.length} published entries`,
  },
] as const;
---

<BaseLayout description="Portfolio of Boomer Rawlings: psychology, local-first software, research systems, academic writing, and visual work.">
  <section class="home-intro">
    <header class="home-identity">
      <h1>Boomer Rawlings</h1>
      <div>
        <p>I work across psychology, research, software, and academic writing. This portfolio brings together selected projects, ideas, writing, and images.</p>
        <p class="home-identity-links"><a href="/about/">About Boomer</a><a href="/cv/">Academics</a></p>
      </div>
    </header>
    <CuratorGuide
      variant="home"
      heading="Pip says"
      messages={[
        "Hi! I'm Pip! I'll guide you through Boomer's portfolio.",
        'This portfolio has broad coverage, from academic papers and research software to experimental interfaces and photography.',
        'ABOUT will be our first stop, giving you some background information about Boomer.',
      ]}
      nextExhibit={{ href: '/about/', label: 'About' }}
    />

    <section class="contents" aria-labelledby="contents-heading">
      <div class="contents-heading">
        <h2 id="contents-heading">Contents</h2>
        <span>Overview</span>
      </div>
      <ul>
        {contents.map(({ key, label, href, detail, detailLabel }) => (
          <li>
            <a href={href} data-map-target={key}>
              <span>{label}</span>
              <span class="contents-leader" aria-hidden="true"></span>
              <span class="contents-count" aria-label={detailLabel}>{detail}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </section>

  <aside class="home-workflow-feature" aria-label="Featured reusable skill">
    <span>Reusable skill &amp; starter</span>
    <a href="/work/#workflow-display"><strong>Workflow Display</strong><span>Paired explanations and artifacts. Smooth animation. Connected steps.</span><span aria-hidden="true">Explore ↗</span></a>
  </aside>

  <section class="project-ledger" aria-labelledby="selected-work-heading">
    <div class="project-ledger-title">
      <h2 id="selected-work-heading">Selected work</h2>
      <p>Research &amp;<br />projects</p>
    </div>
    <div class="project-register">
      <div class="ledger-columns" aria-hidden="true">
        <span>Published</span>
        <span>Type</span>
        <span>Work</span>
        <span>Description</span>
      </div>
      <ul class="ledger-list">
        {selectedWork.map((entry) => (
          <li>
            <a data-pip-direct={entry.data.externalUrl?.startsWith('https://boomerrawlings.com/') || undefined} href={entry.data.externalUrl?.replace(/^https:\/\/boomerrawlings\.com\//, '/') ?? '/' + (entry.data.type === 'data-analysis' ? 'writing/data-analysis' : entry.data.type) + '/' + entry.data.slug + '/'}>
              <time class="ledger-date" datetime={isoMonth(entry.data.publishedDate!)}>{formatMonthYear(entry.data.publishedDate!)}</time>
              <span class="ledger-type">{entry.data.type === 'data-analysis' ? 'Data analysis' : entry.data.projectStage ? 'WIP project' : 'Project'}</span>
              <strong>{entry.data.title}</strong>
              <span class="ledger-description">{entry.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .project-ledger .ledger-columns, .project-ledger .ledger-list a { grid-template-columns: 7.1rem 5.6rem minmax(9rem, .85fr) minmax(15rem, 1.7fr); gap: 1rem; }
  .ledger-date { align-self: start; font: .74rem/1.6 var(--mono); color: var(--muted); padding-top: .1rem; }
  @media (max-width: 70rem) {
    .project-ledger .ledger-list a { grid-template-columns: 6.6rem minmax(0,1fr); gap: .4rem 1rem; align-items: start; padding-block: 1.2rem; }
    .project-ledger .ledger-columns, .project-ledger .ledger-type { display: none; }
    .project-ledger .ledger-date { grid-column: 1; grid-row: 1 / 3; }
    .project-ledger .ledger-list strong { grid-column: 2; grid-row: 1; }
    .project-ledger .ledger-description { grid-column: 2; grid-row: 2; }
  }
  @media (max-width: 26rem) {
    .project-ledger .ledger-list a { grid-template-columns: 5.2rem minmax(0,1fr); gap: .4rem .7rem; }
    .ledger-date { font-size: .68rem; }
  }
  .home-workflow-feature { background: var(--paper); border-bottom: 1px solid var(--rule); display: grid; gap: 0.7rem 2rem; grid-template-columns: 12rem minmax(0, 1fr); padding: 1.4rem 5vw; }
  .home-workflow-feature > span { align-self: center; color: var(--muted); font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .home-workflow-feature a { align-items: baseline; display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; text-decoration: none; }
  .home-workflow-feature strong { color: var(--blue); font-size: 1.1rem; }
  .home-workflow-feature a > span:first-of-type { flex: 1 1 22rem; line-height: 1.4; }
  .home-workflow-feature a > span:last-of-type { color: var(--blue); font-family: var(--mono); font-size: 0.75rem; }
  .home-workflow-feature a:hover strong { text-decoration: underline; text-underline-offset: 0.2em; }

  .home-identity {
    align-items: start;
    display: grid;
    gap: 1rem clamp(2.25rem, 4vw, 4rem);
    grid-column: 1 / -1;
    grid-template-columns: minmax(13rem, 0.38fr) minmax(34rem, 1fr);
  }

  .home-identity h1 {
    font-family: var(--display);
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.05;
    margin: 0;
  }

  .home-identity p {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0;
    max-width: 48rem;
  }

  .home-identity .home-identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 0.6rem;
  }

  .home-identity-links a {
    color: var(--yellow);
    text-underline-offset: 0.2em;
  }

  @media (max-width: 70rem) {
    .home-identity {
      column-gap: 2.5rem;
      grid-template-columns: minmax(14rem, 0.42fr) minmax(30rem, 1fr);
    }
  }

  @media (max-width: 54rem) {
    .home-workflow-feature { grid-template-columns: minmax(0, 1fr); padding: 1.4rem 1.25rem; }

    .home-identity {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: 2.5rem;
    }
  }
</style>
