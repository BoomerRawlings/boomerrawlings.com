---
import CollectionIndex from '../../components/CollectionIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Photography"
  description="Photography and image-led work by Boomer Rawlings."
  noindex={true}
>
  <CollectionIndex
    type="photography"
    title="Photography"
    eyebrow="Images"
    introduction="Photography is the image-led side of the portfolio: selected photographs and visual series."
    guide={{
      messages: [
        'Welcome to the visual side of the portfolio!',
        'This room stays quieter than the others, giving images more space and keeping the explanation brief.',
        'All Work is next if you would like to return to the full portfolio.',
      ],
      nextExhibit: { href: '/all/', label: 'All Work' },
    }}
  />
</BaseLayout>
