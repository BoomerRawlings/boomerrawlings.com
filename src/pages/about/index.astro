---
import CuratorGuide from '../../components/CuratorGuide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Boomer Rawlings and this portfolio.">
  <section class="page-intro page-intro--guided">
    <p class="eyebrow">About</p>
    <h1>Boomer Rawlings</h1>
    <p class="page-deck">
      Psychology, research, and experimental software. This site is a developing public portfolio of selected projects, ideas, writing, and images.
    </p>
    <CuratorGuide
      headingId="curator-about"
      messages={[
        'This is the shortest route to context: psychology, research, and experimental software.',
        'Projects show how those interests become systems; Writing shows the questions and voice behind them.',
        'Horizon offers the broadest first look at the systems side.',
      ]}
      nextExhibit={{ href: '/work/horizon/', label: 'Horizon' }}
    />
  </section>
</BaseLayout>
