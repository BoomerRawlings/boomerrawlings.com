---
import CuratorGuide from '../../components/CuratorGuide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Boomer Rawlings is a 2026 Southwestern College Student of Distinction working across psychology, research, software, and academic writing."
  pageType="profile"
>
  <section class="page-intro page-intro--guided about-intro">
    <p class="eyebrow">About</p>
    <h1>Boomer Rawlings</h1>
    <figure class="about-portrait">
      <img
        src="/images/boomer-rawlings-about.webp"
        alt="Boomer Rawlings standing outdoors beneath a covered walkway."
        width="1080"
        height="1440"
        decoding="async"
        fetchpriority="high"
      />
    </figure>
    <div class="page-deck">
      <p>
        Boomer Rawlings works across psychology, research, software, and academic writing. He completed Southwestern College’s Psychology for Transfer (AA-T) degree with honors in Spring 2026, received the 2026 Student of Distinction Award, and was named to the President’s List four times. This site is a developing public portfolio of selected projects, ideas, writing, and images.
      </p>
      <p><a href="/cv/">View academics →</a></p>
    </div>
    <CuratorGuide
      headingId="curator-about"
      messages={[
        "That's Boomer in the photograph! He studies psychology, builds research tools, writes academic papers, and makes strange little worlds.",
        "He completed his Psychology for Transfer degree with honors in one year. That same year, he received Southwestern College's highest student award.",
        "ACADEMICS is next. I'll show you his focused coursework and four President's List honors from Southwestern College.",
      ]}
      nextExhibit={{ href: '/cv/', label: 'Academics' }}
    />
  </section>
</BaseLayout>
