---
import CuratorGuide from '../../components/CuratorGuide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Boomer Rawlings is a 2026 Southwestern College Student of Distinction working across psychology, research, software, and academic writing."
  pageType="profile"
>
  <section class="page-intro page-intro--guided about-intro">
    <p class="eyebrow">About</p>
    <h1>Boomer Rawlings</h1>
    <figure class="about-portrait">
      <img
        src="/images/boomer-rawlings-headshot.webp"
        alt="Boomer Rawlings smiling outdoors."
        width="900"
        height="1350"
        decoding="async"
        fetchpriority="high"
      />
    </figure>
    <div class="page-deck">
      <p>
        Boomer Rawlings works across psychology, research, software, and academic writing. He completed Southwestern College’s Psychology for Transfer (AA-T) degree with honors in Spring 2026, received the 2026 Student of Distinction Award, and was named to the President’s List four times. This site is a developing public portfolio of selected projects, ideas, writing, and images.
      </p>
      <p><a href="/cv/">View academics →</a></p>
    </div>
    <CuratorGuide
      headingId="curator-about"
      messages={[
        "That's Boomer in the photograph! He studies psychology, builds research tools, writes academic papers, and makes strange little worlds.",
        "He completed his Psychology for Transfer degree with honors in one year. That same year, he received Southwestern College's highest student award.",
        "ACADEMICS is next. I'll show you his focused coursework and four President's List honors from Southwestern College.",
      ]}
      nextExhibit={{ href: '/cv/', label: 'Academics' }}
    />
  </section>

  <section class="about-support" aria-labelledby="about-support-title">
    <p class="about-support__eyebrow">Coffee &amp; conversation</p>
    <div class="about-support__body">
      <h2 id="about-support-title">Come say hello</h2>
      <p>
        I share most of what I make freely. If something here has been useful, you’re welcome to buy me a coffee. I also love hearing what people are building or thinking about, so feel free to send me a note.
      </p>
      <p class="about-support__links">
        <a href="https://www.buymeacoffee.com/BoomerRawlings" target="_blank" rel="noopener noreferrer">Buy me a coffee</a>
        <a href="mailto:boomerrawlings@gmail.com">Send me a note</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about-support {
    color: var(--navy);
    display: grid;
    gap: 1.25rem 4rem;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(20rem, 1fr);
    padding: clamp(2.75rem, 5vw, 4.5rem) 5vw clamp(3.5rem, 6vw, 5rem);
  }

  .about-support__eyebrow {
    color: var(--blue);
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin: 0;
    text-transform: uppercase;
  }

  .about-support__body {
    max-width: 46rem;
  }

  .about-support h2 {
    font-family: var(--display);
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 0.95;
    margin: 0 0 1rem;
    text-transform: uppercase;
  }

  .about-support__body > p:not(.about-support__links) {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    margin: 0;
  }

  .about-support__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin: 1.5rem 0 0;
  }

  .about-support__links a {
    color: var(--blue);
    font-family: var(--display);
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-underline-offset: 0.22em;
  }

  @media (max-width: 720px) {
    .about-support {
      display: block;
      padding: 3rem 1.25rem 4rem;
    }

    .about-support__eyebrow {
      margin-bottom: 1.25rem;
    }
  }
</style>
