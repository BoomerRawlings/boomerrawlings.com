---
import CuratorGuide from '../../components/CuratorGuide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="Boomer Rawlings works across psychology, research, software, and personal writing.">
  <section class="page-intro page-intro--guided">
    <p class="eyebrow">About</p>
    <h1>Boomer Rawlings</h1>
    <p class="page-deck">
      Boomer Rawlings works across psychology, research, software, and personal writing. This site is a developing public portfolio of selected projects, ideas, writing, and images.
    </p>
    <CuratorGuide
      headingId="curator-about"
      messages={[
        'Here is the through-line: ambitious systems that still leave control with the person using them.',
        'You can see it in local-first software, human confirmation before automated judgment, and publishing workflows that keep evidence visible.',
        'Horizon gives the broadest view; Writing shows the personal and academic questions behind it.',
      ]}
      nextExhibit={{ href: '/work/horizon/', label: 'Horizon' }}
    />
  </section>
</BaseLayout>
