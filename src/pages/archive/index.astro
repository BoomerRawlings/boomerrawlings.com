---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const chronologyDate = (entry: Awaited<ReturnType<typeof getCollection<'archive'>>>[number]) =>
  entry.data.publishedDate ?? entry.data.date ?? entry.data.producedDate;

const entries = (await getCollection('archive', ({ data }) => data.status === 'published'))
  .sort((a, b) => {
    const firstDate = chronologyDate(a);
    const secondDate = chronologyDate(b);
    if (!firstDate && !secondDate) return a.data.title.localeCompare(b.data.title);
    if (!firstDate) return 1;
    if (!secondDate) return -1;
    return secondDate.valueOf() - firstDate.valueOf() || a.data.title.localeCompare(b.data.title);
  });
---

<BaseLayout title="Archive" description="A chronological index of public work by Boomer Rawlings.">
  <section class="page-intro">
    <p class="eyebrow">Chronology</p>
    <h1>Archive</h1>
    <p class="page-deck">A cross-disciplinary index. Undated entries remain separate until their chronology is documented.</p>
  </section>
  <section class="archive-table" aria-label="Archive entries">
    {entries.map((entry) => (
      <a class="archive-row" href={entry.data.externalUrl ?? '/' + entry.data.type + '/' + entry.data.slug + '/'}>
        <span>{chronologyDate(entry)?.getUTCFullYear() ?? 'Undated'}</span>
        <span>{entry.data.type}</span>
        <span>{entry.data.title}</span>
      </a>
    ))}
  </section>
</BaseLayout>
