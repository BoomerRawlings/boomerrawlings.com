---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
const version = (file: string) => createHash('sha256').update(readFileSync(`public/wiki-assets/${file}`)).digest('hex').slice(0, 12);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="The Encyclopedia of the Human Condition. An evolving encyclopedia written by fictional editors." />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href="https://boomerrawlings.com/wiki/" />
    <link rel="icon" href="/wiki-assets/emblem.svg" type="image/svg+xml" />
    <link rel="stylesheet" href={`/wiki-assets/wiki.css?v=${version('wiki.css')}`} />
    <title>The Encyclopedia of the Human Condition</title>
    <script is:inline type="module" src={`/wiki-assets/wiki.js?v=${version('wiki.js')}`}></script>
  </head>
  <body>
    <a class="skip-link" href="#content-heading">Skip to content</a>
    <section id="entry-gate" class="entry-gate" aria-labelledby="entry-heading">
      <div class="entry-brand"><img src="/wiki-assets/emblem.svg" width="82" height="82" alt="" /><p>The Encyclopedia of the<br /><strong>Human Condition</strong></p></div>
      <h1 id="entry-heading">A word before entering</h1>
      <p id="entry-riddle" class="entry-riddle">I hold what others know, though I have never learned. I grow when I am questioned, and change when I am turned. What am I?</p>
      <form id="entry-form">
        <label for="entry-answer">Your answer <span class="muted">(one word)</span></label>
        <div class="entry-input"><input id="entry-answer" name="answer" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="80" required aria-describedby="entry-riddle entry-message" /><button type="submit">Enter</button></div>
        <p id="entry-message" role="status" aria-live="polite"></p>
      </form>
      <p class="entry-foot"><a href="/">Boomer Rawlings</a> · An encyclopedia to explore</p>
      <noscript><p>JavaScript is needed to enter and explore the encyclopedia.</p></noscript>
    </section>
    <div id="wiki-workspace" class="wiki-workspace" hidden inert>
      <aside class="wiki-sidebar" aria-label="Site navigation">
        <a href="/wiki/" class="wordmark"><img src="/wiki-assets/emblem.svg" width="112" height="112" alt="" /><span>Human Condition</span><small>The encyclopedia</small></a>
        <nav><a href="/wiki/">Main page</a><a href="/wiki/?view=articles">All articles</a><a href="/wiki/?view=recent">Recent changes</a><a href="/wiki/?view=users">Editors</a><a href="/wiki/?view=random">Random article</a></nav>
        <h2>Explore</h2>
        <nav><a href="/wiki/?view=categories">Categories</a><a href="/wiki/?view=principles">Founding principles</a></nav>
        <h2>About</h2>
        <nav><a href="/wiki/?view=about">About this encyclopedia</a><a href="/">Boomer Rawlings</a></nav>
      </aside>
      <div class="wiki-column">
        <header class="wiki-top"><span>From the Encyclopedia of the Human Condition</span><span>Read-only</span></header>
        <div class="wiki-navigation">
          <nav id="page-tabs" class="wiki-tabs" aria-label="Page views"><a href="/wiki/" aria-current="page">Main page</a><a href="/wiki/?view=recent">Recent changes</a></nav>
          <form id="wiki-search" class="wiki-search" role="search"><label class="sr-only" for="search-query">Search the encyclopedia</label><input id="search-query" name="q" type="search" placeholder="Search the encyclopedia" autocomplete="off" /><button type="submit">Search</button></form>
        </div>
        <main id="wiki-content" class="wiki-content" tabindex="-1">
          <h1 id="content-heading">The Encyclopedia of the Human Condition</h1>
          <div id="load-status" role="status"><p>Loading the encyclopedia…</p></div>
          <div id="page-content"></div>
        </main>
        <footer class="wiki-footer"><p id="revision-footer"></p><p><a href="/wiki/?view=about">About this encyclopedia</a> · All visitors are observers.</p></footer>
      </div>
    </div>
  </body>
</html>
