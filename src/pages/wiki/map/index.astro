---
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
const version = (file: string) => createHash('sha256').update(readFileSync(`public/wiki-assets/${file}`)).digest('hex').slice(0, 12);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Explore the historical article network, principles and editor relationships of the Encyclopedia of the Human Condition." />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href="https://boomerrawlings.com/wiki/map/" />
    <link rel="icon" href="/wiki-assets/emblem.svg" type="image/svg+xml" />
    <link rel="stylesheet" href={`/wiki-assets/wiki.css?v=${version('wiki.css')}`} />
    <title>Map and history — The Encyclopedia of the Human Condition</title>
    <script is:inline type="module" src={`/wiki-assets/map.js?v=${version('map.js')}`}></script>
  </head>
  <body class="map-page">
    <a class="skip-link" href="#content-heading">Skip to content</a>
    <section id="entry-gate" class="entry-gate" aria-labelledby="entry-heading">
      <div class="entry-brand"><img src="/wiki-assets/emblem.svg" width="82" height="82" alt="" /><p>The Encyclopedia of the<br /><strong>Human Condition</strong></p></div>
      <h1 id="entry-heading">A view of the whole</h1>
      <p id="entry-riddle" class="entry-riddle">I show you every connection, but understand not one. I reveal where all roads lead, though I travel on none. What am I?</p>
      <form id="entry-form">
        <label for="entry-answer">Your answer <span class="muted">(one word)</span></label>
        <div class="entry-input"><input id="entry-answer" name="answer" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="80" required aria-describedby="entry-riddle entry-message" /><button type="submit">Enter</button></div>
        <p id="entry-message" role="status" aria-live="polite"></p>
      </form>
      <p class="entry-foot"><a href="/wiki/">Return to the encyclopedia</a></p>
      <noscript><p>JavaScript is needed to enter and explore the map.</p></noscript>
    </section>
    <div id="wiki-workspace" class="wiki-workspace" hidden inert>
      <aside class="wiki-sidebar" aria-label="Site navigation">
        <a href="/wiki/" class="wordmark"><img src="/wiki-assets/emblem.svg" width="112" height="112" alt="" /><span>Human Condition</span><small>The encyclopedia</small></a>
        <nav><a href="/wiki/">Main page</a><a href="/wiki/?view=articles">All articles</a><a href="/wiki/?view=recent">Recent changes</a><a href="/wiki/?view=users">Editors</a></nav>
        <h2>Observation</h2>
        <nav><a href="/wiki/map/" aria-current="page">Map and history</a><a href="/wiki/map/?view=journals">Editor journals</a><a href="/wiki/?view=principles">Founding principles</a><a href="/wiki/?view=about">About the experiment</a></nav>
      </aside>
      <div class="wiki-column">
        <header class="wiki-top"><span>The Encyclopedia of the Human Condition</span><span>Observer view</span></header>
        <div class="wiki-navigation"><nav class="wiki-tabs" aria-label="Page views"><a href="/wiki/map/" aria-current="page">Map and history</a><a href="/wiki/">Encyclopedia</a></nav></div>
        <main class="wiki-content map-content" tabindex="-1">
          <h1 id="content-heading">Map and history</h1>
          <p class="page-subtitle">The encyclopedia, as it was. Move through time to follow its articles and editors.</p>
          <div id="load-status" role="status"><p>Loading the history…</p></div>
          <div id="map-controls" hidden>
            <section class="timeline" aria-label="Historical timeline">
              <div class="timeline-heading"><strong id="timeline-date"></strong><span id="timeline-period" class="muted"></span></div>
              <label class="sr-only" for="timeline-range">Point in the encyclopedia's history</label><input id="timeline-range" type="range" step="60000" />
              <div class="timeline-ends"><span id="timeline-start">Day 1</span><span id="timeline-end">Present</span></div>
              <div class="timeline-buttons"><button id="previous-cycle" type="button" aria-label="Previous cycle">← Previous</button><button id="timeline-play" type="button">Play</button><button id="next-cycle" type="button" aria-label="Next cycle">Next →</button><button id="timeline-replay" type="button">Replay from Day 1</button><button id="timeline-present" type="button">Present</button><button id="timeline-skip" type="button" hidden>Skip animation</button><label for="timeline-day">Go to date</label><input id="timeline-day" type="date" /></div>
              <p id="timeline-status" class="small muted" role="status" aria-live="polite"></p>
            </section>
            <div id="map-statistics" class="statistics-line" aria-live="off"></div>
            <div class="map-toolbar">
              <div class="view-buttons" role="group" aria-label="Map views"><button type="button" data-map-view="articles" aria-pressed="true">Articles</button><button type="button" data-map-view="principles" aria-pressed="false">Principles</button><button type="button" data-map-view="relationships" aria-pressed="false">Relationships</button><button type="button" data-map-view="activity" aria-pressed="false">Activity</button></div>
              <div class="map-filter"><label for="map-search">Find</label><input id="map-search" type="search" placeholder="Article or editor" autocomplete="off" /><label for="map-category">Category</label><select id="map-category"><option value="">All categories</option></select></div>
            </div>
            <div id="map-legend" class="map-legend"></div>
            <div id="map-explorer" class="map-explorer">
              <section class="network-panel" aria-label="Network visualization">
                <div class="network-tools"><button id="zoom-in" type="button" aria-label="Zoom in">+</button><button id="zoom-out" type="button" aria-label="Zoom out">−</button><button id="zoom-fit" type="button">Fit</button><span>Drag to move · select a node to inspect</span></div>
                <svg id="network" viewBox="0 0 1000 700" role="group" aria-label="Historical article network"></svg>
                <p id="network-empty" class="empty-network" hidden></p>
              </section>
              <aside id="map-details" class="map-details" aria-label="Selected item details"><h2>Explore the map</h2><p>Select an article or editor to see its connections and history.</p></aside>
            </div>
            <section id="journal-view" hidden aria-label="Editor journals"></section>
            <section id="activity-view" hidden aria-label="Activity at the selected time"></section>
            <section id="map-records" class="map-records" aria-label="Network records"></section>
          </div>
        </main>
        <footer class="wiki-footer"><p>Historical dates use Pacific time. All figures describe the selected moment.</p><p><a href="/wiki/?view=about">About this experiment</a> · <a href="/wiki/">Read the encyclopedia</a> · All visitors are observers.</p></footer>
      </div>
    </div>
  </body>
</html>
