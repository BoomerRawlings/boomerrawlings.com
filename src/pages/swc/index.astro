---
import CoffeeButton from '../../components/CoffeeButton.astro';
import DocumentPreview from '../../components/DocumentPreview.astro';
import PdfPreviewDialog from '../../components/PdfPreviewDialog.astro';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';

const title = 'SWC Restorative Justice';
const description = 'An unofficial SWC Restorative Justice resource with downloadable forms, PDF previews, and contacts.';
const canonical = 'https://boomerrawlings.com/swc/';
const socialImage = 'https://boomerrawlings.com/images/swc-student-worker-hub-social.png';
const tabs = [
  ['Documents', '#downloads'],
  ['Contacts', '#contacts'],
  ['Official links', '#official-links'],
] as const;
const pdfResources = [
  ['New Hire Packet', 'Employment forms, instructions, and a payroll schedule.', '/documents/swc/pdf/swc-new-hire-packet.pdf', 21, 773, 1000],
  ['AODS Options', 'A comparison of California SUD counselor credentials.', '/documents/swc/pdf/swc-california-aods-options.pdf', 1, 773, 1000],
  ['Generic SWC RJ Sign-In Sheet', 'A blank sign-in sheet for Restorative Justice.', '/documents/swc/pdf/swc-generic-rj-sign-in-sheet.pdf', 1, 773, 1000],
  ['Rising Scholar Launch Check', 'Enrollment steps and an account-information worksheet.', '/documents/swc/pdf/swc-rising-scholar-launch-check.pdf', 2, 773, 1000],
  ['Rising Scholar Resources', 'Campus contacts, a map, and books-and-supplies guidance.', '/documents/swc/pdf/swc-rising-scholar-resources.pdf', 2, 773, 1000],
  ['Rising Scholar Combo', 'The resource handout and launch checklist in one PDF.', '/documents/swc/pdf/swc-rising-scholar-combo.pdf', 4, 773, 1000],
  ['Loaner Laptop Program Student Agreement', 'Loan terms, return procedures, and the student agreement.', '/documents/swc/pdf/swc-loaner-laptop-student-agreement.pdf', 2, 773, 1000],
] as const;
const keyContacts = [
  { name: 'Raquel Funches', role: 'Director · Restorative Justice and Other Off-Campus Programs', phone: '(619) 216-6658', tel: '+16192166658', email: 'rfunches@swccd.edu', office: 'HEC National City · Office 7118B', source: 'https://www.swccd.edu/_showcase/directory/index.aspx' },
  { name: 'Carla Gomez', role: 'Assistant Director, Youth Justice Program', phone: '(619) 216-6657', tel: '+16192166657', email: 'csevilla@swccd.edu', office: 'HEC National City · Office 7119B', source: 'https://www.swccd.edu/_showcase/directory/index.aspx' },
  { name: 'Jeanne Kaufman', role: 'Bookstore credit contact (user-specified) · Senior Account Clerk', phone: '(619) 421-6700 x5334', tel: '+16194216700;ext=5334', email: 'jkaufman@swccd.edu', source: 'https://www.swcbookstore.com/site_contact_us.asp' },
  { name: 'Trina Eros', role: 'SWC Cares · Basic Needs Coordinator', phone: '(619) 216-6687', tel: '+16192166687', email: 'teros@swccd.edu', source: 'https://www.swccd.edu/student-support/swc-cares/index.aspx' },
  { name: 'Paola Duarte Vargas', role: 'SWC Cares · Basic Needs Project Technician', phone: '(619) 421-6700 x5404', tel: '+16194216700;ext=5404', email: '', source: 'https://go.swccd.edu/contact/person/5cc7d2b2db5b0850469a5e65ce96190f' },
  { name: 'Manuel Burciaga Tarin', role: 'Student Services Specialist · current directory role', phone: '(619) 421-6700 x5408', tel: '+16194216700;ext=5408', email: '', source: 'https://go.swccd.edu/contact/person/db22ee1f1b41a51060decae5624bcbbd' },
  { name: 'Sandra Salazar', role: 'HECNC Student Services · Education Center Specialist', phone: '(619) 216-6665 x4853', tel: '+16192166665;ext=4853', email: 'ssalazar@swccd.edu', source: 'https://www.swccd.edu/locations/higher-education-center-at-national-city/' },
  { name: 'Sarah Valdivia', role: 'HECNC Student Services · Education Center Specialist', phone: '(619) 216-6665 x4851', tel: '+16192166665;ext=4851', email: 'svaldiva@swccd.edu', source: 'https://www.swccd.edu/locations/higher-education-center-at-national-city/' },
  { name: 'Elizabeth Sisco Parada', role: 'HECNC Student Services · Education Center Specialist', phone: '(619) 216-6665 x4852', tel: '+16192166665;ext=4852', email: 'esisco2@swccd.edu', source: 'https://go.swccd.edu/contact/person/8fa8f74bdb7fa6005e33f8fdae961983' },
  { name: 'Karen Sanchez Jimenez', role: 'Student Employment Services · Federal Work-Study (not Payroll)', phone: '(619) 421-6700 x5254', tel: '+16194216700;ext=5254', email: '', source: 'https://go.swccd.edu/contact/person/59decb5cdb168094469a5e65ce961968' },
  { name: 'Enrique Velez', role: 'HECNC IT · Instructional Lab Technician—Microcomputer', phone: '(619) 216-6665 x4877', tel: '+16192166665;ext=4877', email: 'evelez@swccd.edu', source: 'https://www.swccd.edu/administration/institutional-technology/staff-directory.aspx' },
] as const;
const serviceContacts = [
  ['Restorative Justice Program', '(619) 216-6655', '+16192166655', 'swcrestorativejustice@swccd.edu'],
  ['HEC National City Front Desk', '(619) 216-6665', '+16192166665', 'hecnc@swccd.edu'],
  ['SWC Cares office', '(619) 421-6700 x5404', '+16194216700;ext=5404', 'teros@swccd.edu'],
  ['Disability Support Services', '(619) 482-6512', '+16194826512', 'dss@swccd.edu'],
  ['EOPS', '(619) 482-6456', '+16194826456', 'eops@swccd.edu'],
  ['SWC Tutoring', '(619) 482-6348', '+16194826348', 'swclastutor@swccd.edu'],
  ['Online Learning Center', '(619) 482-6595', '+16194826595', 'onlinelearning@swccd.edu'],
  ['SWC Bookstore', '(619) 482-6416', '+16194826416', 'bookstore@swccd.edu'],
  ['Financial Aid', '(619) 482-6357', '+16194826357', 'financialaid@swccd.edu'],
  ['Payroll Services', '(619) 482-6335', '+16194826335', 'payroll@swccd.edu'],
  ['IT Help Desk', '(619) 421-6700 x4357', '+16194216700;ext=4357', 'helpdesk@swccd.edu'],
  ['WorkAbility III · Jenny Nominni', '(619) 421-6700 x5492', '+16194216700;ext=5492', 'jnominni@swccd.edu'],
  ['Personal Wellness', '(619) 421-6700 x5279', '+16194216700;ext=5279', 'swcpersonalwellness@swccd.edu'],
] as const;
const pathwayResources = [
  ['SWC Alcohol and Other Drug Studies', 'Program information and certificate requirements.', 'https://catalog.swccd.edu/associate-degree-certificate-programs/swhs/alcohol-drug-studies-cert/'],
  ['CADTP registrant resources', 'External SUDRC registration, renewal, education, and certification guidance.', 'https://cadtpcounselors.org/registrants/'],
  ['SWC Work Experience Education', 'Field-placement guidance; Julie Swanson, jswanson@swccd.edu, (619) 421-6700 x5715.', 'https://www.swccd.edu/student-support/career-and-transfer-connections/employment-and-internships/work-experience-education-program/index.aspx'],
  ['Personal Wellness / Behavioral Health', 'Confidential counseling and referral support; do not email personal health information.', 'https://www.swccd.edu/student-support/health-services/personal-wellness-mental-health/index.aspx'],
] as const;
const officialLinks = [
  ['Apply to SWC', 'Application instructions and the link to CCCApply.', 'https://www.swccd.edu/admissions-and-financial-aid/apply-and-register-for-credit-courses/index.aspx'],
  ['Class search and registration', 'Find available classes and sign in to register.', 'https://collselfserv.swccd.edu/Student/Courses'],
  ['SWC catalog', 'Course descriptions, degrees, and certificate requirements.', 'https://www.swccd.edu/classes-and-registration/catalog/'],
  ['SWC Financial Aid', 'Aid options, application guidance, and office support.', 'https://www.swccd.edu/admissions-and-financial-aid/financial-aid/index.aspx'],
  ['FAFSA', 'Start or continue your federal student aid application.', 'https://studentaid.gov/h/apply-for-aid/fafsa'],
  ['Cal Grant Programs', 'California grant eligibility and application information.', 'https://csac.ca.gov/cal-grant'],
  ['WebGrants 4 Students', 'Check your Cal Grant status and manage your award.', 'https://mygrantinfo.csac.ca.gov/'],
  ['Restorative Justice and Rising Scholars', 'Program information, mentoring, and student support.', 'https://www.swccd.edu/programs-and-academics/specialty-programs/restorative-justice/index.aspx'],
  ['SWC Cares', 'Help with food, housing, transportation, and technology.', 'https://www.swccd.edu/student-support/swc-cares/index.aspx'],
  ['SWC Student Support', 'Counseling, tutoring, and other campus services.', 'https://www.swccd.edu/student-support/index.aspx'],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="description" content={description} />
    <meta name="author" content="Boomer Rawlings" />
    <meta name="theme-color" content="#9b2743" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="utility-header">
      <a href="/" aria-label="Boomer Rawlings home">BoomerRawlings.com</a>
      <span>{title}</span>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="page-title">
        <div class="wrap hero-inner">
          <h1 id="page-title">{title}</h1>
          <p class="unofficial-note"><strong>Unofficial resource.</strong> Maintained on a personal website; Southwestern College policies and official systems take precedence.</p>
        </div>
      </section>

      <nav class="section-tabs" aria-label="Page sections">
        <div class="wrap tab-row">
          {tabs.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </nav>

      <section id="downloads" class="wrap content-section documents-section" aria-labelledby="downloads-heading">
        <header class="section-heading"><span>01</span><div><p>Documents</p><h2 id="downloads-heading">Forms and reference sheets</h2></div></header>
        <p class="documents-intro">Each PDF has its own preview and download.</p>
        <div class="document-grid">
          {pdfResources.map(([resourceTitle, text, href, pages, width, height]) => (
            <DocumentPreview title={resourceTitle} description={text} href={href} preview={href.replace('/pdf/', '/previews/').replace('.pdf', '.jpg')} pages={pages} width={width} height={height} />
          ))}
        </div>
        <p class="canva-resource"><a href="https://canva.link/7zeu5d8ronzqd2x" target="_blank" rel="noopener noreferrer">Restorative Justice Student Technology Packet — open in Canva <span aria-hidden="true">↗</span></a></p>
        <p class="resource-note document-safety">Keep completed forms in approved restricted systems; never upload completed copies here. Some original handouts include password fields. Follow current SWC security policy and never record passwords in shared copies.</p>
      </section>

      <section id="contacts" class="wrap content-section" aria-labelledby="contacts-heading">
        <header class="section-heading"><span>02</span><div><p>Contacts</p><h2 id="contacts-heading">People and service desks</h2></div></header>

        <div class="contact-section" aria-labelledby="people-heading">
          <div class="resource-group-heading"><h3 id="people-heading">Key people</h3><p>Roles and details checked against current SWC sources.</p></div>
          <div class="contact-grid">
            {keyContacts.map((contact, index) => (
              <Fragment>
                {index === 2 && <hr class="contact-divider" aria-hidden="true" />}
                <article class="contact-card">
                  <p>{contact.role}</p>
                  <h3>{contact.name}</h3>
                  <div class="contact-actions">
                    {'office' in contact && <span class="contact-office">{contact.office}</span>}
                    <a href={`tel:${contact.tel}`}>{contact.phone}</a>
                    {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
                    <a href={contact.source} target="_blank" rel="noopener noreferrer">{contact.email ? 'Official source' : 'Official contact form'} <span aria-hidden="true">↗</span></a>
                  </div>
                </article>
              </Fragment>
            ))}
          </div>
          <aside class="contact-note"><strong>Directory corrections:</strong> SWC lists Elizabeth as <em>Sisco Parada</em>, Karen under Student Employment/Federal Work-Study rather than Payroll, and Manuel under Student Services. SWC’s published program is Alcohol &amp; Other Drug Studies; CADTP uses SUDRC for an external Registered SUD Counselor status.</aside>
        </div>

        <div class="contact-section" aria-labelledby="services-heading">
          <div class="resource-group-heading"><h3 id="services-heading">Service desks</h3><p>Quick references from the resource sheet and official SWC pages.</p></div>
          <ul class="service-list">
            {serviceContacts.map(([name, phone, tel, email]) => (
              <li><strong>{name}</strong><span><a href={`tel:${tel}`}>{phone}</a><a href={`mailto:${email}`}>{email}</a></span></li>
            ))}
          </ul>
        </div>

        <div class="contact-section" aria-labelledby="pathway-heading">
          <div class="resource-group-heading"><h3 id="pathway-heading">Alcohol &amp; Other Drug Studies / SUDRC references</h3><p>Program, registration, fieldwork, and support links.</p></div>
          <div class="official-grid">
            {pathwayResources.map(([resourceTitle, text, href]) => (
              <a href={href} target="_blank" rel="noopener noreferrer"><span><strong>{resourceTitle}</strong><small>{text}</small></span><span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>
      </section>

      <section id="official-links" class="wrap content-section" aria-labelledby="official-heading">
        <header class="section-heading"><span>03</span><div><p>Official links</p><h2 id="official-heading">Enrollment, financial aid, and support</h2></div></header>
        <div class="official-grid">
          {officialLinks.map(([title, text, href]) => (
            <a href={href} target="_blank" rel="noopener noreferrer"><span><strong>{title}</strong><small>{text}</small></span><span aria-hidden="true">↗</span></a>
          ))}
        </div>
      </section>
    </main>

    <footer class="page-footer"><p><strong>{title}</strong> · Unofficial resource</p><p>Maintained by Boomer Rawlings</p></footer>
    <PdfPreviewDialog />
    <CoffeeButton />
  </body>
</html>

<style is:global>
  :root{color-scheme:light;--burgundy:#9b2743;--burgundy-dark:#5c1427;--gold:#eaaa00;--gold-soft:#fff5cf;--paper:#fbfaf7;--ink:#2c2527;--muted:#6f6265;--rule:#ded5d2;--sans:'Source Sans 3',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--paper);font-family:var(--sans);scroll-behavior:smooth}
  *{box-sizing:border-box}html{background:var(--paper);min-width:20rem}body{background:var(--paper);color:var(--ink);margin:0;min-height:100vh}a{color:inherit}p,h1,h2,h3{margin-top:0}.wrap{margin-inline:auto;max-width:72rem;padding-inline:1.5rem}
  .skip-link{background:var(--burgundy-dark);color:#fff;left:0;padding:.75rem 1rem;position:fixed;top:0;transform:translateY(-120%);transition:transform 120ms ease;z-index:100}.skip-link:focus{transform:translateY(0)}
  .utility-header{align-items:center;background:var(--burgundy-dark);border-top:.45rem solid var(--gold);color:#fff;display:flex;font-size:.82rem;justify-content:space-between;letter-spacing:.04em;padding:.85rem max(1.25rem,calc((100vw - 72rem)/2));text-transform:uppercase}.utility-header a{font-weight:700;text-underline-offset:.2em}.utility-header a:focus-visible{outline-color:var(--gold)}
  .hero{background:radial-gradient(circle at 83% 22%,rgb(234 170 0/.22),transparent 23rem),linear-gradient(180deg,#fff,#fffdf7);border-bottom:1px solid var(--rule)}.hero-inner{padding-block:clamp(3.5rem,8vw,7rem) clamp(3rem,7vw,6rem)}
  .section-heading p{color:var(--burgundy);font-size:.77rem;font-weight:700;letter-spacing:.14em;margin:0;text-transform:uppercase}h1{color:var(--burgundy-dark);font-size:clamp(3.15rem,8.8vw,6.8rem);font-weight:700;letter-spacing:-.055em;line-height:.91;margin:1.35rem 0 1.75rem;max-width:14ch}.unofficial-note{border-left:.24rem solid var(--gold);color:var(--muted);line-height:1.5;margin:2rem 0 0;max-width:43rem;padding-left:1rem}
  .section-tabs{background:rgb(251 250 247/.95);border-bottom:1px solid var(--rule);position:sticky;top:0;z-index:20}.tab-row{align-items:center;display:flex;gap:.55rem;overflow-x:auto;padding-block:.75rem;scrollbar-width:thin}.section-tabs a{background:#fff;border:1px solid var(--rule);border-radius:999px;flex:0 0 auto;font-size:.88rem;font-weight:600;padding:.55rem .9rem;text-decoration:none}.section-tabs a:hover,.section-tabs a:focus-visible{background:var(--gold-soft);border-color:var(--gold);color:var(--burgundy-dark)}
  .content-section{padding-block:clamp(3.75rem,8vw,6.5rem);scroll-margin-top:5rem}.content-section+.content-section{border-top:1px solid var(--rule)}.section-heading{align-items:start;display:grid;gap:1.1rem;grid-template-columns:2.4rem minmax(0,1fr);margin-bottom:2.4rem}.section-heading>span{color:var(--burgundy);font-size:.86rem;font-weight:700;letter-spacing:.1em;margin-top:.32rem}h2{color:var(--burgundy-dark);font-size:clamp(2rem,4.6vw,3.65rem);letter-spacing:-.035em;line-height:1;margin:.4rem 0 0}h3{color:var(--burgundy-dark);font-size:1.35rem;line-height:1.15}
  .resource-group+.resource-group{margin-top:2.4rem}.resource-group-heading{align-items:end;display:flex;gap:1rem;justify-content:space-between;margin-bottom:.85rem}.resource-group-heading h3,.resource-group-heading p{margin:0}.resource-group-heading p,.resource-note{color:var(--muted);font-size:.88rem}.resource-note{background:var(--gold-soft);border-left:.22rem solid var(--gold);line-height:1.45;margin:0 0 .9rem;padding:.65rem .8rem}.download-grid,.official-grid{display:grid;gap:.9rem;grid-template-columns:repeat(3,minmax(0,1fr))}.download-card{align-items:start;background:#fff;border:1px solid var(--rule);border-radius:1rem;display:grid;gap:.9rem;grid-template-columns:2.6rem minmax(0,1fr) auto;min-height:6.5rem;padding:1.15rem;text-decoration:none;transition:transform 140ms ease,box-shadow 140ms ease}.download-card:hover,.download-card:focus-visible{box-shadow:0 .7rem 2rem rgb(92 20 39/.08);transform:translateY(-2px)}.download-card--missing{background:var(--paper);border-style:dashed}.download-card--missing .file-type{background:var(--muted)}.download-card--missing:hover{box-shadow:none;transform:none}.file-type{align-items:center;background:var(--burgundy);border-radius:.45rem;color:#fff;display:flex;font-size:.61rem;font-weight:700;height:2.6rem;justify-content:center;letter-spacing:.035em;width:2.6rem}.download-card strong,.download-card small,.official-grid strong,.official-grid small{display:block}.download-card strong,.official-grid strong{color:var(--burgundy-dark);font-size:1.03rem;line-height:1.2}.download-card small,.official-grid small{color:var(--muted);font-size:.86rem;line-height:1.45;margin-top:.45rem}.arrow{color:var(--burgundy);font-size:1.2rem;font-weight:700}
  .contact-section+.contact-section{margin-top:2.5rem}.contact-grid{display:grid;gap:.9rem;grid-template-columns:repeat(6,minmax(0,1fr))}.contact-card{grid-column:span 2;background:#fff;border:1px solid var(--rule);border-radius:1rem;padding:1.15rem}.contact-card:nth-child(-n+2){grid-column:span 3}.contact-divider{grid-column:1/-1;border:0;border-top:1px solid var(--rule);margin:.5rem 0}.contact-card>p{color:var(--burgundy);font-size:.73rem;font-weight:700;letter-spacing:.07em;line-height:1.35;margin:0 0 .55rem;text-transform:uppercase}.contact-card h3{font-size:1.12rem;margin:0 0 .75rem}.contact-actions{display:grid;gap:.28rem}.contact-actions a{color:var(--muted);font-size:.84rem;overflow-wrap:anywhere;text-underline-offset:.18em}.contact-actions a:last-child{color:var(--burgundy);font-weight:600;margin-top:.25rem}.contact-note{background:var(--gold-soft);border-left:.22rem solid var(--gold);color:#5f513b;line-height:1.5;margin-top:1rem;padding:.85rem 1rem}.service-list{display:grid;gap:0 2rem;grid-template-columns:repeat(2,minmax(0,1fr));list-style:none;margin:0;padding:0}.service-list li{border-top:1px solid var(--rule);display:grid;gap:.25rem;padding:.8rem 0}.service-list strong{color:var(--burgundy-dark)}.service-list span{display:flex;flex-wrap:wrap;gap:.25rem 1rem}.service-list a{color:var(--muted);font-size:.88rem;overflow-wrap:anywhere;text-underline-offset:.18em}
  .official-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.official-grid a{align-items:start;border-top:1px solid var(--rule);display:grid;gap:1rem;grid-template-columns:minmax(0,1fr) auto;padding:1.15rem 0;text-decoration:none}.official-grid a:hover strong,.official-grid a:focus-visible strong{color:var(--burgundy);text-decoration:underline;text-underline-offset:.2em}.official-grid a>span:last-child{color:var(--burgundy);font-size:1.1rem;font-weight:700}
  .page-footer{align-items:end;background:var(--burgundy-dark);border-bottom:.45rem solid var(--gold);color:#fff;display:flex;font-size:.82rem;justify-content:space-between;padding:2rem max(1.5rem,calc((100vw - 69rem)/2))}.page-footer p{margin:0}.page-footer p:last-child{color:rgb(255 255 255/.72);text-align:right}:focus-visible{outline:3px solid var(--burgundy);outline-offset:3px}
  @media(max-width:52rem){.download-grid,.official-grid,.contact-grid,.service-list{grid-template-columns:minmax(0,1fr)}.contact-card,.contact-card:nth-child(-n+2){grid-column:1/-1}.resource-group-heading{align-items:start;display:grid;gap:.25rem}.download-card{min-height:0}.page-footer{align-items:start;display:grid;gap:.55rem}.page-footer p:last-child{text-align:left}}
  @media(max-width:34rem){.utility-header{align-items:start;display:grid;gap:.25rem;padding-inline:1rem}.wrap{padding-inline:1rem}h1{font-size:clamp(2.75rem,16vw,4.25rem)}.section-heading{gap:.6rem;grid-template-columns:1.9rem minmax(0,1fr)}}
  .hero-inner{padding-block:2rem 1.75rem}
  h1{font-size:clamp(2.25rem,5vw,3.75rem);letter-spacing:-.035em;line-height:1.05;margin:.75rem 0 1rem;max-width:24ch}
  .unofficial-note{font-size:.9rem;margin-top:1rem;max-width:48rem}
  .documents-section{padding-top:2rem}
  .documents-section .section-heading{margin-bottom:.9rem}
