  ['Canvas', 'Android', 'Google Play', 'https://play.google.com/store/apps/details?id=com.instructure.candroid', 'canvas-android'],
  ['Outlook', 'iOS · iPhone / iPad', 'App Store', 'https://apps.apple.com/us/app/microsoft-outlook/id951937596', 'outlook-ios'],
  ['Outlook', 'Android', 'Google Play', 'https://play.google.com/store/apps/details?id=com.microsoft.office.outlook', 'outlook-android'],
