---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="description" content={description} />
    <meta name="author" content="Boomer Rawlings" />
    <meta name="theme-color" content="#9b2743" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="utility-header">
      <a href="/" aria-label="Boomer Rawlings home">BoomerRawlings.com</a>
      <span>{title}</span>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="page-title">
        <div class="wrap hero-inner">
          <h1 id="page-title">{title}</h1>
          <a class="course-search-link" href="https://collselfserv.swccd.edu/Student/Courses" target="_blank" rel="noopener noreferrer" aria-label="Course & Course Section Search (opens in a new tab)"><span>Course &amp; Course Section Search</span><span aria-hidden="true">↗</span></a>
          <p class="unofficial-note"><strong>Unofficial resource.</strong> Maintained on a personal website; Southwestern College policies and official systems take precedence.</p>
        </div>
      </section>

      <nav class="section-tabs" aria-label="Page sections">
        <div class="wrap tab-row">
          {tabs.map(([label, href]) => <a href={href}>{label}</a>)}
        </div>
      </nav>

      <section id="getting-started" class="wrap content-section getting-started-section" aria-labelledby="getting-started-heading">
        <header class="section-heading"><span>01</span><div><p>Enrollment essentials</p><h2 id="getting-started-heading">Getting started</h2></div></header>
        <ol class="getting-started-list" role="list">
          <li class="start-step">
            <h3>CCCApply</h3>
            <p>Apply to Southwestern College through OpenCCC.</p>
            <div class="start-actions">
              <a class="start-button" href="https://launch.cccmypath.org/mypath/091?authSource=OpenCCC" target="_blank" rel="noopener noreferrer">Start CCCApply <span aria-hidden="true">↗</span></a>
              <a class="start-text-link" href="https://www.swccd.edu/admissions-and-financial-aid/apply-and-register-for-credit-courses/index.aspx" target="_blank" rel="noopener noreferrer">SWC application instructions <span aria-hidden="true">↗</span></a>
            </div>
          </li>
          <li class="start-step">
            <h3>FAFSA</h3>
            <p>Start or continue your federal student aid application.</p>
            <div class="start-actions"><a class="start-button" href="https://studentaid.gov/h/apply-for-aid/fafsa" target="_blank" rel="noopener noreferrer">Apply for FAFSA <span aria-hidden="true">↗</span></a></div>
          </li>
          <li class="start-step start-step--wide">
            <h3>MySWC Login</h3>
            <p>Access your SWC account, student email, Canvas, and Self-Service.</p>
            <div class="start-actions"><a class="start-button" href="https://my.swccd.edu/" target="_blank" rel="noopener noreferrer">Log in to MySWC <span aria-hidden="true">↗</span></a></div>
          </li>
          <li class="start-step start-step--wide">
            <h3>Mobile Setup</h3>
            <p>Install the student Canvas app (listed as “Canvas by Instructure”) and Microsoft Outlook. Scan a QR code with your phone, or click its store link.</p>
            <div class="mobile-app-grid">
              {mobileApps.map(([app, platform, store, href, id]) => (
                <a class="mobile-app" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${app} for ${platform} — open ${store}`}>
                  <strong>{app}</strong><span>{platform}</span>
                  <img src={`/images/swc/qr/${id}.svg`} width="180" height="180" alt={`${app} ${platform} download QR code`} loading="lazy" decoding="async" />
                  <span class="mobile-store-link">Open {store} <span aria-hidden="true">↗</span></span>
                </a>
              ))}
            </div>
          </li>
          <li class="start-step">
            <h3>CalGrant / WebGrants4Students</h3>
            <p>Check your Cal Grant status and manage your award.</p>
            <div class="start-actions"><a class="start-button" href="https://mygrantinfo.csac.ca.gov/" target="_blank" rel="noopener noreferrer">Open WebGrants4Students <span aria-hidden="true">↗</span></a></div>
          </li>
          <li class="start-step">
            <h3>New Student Orientation</h3>
            <p>Complete your online orientation and learn about SWC.</p>
            <div class="start-actions">
              <a class="start-button start-button--prominent" href="https://orientation.swccd.edu/" target="_blank" rel="noopener noreferrer">Start New Student Orientation <span aria-hidden="true">↗</span></a>
              <a class="start-button start-button--secondary" href="https://www.swccd.edu/admissions-and-financial-aid/resources/online-orientation.aspx" target="_blank" rel="noopener noreferrer">Orientation information <span aria-hidden="true">↗</span></a>
            </div>
          </li>
          <li class="start-step">
            <h3>Assessments / Placements</h3>
            <p>Review your placement, answer any required guided-placement questions, and check prerequisites for higher-level classes.</p>
            <div class="start-actions"><a class="start-button start-button--prominent" href="https://www.swccd.edu/student-support/placement-and-prerequisites/" target="_blank" rel="noopener noreferrer">Assessments &amp; Placements <span aria-hidden="true">↗</span></a></div>
          </li>
          <li class="start-step">
            <h3>Evaluations</h3>
            <p>Request evaluation of transcripts from other schools. In Parchment, select your previous school as the sender and SWC as the recipient, if supported.</p>
            <div class="start-actions">
              <a class="start-button" href="https://www.swccd.edu/degrees-and-certificates/graduation-support/evaluations-and-petitions/index.aspx" target="_blank" rel="noopener noreferrer">SWC evaluations <span aria-hidden="true">↗</span></a>
              <a class="start-button start-button--secondary" href="https://www.parchment.com/students/order-status/" target="_blank" rel="noopener noreferrer">Order transcripts · Parchment <span aria-hidden="true">↗</span></a>
            </div>
          </li>
        </ol>
      </section>

      <section id="downloads" class="wrap content-section documents-section" aria-labelledby="downloads-heading">
        <header class="section-heading"><span>02</span><div><p>Documents</p><h2 id="downloads-heading">Forms and reference sheets</h2></div></header>
        <p class="documents-intro">Preview or download each PDF, or open the technology packet in Canva.</p>
        <div class="document-grid">
          {pdfResources.map(([resourceTitle, text, href, pages, width, height], index) => (
            <Fragment>
              {index === 3 && <article class="canva-card">
                <a href="https://canva.link/7zeu5d8ronzqd2x" target="_blank" rel="noopener noreferrer" aria-label="Restorative Justice Student Technology Packet — open in Canva (opens in a new tab)">
                  <div class="canva-card-cover" aria-hidden="true"><span>Canva</span><strong>Technology<br />Packet</strong><span>Restorative Justice · SWC</span></div>
                  <div class="canva-card-details"><p class="canva-card-meta">Canva · External document</p><h3>Canva Technology Packet</h3><p>Restorative Justice Student Technology Packet. View the original in Canva.</p><span class="canva-card-button">open in Canva <span aria-hidden="true">↗</span></span></div>
                </a>
              </article>}
              <DocumentPreview title={resourceTitle} description={text} href={href} preview={href.replace('/pdf/', '/previews/').replace('.pdf', '.jpg')} pages={pages} width={width} height={height} />
            </Fragment>
          ))}
        </div>
        <p class="resource-note document-safety">Keep completed forms in approved restricted systems; never upload completed copies here. Some original handouts include password fields. Follow current SWC security policy and never record passwords in shared copies.</p>
      </section>

      <section id="contacts" class="wrap content-section" aria-labelledby="contacts-heading">
        <header class="section-heading"><span>03</span><div><p>Contacts</p><h2 id="contacts-heading">People and service desks</h2></div></header>

        {contactGroups.map(({ heading, id, cares, contacts }) => (
        <div class="contact-section" aria-labelledby={id}>
          <div class="resource-group-heading"><h3 id={id}>{heading}</h3><p>{cares ? 'Basic needs support contacts.' : 'Roles and details checked against current SWC sources.'}</p></div>
          <div class:list={['contact-grid', { 'contact-grid--cares': cares }]}>
            {contacts.map((contact, index) => (
              <Fragment>
                {!cares && index === 2 && <hr class="contact-divider" aria-hidden="true" />}
                <article class="contact-card">
                  <p>{contact.role}</p>
                  <h3>{contact.name}</h3>
                  <div class="contact-actions">
                    {'office' in contact && <span class="contact-office">{contact.office}</span>}
                    <a href={`tel:${contact.tel}`}>{contact.phone}</a>
                    {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
                    <a href={contact.source} target="_blank" rel="noopener noreferrer">{contact.email ? 'Official source' : 'Official contact form'} <span aria-hidden="true">↗</span></a>
                  </div>
                </article>
              </Fragment>
            ))}
          </div>
          {!cares && <aside class="contact-note"><strong>Directory corrections:</strong> SWC lists Elizabeth as <em>Sisco Parada</em> and Karen under Student Employment/Federal Work-Study rather than Payroll. SWC’s published program is Alcohol &amp; Other Drug Studies; CADTP uses SUDRC for an external Registered SUD Counselor status.</aside>}
        </div>
        ))}

        <div class="contact-section" aria-labelledby="services-heading">
          <div class="resource-group-heading"><h3 id="services-heading">Service desks</h3><p>Quick references from the resource sheet and official SWC pages.</p></div>
          <ul class="service-list">
            {serviceContacts.map(([name, phone, tel, email]) => (
              <li><strong>{name}</strong><span><a href={`tel:${tel}`}>{phone}</a><a href={`mailto:${email}`}>{email}</a></span></li>
            ))}
          </ul>
        </div>

        <div class="contact-section" aria-labelledby="pathway-heading">
          <div class="resource-group-heading"><h3 id="pathway-heading">Alcohol &amp; Other Drug Studies / SUDRC references</h3><p>Program, registration, fieldwork, and support links.</p></div>
          <div class="official-grid">
            {pathwayResources.map(([resourceTitle, text, href]) => (
              <a href={href} target="_blank" rel="noopener noreferrer"><span><strong>{resourceTitle}</strong><small>{text}</small></span><span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>
        <details id="chair-references" class="reference-fold">
          <summary>Department chairs and Council of Chairs · 2026–2027</summary>
          <p>Transcribed from the two reference sheets. Where names or emails differ, each entry is kept as printed.</p>
          <h3 id="council-table-heading">Council of Chairs</h3>
          <p class="table-scroll-hint">Scroll sideways for all columns.</p>
          <div class="chair-table-wrap" role="region" aria-labelledby="council-table-heading" tabindex="0">
            <table id="council-chair-table" class="chair-table">
              <caption>Council of Chairs, 2026–2027</caption>
              <thead><tr><th scope="col">Chair</th><th scope="col">Department</th><th scope="col">Email</th></tr></thead>
              <tbody>
                {councilChairs.map(([name, department, email]) => (
                  <tr><th scope="row">{name}</th><td>{department}</td><td><a href={`mailto:${email}`}>{email}</a></td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="chair-table-note">*Council of Chairs Chair: Professor Tinh-Alfredo Khuong.</p>
          <p class="chair-table-note">The handwritten interim note beside Life Science is unclear. The department sheet below includes a printed interim listing.</p>

          <h3 id="department-table-heading">Department chairs by school</h3>
          <p class="table-scroll-hint">Scroll sideways for all columns.</p>
          <div class="chair-table-wrap" role="region" aria-labelledby="department-table-heading" tabindex="0">
            <table id="department-chair-table" class="chair-table">
              <caption>Southwestern College Department Chairs, 2026–2027</caption>
              <thead><tr><th scope="col">Department</th><th scope="col">Chair</th><th scope="col">Email</th><th scope="col">Extension</th></tr></thead>
              {departmentChairGroups.map((group) => (
                <tbody>
                  <tr class="chair-school-row"><th scope="rowgroup" colspan="4">
                    <span>{group.name}</span>
                    <small>{group.area} · Dean: {group.dean}</small>
                    <small>Also listed in the heading: {group.listedNames}</small>
                    {group.director && <small>{group.director}</small>}
                  </th></tr>
                  {group.rows.map(([department, chair, email, extension, note]) => (
                    <tr data-department-chair>
                      <th scope="row">{department}</th>
                      <td>{chair}{note && <small class="chair-row-note">{note}</small>}</td>
                      <td><a href={`mailto:${email}`}>{email}</a></td>
                      <td><a href={`tel:+16194216700;ext=${extension}`}>{extension}</a></td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
          <p class="chair-table-note">Department chairs are elected every three years; the library chair and presiding chair are elected every two years, per the sheet.</p>
        </details>
      </section>

      <section id="official-links" class="wrap content-section" aria-labelledby="official-heading">
        <header class="section-heading"><span>04</span><div><p>Official links</p><h2 id="official-heading">Enrollment, financial aid, and support</h2></div></header>
        <div class="official-grid">
          {officialLinks.map(([title, text, href]) => (
            <a href={href} target="_blank" rel="noopener noreferrer"><span><strong>{title}</strong><small>{text}</small></span><span aria-hidden="true">↗</span></a>
          ))}
        </div>
        <details id="campus-maps" class="reference-fold">
          <summary>Campus maps</summary>
          <p>Maps from Southwestern College. Choose a location below; official PDFs and directions open in a new tab.</p>
          {campusMaps.map((campus) => (
            <details id={`map-${campus.id}`} class="campus-map">
              <summary>{campus.name}<span>{campus.address}</span></summary>
              <div class="map-links">
                <a href={`${campusMapBase}${campus.directory}/_files/${campus.pdf}`} target="_blank" rel="noopener noreferrer">Official PDF <span aria-hidden="true">↗</span></a>
                <a href={`${campusMapBase}${campus.directory}/index.aspx`} target="_blank" rel="noopener noreferrer">Directions <span aria-hidden="true">↗</span></a>
              </div>
              <div class="reference-sheet-grid">
                {campus.sheets.map((label, index) => (
                  <figure>
                    <figcaption>{label}</figcaption>
                    <a href={`/documents/swc/maps/${campus.id}-${index + 1}.jpg`} target="_blank" rel="noopener noreferrer" aria-label={`View ${campus.name}: ${label}, full size (opens in a new tab)`}>
                      <img src={`/documents/swc/maps/${campus.id}-${index + 1}.jpg`} alt={`${campus.name}: ${label}. Official SWC map showing rooms, facilities, and routes.`} width={campus.width} height={campus.height} loading="lazy" decoding="async" />
                      <span>View full size <span aria-hidden="true">↗</span></span>
                    </a>
                  </figure>
                ))}
              </div>
            </details>
          ))}
          <p class="map-source-note">Previews checked <time datetime="2026-09-14">September 14, 2026</time>. See the official PDFs for updates.</p>
        </details>
      </section>
    </main>

    <footer class="page-footer"><p><strong>{title}</strong> · Unofficial resource</p><p>Maintained by Boomer Rawlings</p></footer>
    <PdfPreviewDialog />
    <CoffeeButton />
  </body>
</html>

