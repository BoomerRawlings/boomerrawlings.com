---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';

const title = 'SWC Student Worker Hub';
const description = 'A compact, unofficial Southwestern College student-worker hub for workflows, forms, PDF handouts, contacts, guides, and live resource lists.';
const canonical = 'https://boomerrawlings.com/swc/';
const socialImage = 'https://boomerrawlings.com/images/swc-student-worker-hub-social.png';
const tabs = [
  ['Start here', '#start'],
  ['Workflows', '#workflows'],
  ['Resources', '#downloads'],
  ['Contacts', '#contacts'],
  ['Handoff', '#handoff'],
  ['Official links', '#official-links'],
] as const;
const workflows = [
  {
    number: '01',
    title: 'Start a request',
    summary: 'Clarify the outcome before touching the files.',
    steps: [
      'Read the whole request. Identify the expected result, deadline, and person who approves it.',
      'Locate the current source in the approved SWC system. Do not copy protected material to personal storage.',
      'If the request is incomplete, contradictory, or urgent, pause and ask the supervisor before proceeding.',
      'Create a clearly named working copy and keep the original intact.',
    ],
    finish: 'Ready to begin when the owner, due date, source, and next action are clear.',
  },
  {
    number: '02',
    title: 'Produce and review',
    summary: 'Make the change, then check it like someone else will inherit it.',
    steps: [
      'Follow the request and save work in small, understandable revisions.',
      'Check names, dates, spelling, links, permissions, and accessibility before delivery.',
      'Keep editable source files with the final export when both are useful.',
      'Ask for review when a change is public-facing, ambiguous, or difficult to reverse.',
    ],
    finish: 'Ready to deliver when the result matches the request and another worker can understand the files.',
  },
  {
    number: '03',
    title: 'Deliver and close',
    summary: 'Leave a clear result instead of a trail of mystery files.',
    steps: [
      'Put the final file or link in the approved destination and confirm its permissions.',
      'Send a short completion note: what changed, where it lives, and anything still pending.',
      'Archive or label superseded drafts so the current version is obvious.',
      'Record any follow-up, owner, and due date before marking the task complete.',
    ],
    finish: 'Closed when the recipient can open the result and the next action is documented.',
  },
  {
    number: '04',
    title: 'End the shift or week',
    summary: 'Write the note your future self will wish existed.',
    steps: [
      'List completed work, active work, blockers, and the first next step for each open item.',
      'Link to folders or records—never paste credentials or protected student information into the note.',
      'Clean up downloads and local copies that should not remain on the device.',
      'Send the status note through the agreed SWC channel before leaving.',
    ],
    finish: 'Done when someone else could continue the work without guessing.',
  },
] as const;
const templateResources = [
  ['YARD Roster Template', 'Starter roster with status tracking, privacy guidance, and a clearly marked example row.', 'XLSX', '/documents/swc/yard-roster-template.xlsx', false],
  ['YARD Class Sign-In Sheet', 'Session setup and privacy-conscious attendance tracking.', 'XLSX', '/documents/swc/yard-class-sign-in-sheet.xlsx', false],
  ['SWC Loaner Laptop Agreement', 'Editable checkout, acknowledgment, and return form.', 'DOCX', '/documents/swc/swc-loaner-laptop-agreement.docx', false],
  ['SWC Office Sign-In Sheet', 'Minimal front-desk visit and wait-time log.', 'XLSX', '/documents/swc/swc-office-sign-in-sheet.xlsx', false],
  ['SWC Event Sign-In Sheet', 'Event setup, attendance, and participation log.', 'XLSX', '/documents/swc/swc-event-sign-in-sheet.xlsx', false],
  ['SWC Letterhead', 'Existing Restorative Justice letterhead in Google Drive.', 'DRIVE', 'https://docs.google.com/document/d/1pS-xkTVeqI3PnUSKG9ZBryxfJSb4rD32/edit?usp=drivesdk&ouid=115571851172085175998&rtpof=true&sd=true', true],
] as const;
const guideResources = [
  ['SWC Onboarding', 'First-shift, work-cycle, accessibility, and first-month guide.', 'DOCX', '/documents/swc/swc-onboarding.docx'],
  ['SWC Resources', 'Quick contacts, resource links, common questions, and handoff form.', 'DOCX', '/documents/swc/swc-resources.docx'],
] as const;
const pdfResources = [
  ['Rising Scholar Resource List', 'SWC Cares, support programs, campus services, and phone/email references.', '/documents/swc/pdf/swc-rising-scholar-resource-list.pdf'],
  ['Chula Vista Campus Map & Books', 'Campus map, bus stop, and Restorative Justice books-and-supplies contact.', '/documents/swc/pdf/swc-chula-vista-campus-map-and-books-supplies.pdf'],
  ['Rising Scholar Launch Checklist', 'Security-updated two-page application, financial aid, login, registration, and final-steps checklist.', '/documents/swc/pdf/swc-rising-scholar-launch-checklist.pdf'],
  ['Laptop Loaner Checkout Process', 'Staff workflow for enrollment, contracts, setup, ServiceNow, and tracking.', '/documents/swc/pdf/swc-laptop-loaner-checkout-process.pdf'],
  ['Rising Scholars Center Log', 'Blank office log. Completed copies contain student IDs and must remain restricted.', '/documents/swc/pdf/swc-rising-scholars-center-log.pdf'],
  ['Laptop Loaner Student Agreement', 'Two-page original program agreement with terms, return procedures, and signatures.', '/documents/swc/pdf/swc-laptop-loaner-program-student-agreement.pdf'],
] as const;
const liveResources = [
  ['SWC Bookstore List', 'Existing restricted live list; sharing remains managed in Drive.', 'SHEET', 'https://docs.google.com/spreadsheets/d/1bUlSu97rNrwFdthF1Sju8ZKRKjnL_M5IFGzfhKzXjqw/edit?usp=drivesdk'],
  ['SWC Laptop List', 'Live inventory and restricted loan tracker.', 'SHEET', 'https://docs.google.com/spreadsheets/d/17-M83tEj2t8McKN-9G3HXS-pZD_aqZ8igxpy1xQIkRQ/edit?usp=drivesdk'],
  ['SWC RJ Backpack List', 'Live inventory and restricted assignment tracker.', 'SHEET', 'https://docs.google.com/spreadsheets/d/1DE_i4nM10_J8s5GuFD-s-QLY2dz73QspT1R4fQzYJQE/edit?usp=drivesdk'],
] as const;
const keyContacts = [
  { name: 'Jeanne Kaufman', role: 'Bookstore credit contact (user-specified) · Senior Account Clerk', phone: '(619) 421-6700 x5334', tel: '+16194216700;ext=5334', email: 'jkaufman@swccd.edu', source: 'https://www.swcbookstore.com/site_contact_us.asp' },
  { name: 'Trina Eros', role: 'SWC Cares · Basic Needs Coordinator', phone: '(619) 216-6687', tel: '+16192166687', email: 'teros@swccd.edu', source: 'https://www.swccd.edu/student-support/swc-cares/index.aspx' },
  { name: 'Paola Duarte Vargas', role: 'SWC Cares · Basic Needs Project Technician', phone: '(619) 421-6700 x5404', tel: '+16194216700;ext=5404', email: '', source: 'https://go.swccd.edu/contact/person/5cc7d2b2db5b0850469a5e65ce96190f' },
  { name: 'Manuel Burciaga Tarin', role: 'Student Services Specialist · current directory role', phone: '(619) 421-6700 x5408', tel: '+16194216700;ext=5408', email: '', source: 'https://go.swccd.edu/contact/person/db22ee1f1b41a51060decae5624bcbbd' },
  { name: 'Sandra Salazar', role: 'HECNC Student Services · Education Center Specialist', phone: '(619) 216-6665 x4853', tel: '+16192166665;ext=4853', email: 'ssalazar@swccd.edu', source: 'https://www.swccd.edu/locations/higher-education-center-at-national-city/' },
  { name: 'Sarah Valdivia', role: 'HECNC Student Services · Education Center Specialist', phone: '(619) 216-6665 x4851', tel: '+16192166665;ext=4851', email: 'svaldiva@swccd.edu', source: 'https://www.swccd.edu/locations/higher-education-center-at-national-city/' },
  { name: 'Elizabeth Sisco Parada', role: 'HECNC Student Services · Education Center Specialist', phone: '(619) 216-6665 x4852', tel: '+16192166665;ext=4852', email: 'esisco2@swccd.edu', source: 'https://go.swccd.edu/contact/person/8fa8f74bdb7fa6005e33f8fdae961983' },
  { name: 'Karen Sanchez Jimenez', role: 'Student Employment Services · Federal Work-Study (not Payroll)', phone: '(619) 421-6700 x5254', tel: '+16194216700;ext=5254', email: '', source: 'https://go.swccd.edu/contact/person/59decb5cdb168094469a5e65ce961968' },
  { name: 'Enrique Velez', role: 'HECNC IT · Instructional Lab Technician—Microcomputer', phone: '(619) 216-6665 x4877', tel: '+16192166665;ext=4877', email: 'evelez@swccd.edu', source: 'https://www.swccd.edu/administration/institutional-technology/staff-directory.aspx' },
  { name: 'Yessica Diaz Roman, DrPH', role: 'Alcohol & Other Drug Studies · program contact', phone: '(619) 421-6700 x5440', tel: '+16194216700;ext=5440', email: 'yroman@swccd.edu', source: 'https://catalog.swccd.edu/associate-degree-certificate-programs/swhs/alcohol-drug-studies-cert/' },
] as const;
const serviceContacts = [
  ['Restorative Justice Program', '(619) 216-6655', '+16192166655', 'swcrestorativejustice@swccd.edu'],
  ['HEC National City Front Desk', '(619) 216-6665', '+16192166665', 'hecnc@swccd.edu'],
  ['SWC Cares office', '(619) 421-6700 x5404', '+16194216700;ext=5404', 'teros@swccd.edu'],
  ['Disability Support Services', '(619) 482-6512', '+16194826512', 'dss@swccd.edu'],
  ['EOPS', '(619) 482-6456', '+16194826456', 'eops@swccd.edu'],
  ['SWC Tutoring', '(619) 482-6348', '+16194826348', 'swclastutor@swccd.edu'],
  ['Online Learning Center', '(619) 482-6595', '+16194826595', 'onlinelearning@swccd.edu'],
  ['SWC Bookstore', '(619) 482-6416', '+16194826416', 'bookstore@swccd.edu'],
  ['Financial Aid', '(619) 482-6357', '+16194826357', 'financialaid@swccd.edu'],
  ['Payroll Services', '(619) 482-6335', '+16194826335', 'payroll@swccd.edu'],
  ['IT Help Desk', '(619) 421-6700 x4357', '+16194216700;ext=4357', 'helpdesk@swccd.edu'],
  ['WorkAbility III · Jenny Nominni', '(619) 421-6700 x5492', '+16194216700;ext=5492', 'jnominni@swccd.edu'],
  ['Personal Wellness', '(619) 421-6700 x5279', '+16194216700;ext=5279', 'swcpersonalwellness@swccd.edu'],
] as const;
const pathwayResources = [
  ['SWC Alcohol and Other Drug Studies', 'Current SWC program and Yessica Diaz Roman’s contact information.', 'https://catalog.swccd.edu/associate-degree-certificate-programs/swhs/alcohol-drug-studies-cert/'],
  ['CADTP registrant resources', 'External SUDRC registration, renewal, education, and certification guidance.', 'https://cadtpcounselors.org/registrants/'],
  ['SWC Work Experience Education', 'Field-placement guidance; Julie Swanson, jswanson@swccd.edu, (619) 421-6700 x5715.', 'https://www.swccd.edu/student-support/career-and-transfer-connections/employment-and-internships/work-experience-education-program/index.aspx'],
  ['Personal Wellness / Behavioral Health', 'Confidential counseling and referral support; do not email personal health information.', 'https://www.swccd.edu/student-support/health-services/personal-wellness-mental-health/index.aspx'],
] as const;
const officialLinks = [
  ['Southwestern College', 'Official college website and current institutional information.', 'https://www.swccd.edu/'],
  ['ACE guidelines and resources', 'Official writing, visual identity, event, and website resources.', 'https://www.swccd.edu/administration/advancement-and-community-engagement/ace-guidelines-and-resources.aspx'],
  ['Visual identity guidelines', 'Approved rules for college colors, typography, and logo use.', 'https://www.swccd.edu/administration/advancement-and-community-engagement/_files/marketing_branding/visual_identity_guidelines.pdf'],
  ['Website Rules of the Road', 'SWC guidance for useful, audience-first web content.', 'https://www.swccd.edu/administration/advancement-and-community-engagement/_files/resources/rules_of_road_start_here.pdf'],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="description" content={description} />
    <meta name="author" content="Boomer Rawlings" />
    <meta name="theme-color" content="#9b2743" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SWC Student Worker Hub — workflows, templates, and handoff." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="SWC Student Worker Hub — workflows, templates, and handoff." />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the handoff guide</a>
    <header class="utility-header">
      <a href="/" aria-label="Boomer Rawlings home">BoomerRawlings.com</a>
      <span>Student worker handoff</span>
    </header>

    <main id="main">
      <section class="hero" aria-labelledby="page-title">
        <div class="wrap hero-inner">
          <p class="kicker">Southwestern College · student worker hub</p>
          <h1 id="page-title">Pick up the work.<br />Know what happens next.</h1>
          <p class="hero-copy">One practical page for starting a task, finding the right contact, downloading a clean form or handout, opening a live list, and leaving useful notes for whoever comes next.</p>
          <p class="unofficial-note"><strong>Unofficial resource.</strong> Maintained on a personal website; Southwestern College policies and official systems take precedence.</p>
        </div>
      </section>

      <nav class="section-tabs" aria-label="Page sections">
        <div class="wrap tab-row">
          {tabs.map(([label, href]) => <a href={href}>{label}</a>)}
          <span class="find-hint"><kbd>Ctrl</kbd> + <kbd>F</kbd> searches everything</span>
        </div>
      </nav>

      <section id="start" class="wrap content-section" aria-labelledby="start-heading">
        <header class="section-heading"><span>01</span><div><p>Start here</p><h2 id="start-heading">Your first five minutes</h2></div></header>
        <div class="start-grid">
          <ol class="numbered-list">
            <li><span>1</span><p>Read the latest handoff note and identify the highest-priority open item.</p></li>
            <li><span>2</span><p>Confirm the expected result and deadline with the supervisor or request owner.</p></li>
            <li><span>3</span><p>Open the source only in the approved SWC system and use your own account.</p></li>
            <li><span>4</span><p>Choose the workflow below, then record your first next action.</p></li>
          </ol>
          <aside class="privacy-card" aria-labelledby="privacy-heading">
            <p class="card-label">Public website</p>
            <h3 id="privacy-heading">Keep private work private</h3>
            <p>This page is public. Never place student records, grades, IDs, passwords, payroll details, private contact information, personnel documents, or unreleased materials here. Protected work belongs in an approved SWC system.</p>
          </aside>
        </div>
        <aside class="local-details" aria-labelledby="details-heading">
          <div><p class="card-label">Add before the final handoff</p><h3 id="details-heading">Three department-specific details</h3></div>
          <ul><li>The official task-intake location</li><li>The approved working-file location</li><li>The supervisor or escalation channel</li></ul>
        </aside>
      </section>

      <section id="workflows" class="wrap content-section" aria-labelledby="workflows-heading">
        <header class="section-heading"><span>02</span><div><p>Workflows</p><h2 id="workflows-heading">A simple loop for most work</h2></div></header>
        <div class="workflow-list">
          {workflows.map((workflow, index) => (
            <details open={index === 0}>
              <summary>
                <span class="workflow-number">{workflow.number}</span>
                <span class="workflow-title"><strong>{workflow.title}</strong><small>{workflow.summary}</small></span>
                <span class="disclosure" aria-hidden="true">+</span>
              </summary>
              <div class="workflow-body">
                <ol>{workflow.steps.map((step) => <li>{step}</li>)}</ol>
                <p><strong>Finish line:</strong> {workflow.finish}</p>
              </div>
            </details>
          ))}
        </div>
      </section>

      <section id="downloads" class="wrap content-section" aria-labelledby="downloads-heading">
        <header class="section-heading"><span>03</span><div><p>Resources</p><h2 id="downloads-heading">Forms, guides, and live lists</h2></div></header>

        <div class="resource-group" aria-labelledby="templates-heading">
          <div class="resource-group-heading"><h3 id="templates-heading">Templates &amp; forms</h3><p>Download a clean working copy.</p></div>
          <div class="download-grid">
            {templateResources.map(([resourceTitle, text, type, href, external]) => external ? (
              <a class="download-card" href={href} target="_blank" rel="noopener noreferrer">
                <span class="file-type">{type}</span><span><strong>{resourceTitle}</strong><small>{text}</small></span><span class="arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <a class="download-card" href={href} download>
                <span class="file-type">{type}</span><span><strong>{resourceTitle}</strong><small>{text}</small></span><span class="arrow" aria-hidden="true">↓</span>
              </a>
            ))}
          </div>
        </div>

        <div class="resource-group" aria-labelledby="guides-heading">
          <div class="resource-group-heading"><h3 id="guides-heading">Onboarding &amp; reference</h3><p>Editable guides for training and daily work.</p></div>
          <div class="download-grid">
            {guideResources.map(([resourceTitle, text, type, href]) => (
              <a class="download-card" href={href} download>
                <span class="file-type">{type}</span><span><strong>{resourceTitle}</strong><small>{text}</small></span><span class="arrow" aria-hidden="true">↓</span>
              </a>
            ))}
          </div>
        </div>

        <div class="resource-group" aria-labelledby="pdfs-heading">
          <div class="resource-group-heading"><h3 id="pdfs-heading">Provided PDF handouts</h3><p>Split and oriented from the supplied bundle.</p></div>
          <p class="resource-note"><strong>Never enter passwords.</strong> The launch checklist is security-updated to remove password fields. Completed checklists, logs, or agreements may contain student information; keep them in approved restricted systems. Never upload completed copies here.</p>
          <div class="download-grid">
            {pdfResources.map(([resourceTitle, text, href]) => (
              <a class="download-card" href={href} download>
                <span class="file-type">PDF</span><span><strong>{resourceTitle}</strong><small>{text}</small></span><span class="arrow" aria-hidden="true">↓</span>
              </a>
            ))}
          </div>
        </div>

        <div class="resource-group" aria-labelledby="live-lists-heading">
          <div class="resource-group-heading"><h3 id="live-lists-heading">Live Drive lists</h3><p>Open the current shared version.</p></div>
          <p class="resource-note">Drive access may require your SWC account. Do not change sharing permissions without approval.</p>
          <div class="download-grid">
            {liveResources.map(([resourceTitle, text, type, href]) => (
              <a class="download-card" href={href} target="_blank" rel="noopener noreferrer">
                <span class="file-type">{type}</span><span><strong>{resourceTitle}</strong><small>{text}</small></span><span class="arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section id="contacts" class="wrap content-section" aria-labelledby="contacts-heading">
        <header class="section-heading"><span>04</span><div><p>Contacts</p><h2 id="contacts-heading">People and service desks</h2></div></header>

        <div class="contact-section" aria-labelledby="people-heading">
          <div class="resource-group-heading"><h3 id="people-heading">Key people</h3><p>Roles and details checked against current SWC sources.</p></div>
          <div class="contact-grid">
            {keyContacts.map((contact) => (
              <article class="contact-card">
                <p>{contact.role}</p>
                <h3>{contact.name}</h3>
                <div class="contact-actions">
                  <a href={`tel:${contact.tel}`}>{contact.phone}</a>
                  {contact.email && <a href={`mailto:${contact.email}`}>{contact.email}</a>}
                  <a href={contact.source} target="_blank" rel="noopener noreferrer">{contact.email ? 'Official source' : 'Official contact form'} <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
          <aside class="contact-note"><strong>Directory corrections:</strong> SWC lists Elizabeth as <em>Sisco Parada</em>, Karen under Student Employment/Federal Work-Study rather than Payroll, and Manuel under Student Services. SWC’s published program is Alcohol &amp; Other Drug Studies; CADTP uses SUDRC for an external Registered SUD Counselor status. Yessica is listed here only as the SWC program contact.</aside>
        </div>

        <div class="contact-section" aria-labelledby="services-heading">
          <div class="resource-group-heading"><h3 id="services-heading">Service desks</h3><p>Quick references from the resource sheet and official SWC pages.</p></div>
          <ul class="service-list">
            {serviceContacts.map(([name, phone, tel, email]) => (
              <li><strong>{name}</strong><span><a href={`tel:${tel}`}>{phone}</a><a href={`mailto:${email}`}>{email}</a></span></li>
            ))}
          </ul>
        </div>

        <div class="contact-section" aria-labelledby="pathway-heading">
          <div class="resource-group-heading"><h3 id="pathway-heading">Alcohol &amp; Other Drug Studies / SUDRC references</h3><p>Program, registration, fieldwork, and support links.</p></div>
          <div class="official-grid">
            {pathwayResources.map(([resourceTitle, text, href]) => (
              <a href={href} target="_blank" rel="noopener noreferrer"><span><strong>{resourceTitle}</strong><small>{text}</small></span><span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>
      </section>

      <section id="handoff" class="wrap content-section" aria-labelledby="handoff-heading">
        <header class="section-heading"><span>05</span><div><p>Final handoff</p><h2 id="handoff-heading">Leave the work ready to continue</h2></div></header>
        <ul class="checklist">
          <li><span aria-hidden="true"></span>Every active task has a status, owner, and first next action.</li>
          <li><span aria-hidden="true"></span>Files are in the approved location with clear names and one obvious current version.</li>
          <li><span aria-hidden="true"></span>Links and permissions were tested from the recipient’s point of view.</li>
          <li><span aria-hidden="true"></span>Unfinished work, blockers, and deadlines are stated plainly.</li>
          <li><span aria-hidden="true"></span>Private information and credentials are absent from notes, downloads, and personal devices.</li>
          <li><span aria-hidden="true"></span>The supervisor or request owner received the final status note.</li>
        </ul>
      </section>

      <section id="official-links" class="wrap content-section" aria-labelledby="official-heading">
        <header class="section-heading"><span>06</span><div><p>Official links</p><h2 id="official-heading">When this page and SWC disagree, use SWC</h2></div></header>
        <div class="official-grid">
          {officialLinks.map(([title, text, href]) => (
            <a href={href} target="_blank" rel="noopener noreferrer"><span><strong>{title}</strong><small>{text}</small></span><span aria-hidden="true">↗</span></a>
          ))}
        </div>
      </section>
    </main>

    <footer class="page-footer"><p><strong>SWC Student Worker Hub</strong> · Unofficial handoff resource</p><p>Last reviewed September 1, 2026 · No official college logo is used on this page.</p></footer>
  </body>
</html>

<style is:global>
  :root{color-scheme:light;--burgundy:#9b2743;--burgundy-dark:#5c1427;--gold:#eaaa00;--gold-soft:#fff5cf;--paper:#fbfaf7;--ink:#2c2527;--muted:#6f6265;--rule:#ded5d2;--sans:'Source Sans 3',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--paper);font-family:var(--sans);scroll-behavior:smooth}
