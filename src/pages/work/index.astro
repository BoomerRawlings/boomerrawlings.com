---
import CollectionIndex from '../../components/CollectionIndex.astro';
import { aiSkills, workflowDisplay } from '../../data/aiSkills';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects" description="Local-first software, research tools, reusable AI skills, learning systems, media infrastructure, and experimental worlds by Boomer Rawlings.">
  <CollectionIndex
    type="work"
    title="Projects"
    eyebrow="Selected work"
    introduction="Local-first software, research tools, reusable AI skills, learning systems, media infrastructure, and experimental worlds."
    guide={{
      messages: [
        "Welcome to Boomer's project room! Software, research tools, reusable AI skills, learning systems, and experimental worlds all meet here.",
        'The full projects document larger systems. The AI Skills shelf is smaller by design, with each entry linking directly to its public workflow on GitHub.',
        "Let's begin with Horizon, the desktop workspace that brings many of those interests together.",
      ],
      nextExhibit: { href: '/work/horizon/', label: 'Horizon' },
    }}
  >
    <section slot="before-listing" class="workflow-feature" id="workflow-display" aria-labelledby="workflow-display-heading">
      <div class="workflow-feature__intro">
        <p class="workflow-feature__eyebrow">Reusable skill &amp; starter</p>
        <h2 id="workflow-display-heading">Workflow Display</h2>
        <p>Show each step beside what it produces. Paired explanation and artifact cards stay connected through smooth transitions and animated paths.</p>
        <p>Bring your own workflow, typography, and colors.</p>
        <nav class="workflow-feature__links" aria-label="Workflow Display resources">
          <a class="workflow-feature__primary" href="/workflow-display/">Try the demo <span aria-hidden="true">↗</span></a>
          <a href="/downloads/workflow-display.zip" download>Download the kit</a>
          <a href={workflowDisplay.href} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
      <div class="workflow-feature__pair" aria-label="Each workflow step pairs its explanation with the artifact it produces.">
        <div class="workflow-feature__card">
          <span>01 / Explanation</span>
          <strong>Explain the step.</strong>
          <p>What happens, why it matters, and what comes next.</p>
        </div>
        <div class="workflow-feature__connection" aria-hidden="true"><span></span></div>
        <div class="workflow-feature__card">
          <span>01 / Artifact</span>
          <strong>Show the result.</strong>
          <p>The document, decision, code, or output that makes it concrete.</p>
        </div>
        <p class="workflow-feature__caption">One step. Two connected views.</p>
      </div>
      <div class="workflow-feature__start">
        <div>
          <h3>Build it yourself</h3>
          <p>Download the kit, follow the README, and replace the example content with your workflow.</p>
        </div>
        <div class="workflow-feature__agent">
          <h3>Give it to an agent</h3>
          <label class="sr-only" for="workflow-agent-prompt">Workflow Display agent prompt</label>
          <textarea id="workflow-agent-prompt" readonly rows="4" spellcheck="false">{workflowDisplay.agentPrompt}</textarea>
          <div class="workflow-feature__copy-row">
            <button type="button" id="copy-workflow-prompt" hidden>Copy agent prompt</button>
            <span id="workflow-copy-status" role="status"></span>
          </div>
        </div>
      </div>
    </section>
    <Fragment slot="after-listing">
      <section class="ai-skills" aria-labelledby="ai-skills-heading">
        <div class="ai-skills-heading">
          <h2 id="ai-skills-heading">AI Skills</h2>
          <p>Reusable Codex workflows.</p>
        </div>
        <ul class="ai-skills-list">
          {aiSkills.map((skill) => (
            <li>
              <a href={skill.href} target="_blank" rel="noopener noreferrer" aria-label={`View ${skill.name} on GitHub`}>
                <strong>{skill.name}</strong>
                <small>{skill.summary}</small>
                <span class="ai-skill-destination" aria-hidden="true">GitHub ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="browser-tool ai-skills" aria-labelledby="personal-search-router-heading">
        <div class="ai-skills-heading">
          <h2 id="personal-search-router-heading">Personal Search Router</h2>
          <p>Firefox add-on.</p>
        </div>
        <div class="browser-tool__body">
          <p>
            I made this small Firefox add-on for myself to streamline daily browsing. Short prefixes route address-bar searches to ChatGPT, Google, Perplexity, or OpenAlex, removing a tiny repeated decision from every search.
          </p>
          <p class="browser-tool__links">
            <a href="https://addons.mozilla.org/en-US/firefox/addon/personal-search-router/" target="_blank" rel="noopener noreferrer">Firefox Add-ons ↗</a>
            <a href="https://github.com/BoomerRawlings/personal-search-router" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </p>
        </div>
      </section>
    </Fragment>
  </CollectionIndex>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-workflow-prompt');
  const prompt = document.querySelector<HTMLTextAreaElement>('#workflow-agent-prompt');
  const status = document.querySelector<HTMLElement>('#workflow-copy-status');

  if (copyButton && prompt && status) {
    copyButton.hidden = false;
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt.value);
        status.textContent = 'Prompt copied.';
      } catch {
        prompt.focus();
        prompt.select();
        status.textContent = 'Prompt selected. Copy it with your keyboard or selection menu.';
      }
    });
  }
</script>

<style is:global>
  .workflow-feature {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    display: grid;
    gap: 2rem 3rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    padding: 3rem 5vw;
    scroll-margin-top: 2rem;
  }

  .workflow-feature__eyebrow,
  .workflow-feature__card > span,
  .workflow-feature__caption {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.035em;
    line-height: 1.5;
  }

  .workflow-feature__eyebrow { margin: 0 0 0.7rem; text-transform: uppercase; }
  .workflow-feature h2 { font-family: var(--display); font-size: 2.6rem; font-weight: 500; line-height: 1; margin: 0; }
  .workflow-feature__intro > p:not(.workflow-feature__eyebrow) { font-size: 1.1rem; line-height: 1.5; margin: 1rem 0; max-width: 36rem; }
  .workflow-feature__links { align-items: center; display: flex; flex-wrap: wrap; gap: 0.85rem 1.25rem; margin-top: 1.4rem; }
  .workflow-feature__links a { color: var(--blue); font-weight: 600; }
  .workflow-feature__links .workflow-feature__primary { background: var(--navy); color: var(--paper); padding: 0.65rem 0.9rem; text-decoration: none; }
  .workflow-feature__primary:hover { background: var(--blue); }

  .workflow-feature__pair { align-content: center; align-self: center; display: grid; grid-template-columns: minmax(0, 1fr) 2.5rem minmax(0, 1fr); }
  .workflow-feature__card { border: 1px solid var(--rule); border-radius: 0.65rem; min-width: 0; padding: 1.2rem; }
  .workflow-feature__card > span { display: block; }
  .workflow-feature__card strong { display: block; font-size: 1.25rem; font-weight: 600; line-height: 1.15; margin-top: 1rem; }
  .workflow-feature__card p { color: var(--muted); font-size: 0.95rem; line-height: 1.45; margin-bottom: 0; }
  .workflow-feature__connection { align-self: center; background: var(--muted); height: 1px; position: relative; }
  .workflow-feature__connection span { animation: workflow-connection 2.4s var(--ease-ui) 2 both; background: var(--navy); border-radius: 50%; height: 5px; left: 0; position: absolute; top: -2px; width: 5px; }
  .workflow-feature__caption { grid-column: 1 / -1; margin: 1rem 0 0; text-align: center; }
  @keyframes workflow-connection { 0%, 15% { left: 0; opacity: 0; } 25%, 75% { opacity: 1; } 85%, 100% { left: calc(100% - 5px); opacity: 0; } }

  .workflow-feature__start { border-top: 1px solid var(--rule); display: grid; gap: 2rem 3rem; grid-column: 1 / -1; grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr); padding-top: 1.6rem; }
  .workflow-feature__start h3 { font-size: 1.1rem; font-weight: 600; margin: 0 0 0.65rem; }
  .workflow-feature__start p { color: var(--muted); line-height: 1.5; margin: 0; max-width: 28rem; }
  .workflow-feature__agent { min-width: 0; }
  .workflow-feature textarea { background: var(--sand); border: 1px solid var(--rule); border-radius: 0.3rem; color: var(--ink); display: block; font-family: var(--mono); font-size: 0.76rem; line-height: 1.55; min-height: 9rem; padding: 0.85rem; resize: vertical; width: 100%; }
  .workflow-feature textarea:focus-visible,
  .workflow-feature button:focus-visible { outline: 3px solid var(--blue); outline-offset: 3px; }
  .workflow-feature__copy-row { align-items: center; display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; margin-top: 0.65rem; }
  .workflow-feature button { background: transparent; border: 1px solid var(--rule); border-radius: 0.25rem; color: var(--ink); cursor: pointer; font: inherit; font-size: 0.9rem; padding: 0.55rem 0.75rem; }
  .workflow-feature button:hover { background: var(--sand); }
  #workflow-copy-status { color: var(--muted); font-size: 0.9rem; }

  @media (max-width: 54rem) {
    .workflow-feature { grid-template-columns: minmax(0, 1fr); padding: 2.5rem 1.25rem; }
    .workflow-feature__pair { max-width: 36rem; width: 100%; }
    .workflow-feature__start { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 24rem) {
    .workflow-feature__pair { grid-template-columns: minmax(0, 1fr) 1.25rem minmax(0, 1fr); }
    .workflow-feature__card { padding: 0.85rem; }
    .workflow-feature__card strong { font-size: 1.1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .workflow-feature__connection span { animation: none; left: calc(50% - 2.5px); }
  }

  .browser-tool__body {
    align-self: start;
    max-width: 58rem;
  }

  .browser-tool__body > p:first-child {
    font-size: 1.05rem;
    line-height: 1.5;
    margin: 0;
  }

  .browser-tool__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem 1.25rem;
    margin: 1rem 0 0;
  }

  .browser-tool__links a {
    color: var(--blue);
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    text-underline-offset: 0.2em;
  }
</style>
