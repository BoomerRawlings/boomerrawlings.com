---
import CollectionIndex from '../../components/CollectionIndex.astro';
import { aiSkills } from '../../data/aiSkills';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects" description="Local-first software, research tools, reusable AI skills, learning systems, media infrastructure, and experimental worlds by Boomer Rawlings.">
  <CollectionIndex
    type="work"
    title="Projects"
    eyebrow="Selected work"
    introduction="Local-first software, research tools, reusable AI skills, learning systems, media infrastructure, and experimental worlds."
    guide={{
      messages: [
        "Welcome to Boomer's project room! Software, research tools, reusable AI skills, learning systems, and experimental worlds all meet here.",
        'The full projects document larger systems. The AI Skills shelf is smaller by design, with each entry linking directly to its public workflow on GitHub.',
        "Let's begin with Horizon, the desktop workspace that brings many of those interests together.",
      ],
      nextExhibit: { href: '/work/horizon/', label: 'Horizon' },
    }}
  >
    <section class="ai-skills" aria-labelledby="ai-skills-heading" slot="after-listing">
      <div class="ai-skills-heading">
        <h2 id="ai-skills-heading">AI Skills</h2>
        <p>Reusable Codex workflows.</p>
      </div>
      <ul class="ai-skills-list">
        {aiSkills.map((skill) => (
          <li>
            <a href={skill.href} target="_blank" rel="noopener noreferrer" aria-label={`View ${skill.name} on GitHub`}>
              <strong>{skill.name}</strong>
              <small>{skill.summary}</small>
              <span class="ai-skill-destination" aria-hidden="true">GitHub ↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </CollectionIndex>
</BaseLayout>
