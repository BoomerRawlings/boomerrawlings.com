---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/teko/latin-500.css';
import '@fontsource/teko/latin-600.css';
import LittleWorkshopScene from '../../components/LittleWorkshopScene.astro';

const title = 'The Little Workshop';
const description = 'A small private-by-link workshop for Bailey, Pyotter, and Mikwhale.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2a180e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#workshop-main">Skip to the workshop</a>
    <main id="workshop-main">
      <LittleWorkshopScene />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --workshop-sans: 'Source Sans 3', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --workshop-display: 'Teko', 'Arial Narrow', sans-serif;
    background: #f4ead6;
    font-family: var(--workshop-sans);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: #f4ead6;
    min-width: 20rem;
  }

  body {
    margin: 0;
    min-height: 100vh;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  .skip-link {
    background: #402718;
    border-radius: 0 0 0.5rem 0;
    color: #fff5dc;
    left: 0;
    padding: 0.7rem 1rem;
    position: fixed;
    top: 0;
    transform: translateY(-120%);
    transition: transform 120ms ease;
    z-index: 2000;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
