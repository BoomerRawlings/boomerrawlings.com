---
import { getCollection } from 'astro:content';
import CuratorGuide from '../../components/CuratorGuide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatFullDate, formatPartialDate, isoDate } from '../../lib/dates';

const entries = (await getCollection('archive', ({ data }) =>
  data.type === 'writing' && data.status === 'published' && data.writingKind === 'academic'
)).sort((a, b) => {
  if (!a.data.publishedDate && !b.data.publishedDate) {
    return a.data.title.localeCompare(b.data.title);
  }
  if (!a.data.publishedDate) return 1;
  if (!b.data.publishedDate) return -1;
  return b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
    || a.data.title.localeCompare(b.data.title);
});

---

<BaseLayout title="Writing" description="Selected academic writing by Boomer Rawlings.">
  <section class="page-intro page-intro--guided">
    <p class="eyebrow">Academic writing</p>
    <h1>Writing</h1>
    <p class="page-deck">
      Selected academic work, with publication and original production dates kept distinct. Personal essays continue on <a href="https://boomerrawlings.substack.com/">Substack</a>.
    </p>
    <CuratorGuide
      headingId="curator-writing"
      messages={[
        "This page brings together Boomer's academic writing on financial education, persuasion, and a proposed psychology study.",
        'Each paper keeps its original context, including when it was produced, what the assignment asked for, and a downloadable PDF.',
        "Let's begin with a May 2025 essay that pairs financial education with real accounts and practical experience.",
      ]}
      nextExhibit={{ href: '/writing/social-justice-through-financial-literacy/', label: 'Financial literacy essay' }}
    />
  </section>

  <div class="listing writing-listing">
    <section class="writing-group" aria-labelledby="writing-academic">
      <header class="writing-group-header">
        <h2 id="writing-academic">Academic writing</h2>
      </header>
      <ol>
        {entries.map((entry) => (
          <li>
            <a href={'/' + entry.data.type + '/' + entry.data.slug + '/'}>
              <strong>{entry.data.title}</strong>
              <span class="listing-detail">
                <small>{entry.data.description}</small>
                <span class="listing-meta">
                  {entry.data.writingForm && <span>{entry.data.writingForm}</span>}
                  {entry.data.venue && <span>{entry.data.venue}</span>}
                  {entry.data.publishedDate && (
                    <time datetime={isoDate(entry.data.publishedDate)}>
                      Published {formatFullDate(entry.data.publishedDate)}
                    </time>
                  )}
                  {entry.data.producedDate && (
                    <time datetime={entry.data.producedDate}>
                      Produced {formatPartialDate(entry.data.producedDate)}
                    </time>
                  )}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>
