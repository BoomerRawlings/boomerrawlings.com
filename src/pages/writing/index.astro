---
import { getCollection } from 'astro:content';
import CuratorGuide from '../../components/CuratorGuide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatFullDate, formatPartialDate, isoDate } from '../../lib/dates';

const entries = (await getCollection('archive', ({ data }) =>
  data.type === 'writing' && data.status === 'published'
)).sort((a, b) => {
  if (!a.data.publishedDate && !b.data.publishedDate) {
    return a.data.title.localeCompare(b.data.title);
  }
  if (!a.data.publishedDate) return 1;
  if (!b.data.publishedDate) return -1;
  return b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf()
    || a.data.title.localeCompare(b.data.title);
});

const groupedEntries = Object.entries(
  Object.groupBy(entries, (entry) => entry.data.writingKind ?? 'undesignated')
).sort(([firstKind], [secondKind]) => {
  const order = ['academic', 'personal', 'undesignated'];
  return order.indexOf(firstKind) - order.indexOf(secondKind);
});
---

<BaseLayout title="Writing" description="Personal and academic writing by Boomer Rawlings, published here and elsewhere.">
  <section class="page-intro page-intro--guided">
    <p class="eyebrow">Personal + academic</p>
    <h1>Writing</h1>
    <div class="page-deck">
      <p>Personal essays and academic work published here and elsewhere. Venue, publication date, and—when known—original production date remain distinct.</p>
      <a href="https://substack.com/@boomerrawlings/posts">Read the Substack</a>
    </div>
    <CuratorGuide
      headingId="curator-writing"
      messages={[
        'These nine pieces move from a formal psychology proposal to personal writing about attention, loneliness, home, doubt, and wonder.',
        'The essays often begin with one ordinary detail—a window, a tide, a quiet room—and follow it into a larger question.',
        'The ABM proposal shows the other register: evidence, experimental design, and limits stated plainly.',
      ]}
      nextExhibit={{ href: '/writing/attention-bias-modification-aggression/', label: 'ABM research proposal' }}
    />
  </section>

  <div class="listing writing-listing">
    {groupedEntries.map(([kind, kindEntries]) => (
      <section class="writing-group" aria-labelledby={`writing-${kind}`}>
        <header class="writing-group-header">
          <h2 id={`writing-${kind}`}>
            {kind === 'undesignated' ? 'Other writing' : kind[0].toUpperCase() + kind.slice(1) + ' writing'}
          </h2>
        </header>
        <ol>
          {kindEntries?.map((entry) => (
            <li>
              <a href={entry.data.externalUrl ?? '/' + entry.data.type + '/' + entry.data.slug + '/'}>
                <strong>{entry.data.title}</strong>
                <span class="listing-detail">
                  <small>{entry.data.description}</small>
                  <span class="listing-meta">
                    {entry.data.writingForm && <span>{entry.data.writingForm}</span>}
                    {entry.data.venue && <span>{entry.data.venue}</span>}
                    {entry.data.publishedDate && (
                      <time datetime={isoDate(entry.data.publishedDate)}>
                        Published {formatFullDate(entry.data.publishedDate)}
                      </time>
                    )}
                    {entry.data.producedDate && (
                      <time datetime={entry.data.producedDate}>
                        Produced {formatPartialDate(entry.data.producedDate)}
                      </time>
                    )}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
