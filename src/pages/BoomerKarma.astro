---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/teko/latin-500.css';
import '@fontsource/teko/latin-600.css';
import { boomerKarmaReport } from '../data/boomerKarma';

const title = 'BoomerKarma — an unofficial connection report';
const description = 'A playful, unverified connection score from the Bureau of Boomer’s Vibes.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'"
    />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive,noimageindex" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#182b49" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#report">Skip to your report</a>
    <main class="page-shell" id="report">
      <header class="topline">
        <a class="back-link" href="/" aria-label="Back to Boomer Rawlings home">
          <span aria-hidden="true">←</span> Boomer Rawlings
        </a>
        <p class="file-mark"><span aria-hidden="true">✳</span> BUREAU OF BOOMERKARMA</p>
      </header>

      <section class="report-card" aria-labelledby="report-title">
        <div class="report-topline">
          <p>UNOFFICIAL CONNECTION REPORT</p>
          <p class="report-number">FILE № 0001 <span aria-hidden="true">✦</span></p>
        </div>

        <div class="report-heading">
          <div>
            <p class="eyebrow">PREPARED ESPECIALLY FOR</p>
            <h1 id="report-title">{boomerKarmaReport.subject}</h1>
            <p class="report-subtitle">Your standing with the Bureau of Boomer’s Vibes</p>
          </div>
          <div class="not-real-stamp" aria-label="Completely unofficial and unverified">
            <span>COMPLETELY</span>
            <strong>UNVERIFIED</strong>
          </div>
        </div>

        <div class="score-panel">
          <div class="score-copy">
            <p class="score-label">CURRENT CONNECTION SCORE</p>
            <p class="score-reading">
              <span class="score-number">{boomerKarmaReport.score}</span>
              <span class="score-ish">{boomerKarmaReport.scoreQualifier}</span>
            </p>
            <p class="score-status">Officially pushing twenty.</p>
          </div>
          <div class="score-flower" aria-hidden="true">
            <span>✳</span>
            <small>ALL<br />VIBES</small>
          </div>
          <p class="score-disclaimer">A friendly number. Not a measurement of your worth, a bill, or an assignment.</p>
        </div>

        <section class="activity-section" aria-labelledby="activity-title">
          <div class="section-title-row">
            <div>
              <p class="eyebrow">LATEST KNOWN MOVEMENT</p>
              <h2 id="activity-title">Recent bureau activity</h2>
            </div>
            <span class="activity-tag">FILED BY BOOMER</span>
          </div>

          <article class="activity-entry">
            <div class="points-pill" aria-label="Plus two points">{boomerKarmaReport.recentActivity.points}</div>
            <div>
              <p class="activity-description">{boomerKarmaReport.recentActivity.description}</p>
              <p class="activity-source">Source: {boomerKarmaReport.recentActivity.source}</p>
            </div>
            <span class="activity-spark" aria-hidden="true">✦</span>
          </article>
          <p class="record-note">Earlier activity may exist. The paperwork is somewhere. Probably.</p>
        </section>

        <section class="bureau-section" aria-labelledby="bureau-title">
          <div class="section-title-row">
            <div>
              <p class="eyebrow">THREE BUREAUS. ONE GUY.</p>
              <h2 id="bureau-title">Your score’s source</h2>
            </div>
            <span class="independence-note">INDEPENDENT? NO.</span>
          </div>
          <ul class="bureau-list">
            {boomerKarmaReport.bureaus.map((bureau) => (
              <li class="bureau-card">
                <span class="bureau-number">{bureau.number}</span>
                <span class="bureau-name">{bureau.name}</span>
                <span class="bureau-note">{bureau.note}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="mystery-panel" aria-labelledby="mystery-title">
          <div class="mystery-icon" aria-hidden="true">?</div>
          <div>
            <p class="eyebrow">THE METHODOLOGY</p>
            <h2 id="mystery-title">Classified. Allegedly.</h2>
            <p>Points may appear after excellent conversations, thesis support, or other undisclosed vibes. No hard inquiries. No actual credit. No appeals court.</p>
          </div>
        </section>

        <div class="report-actions">
          <button class="refresh-button" type="button" id="refresh-report">
            <span aria-hidden="true">↻</span> Pull the report again
          </button>
          <p id="refresh-message" class="refresh-message" aria-live="polite">The bureau is open whenever Boomer checks his notes.</p>
        </div>
      </section>

      <footer class="page-footer">
        <p>Made for a friend. Powered by affection and unverified arithmetic.</p>
        <p>Zero action required. Please continue being yourself.</p>
      </footer>
    </main>
    <script is:inline type="module" src="/scripts/boomer-karma.js"></script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --karma-navy: #182b49;
    --karma-blue: #00629b;
    --karma-sky: #dff6ff;
    --karma-turquoise: #00c6d7;
    --karma-yellow: #ffcd00;
    --karma-sand: #f5f0e6;
    --karma-paper: #fffdf8;
    --karma-ink: #182b49;
    --karma-muted: #5c6877;
    background: var(--karma-sand);
    color: var(--karma-ink);
    font-family: 'Source Sans 3', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  * { box-sizing: border-box; }

  html {
    background-color: var(--karma-sand);
    background-image: radial-gradient(rgb(24 43 73 / 7%) 0.7px, transparent 0.7px);
    background-size: 14px 14px;
    min-width: 20rem;
    scroll-behavior: smooth;
  }

  body { margin: 0; min-height: 100vh; }
  p, h1, h2 { margin-top: 0; }
  a { color: inherit; }
  button { font: inherit; }

  .skip-link {
    background: var(--karma-navy);
    border-radius: 0 0 .5rem 0;
    color: white;
    left: 0;
    padding: .75rem 1rem;
    position: fixed;
    top: 0;
    transform: translateY(-120%);
    transition: transform 140ms ease;
    z-index: 10;
  }
  .skip-link:focus { transform: translateY(0); }

  .page-shell { margin: 0 auto; max-width: 68rem; padding: 1.1rem 1.25rem 2.25rem; }
  .topline { align-items: center; display: flex; justify-content: space-between; margin-bottom: 1rem; }
  .back-link { color: var(--karma-muted); font-size: .92rem; font-weight: 600; text-decoration: none; text-underline-offset: .2em; }
  .back-link span { color: var(--karma-blue); font-size: 1.2rem; margin-right: .3rem; }
  .back-link:hover { color: var(--karma-blue); text-decoration: underline; }
  .file-mark { color: var(--karma-navy); font-size: .72rem; font-weight: 700; letter-spacing: .1em; margin: 0; }
  .file-mark span { color: #a16a00; font-size: 1rem; margin-right: .25rem; }

  .report-card { background: var(--karma-paper); border: 1px solid rgb(24 43 73 / 22%); border-radius: 1.4rem; box-shadow: 0 .8rem 2rem rgb(24 43 73 / 9%); overflow: hidden; }
  .report-topline { align-items: center; background: var(--karma-navy); color: white; display: flex; justify-content: space-between; padding: .8rem clamp(1.1rem, 4vw, 2.3rem); }
  .report-topline p { font-size: .72rem; font-weight: 700; letter-spacing: .13em; margin: 0; }
  .report-number { color: rgb(255 255 255 / 72%); font-variant-numeric: tabular-nums; }
  .report-number span { color: var(--karma-yellow); margin-left: .35rem; }
  .report-heading { align-items: center; display: flex; gap: 1rem; justify-content: space-between; padding: clamp(1.5rem, 4vw, 2.4rem) clamp(1.1rem, 4vw, 2.3rem) 1.25rem; }
  .eyebrow { color: var(--karma-blue); font-size: .71rem; font-weight: 700; letter-spacing: .14em; margin: 0 0 .45rem; }
  h1, h2 { color: var(--karma-navy); }
  h1 { font-family: 'Teko', 'Arial Narrow', sans-serif; font-size: clamp(3rem, 8vw, 5rem); font-weight: 600; letter-spacing: -.025em; line-height: .92; margin: 0; }
  .report-subtitle { color: var(--karma-muted); font-size: 1.05rem; margin: .4rem 0 0; }
  .not-real-stamp { align-items: center; border: 2px solid #a43d44; border-radius: 50%; color: #a43d44; display: flex; flex: 0 0 7.1rem; flex-direction: column; height: 7.1rem; justify-content: center; line-height: 1.05; text-align: center; transform: rotate(8deg); }
  .not-real-stamp span { font-size: .57rem; font-weight: 700; letter-spacing: .08em; }
  .not-real-stamp strong { font-size: .8rem; letter-spacing: .05em; margin-top: .15rem; }

  .score-panel { align-items: center; background: var(--karma-navy); border-radius: 1rem; color: white; display: grid; gap: .6rem 1rem; grid-template-columns: minmax(0, 1fr) auto; margin: 0 clamp(1.1rem, 4vw, 2.3rem); padding: clamp(1.1rem, 4vw, 1.75rem); position: relative; }
  .score-label { color: var(--karma-turquoise); font-size: .73rem; font-weight: 700; letter-spacing: .13em; margin: 0; }
  .score-reading { align-items: baseline; display: flex; gap: .35rem; margin: -.15rem 0 -.5rem; }
  .score-number { color: var(--karma-paper); font-family: 'Teko', 'Arial Narrow', sans-serif; font-size: clamp(6rem, 16vw, 9rem); font-variant-numeric: tabular-nums; font-weight: 600; letter-spacing: -.03em; line-height: .9; }
  .score-ish { color: var(--karma-yellow); font-family: 'Teko', 'Arial Narrow', sans-serif; font-size: clamp(2.6rem, 7vw, 4rem); line-height: 1; }
  .score-status { color: white; font-size: 1.05rem; font-weight: 600; margin: .55rem 0 0; }
  .score-flower { align-items: center; background: var(--karma-turquoise); border: .3rem solid rgb(255 255 255 / 15%); border-radius: 50%; color: var(--karma-navy); display: flex; flex-direction: column; height: clamp(6rem, 20vw, 8.5rem); justify-content: center; width: clamp(6rem, 20vw, 8.5rem); }
  .score-flower span { font-size: 2rem; line-height: 1; }
  .score-flower small { font-size: .6rem; font-weight: 800; letter-spacing: .1em; line-height: 1.05; margin-top: .35rem; text-align: center; }
  .score-disclaimer { border-top: 1px dashed rgb(255 255 255 / 35%); color: rgb(255 255 255 / 78%); font-size: .84rem; grid-column: 1 / -1; line-height: 1.4; margin: .5rem 0 0; padding-top: .7rem; }

  .activity-section, .bureau-section { padding: 1.8rem clamp(1.1rem, 4vw, 2.3rem) 0; }
  .section-title-row { align-items: end; display: flex; gap: .8rem; justify-content: space-between; margin-bottom: .85rem; }
  .section-title-row h2 { font-family: 'Teko', 'Arial Narrow', sans-serif; font-size: 2rem; font-weight: 600; letter-spacing: -.015em; line-height: 1; margin: 0; }
  .activity-tag, .independence-note { border: 1px solid rgb(0 98 155 / 25%); border-radius: 999px; color: var(--karma-blue); flex: 0 0 auto; font-size: .61rem; font-weight: 700; letter-spacing: .08em; padding: .35rem .58rem; }
  .activity-entry { align-items: center; background: #f4fbff; border: 1px solid rgb(0 98 155 / 16%); border-radius: .85rem; display: grid; gap: 1rem; grid-template-columns: auto minmax(0, 1fr) auto; padding: 1rem; }
  .points-pill { align-items: center; background: #34a9ed; border-radius: 999px; color: white; display: flex; font-family: 'Teko', sans-serif; font-size: 1.8rem; font-weight: 600; height: 3.2rem; justify-content: center; min-width: 3.6rem; padding: 0 .75rem; }
  .activity-description { color: var(--karma-navy); font-size: 1rem; font-weight: 600; line-height: 1.4; margin: 0; }
  .activity-source { color: var(--karma-muted); font-size: .8rem; margin: .28rem 0 0; }
  .activity-spark { color: #a16a00; font-size: 1.5rem; }
  .record-note { color: var(--karma-muted); font-size: .82rem; font-style: italic; margin: .55rem 0 0; }

  .bureau-list { display: grid; gap: .55rem; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .bureau-card { align-items: start; background: var(--karma-sand); border: 1px solid rgb(24 43 73 / 11%); border-radius: .7rem; display: grid; grid-template-columns: 2rem minmax(0, 1fr); min-height: 4.4rem; padding: .7rem .8rem; }
  .bureau-number { color: var(--karma-blue); font-size: .68rem; font-weight: 700; grid-row: span 2; letter-spacing: .08em; padding-top: .18rem; }
  .bureau-name { color: var(--karma-navy); font-weight: 700; line-height: 1.2; }
  .bureau-note { color: var(--karma-muted); font-size: .75rem; line-height: 1.35; margin-top: .12rem; }

  .mystery-panel { align-items: start; background: #fff9dc; border-left: .28rem solid var(--karma-yellow); display: grid; gap: .85rem; grid-template-columns: 2.4rem minmax(0, 1fr); margin: 1.6rem clamp(1.1rem, 4vw, 2.3rem) 0; padding: 1rem 1.1rem; }
  .mystery-icon { align-items: center; border: 1px solid var(--karma-navy); border-radius: 50%; display: flex; font-family: 'Teko', sans-serif; font-size: 1.7rem; height: 2.1rem; justify-content: center; line-height: 1; width: 2.1rem; }
  .mystery-panel h2 { font-family: 'Teko', 'Arial Narrow', sans-serif; font-size: 1.75rem; line-height: 1; margin: 0 0 .25rem; }
  .mystery-panel p:last-child { color: #49556a; font-size: .9rem; line-height: 1.48; margin: 0; max-width: 48rem; }
  .report-actions { align-items: center; display: flex; flex-wrap: wrap; gap: .8rem 1rem; justify-content: space-between; padding: 1.35rem clamp(1.1rem, 4vw, 2.3rem) 1.6rem; }
  .refresh-button { background: var(--karma-blue); border: 2px solid var(--karma-blue); border-radius: .55rem; color: white; cursor: pointer; font-size: .95rem; font-weight: 700; min-height: 46px; padding: .65rem .95rem; transition: background 140ms ease, transform 140ms ease; }
  .refresh-button span { font-size: 1.2rem; margin-right: .3rem; }
  .refresh-button:hover { background: var(--karma-navy); border-color: var(--karma-navy); transform: translateY(-1px); }
  .refresh-message { color: var(--karma-muted); font-size: .84rem; line-height: 1.35; margin: 0; }
  .page-footer { color: var(--karma-muted); display: flex; font-size: .78rem; gap: .2rem 1rem; justify-content: space-between; margin: .9rem .25rem 0; }
  .page-footer p { margin: 0; }
  :focus-visible { outline: 3px solid #a16a00; outline-offset: 3px; }

  @media (max-width: 40rem) {
    .page-shell { padding: .8rem .7rem 1.4rem; }
    .topline { align-items: start; gap: .5rem; }
    .file-mark { font-size: .58rem; text-align: right; }
    .report-card { border-radius: 1rem; }
    .report-topline { align-items: start; gap: .4rem; }
    .report-topline p { font-size: .62rem; }
    .report-heading { align-items: start; }
    .report-subtitle { font-size: .92rem; max-width: 24ch; }
    .not-real-stamp { flex-basis: 5.3rem; height: 5.3rem; }
    .not-real-stamp span { font-size: .45rem; }
    .not-real-stamp strong { font-size: .62rem; }
    .score-panel { gap: .25rem; }
    .score-label { font-size: .65rem; }
    .score-status { font-size: .92rem; }
    .section-title-row { align-items: start; }
    .activity-tag, .independence-note { font-size: .52rem; padding: .3rem .42rem; }
    .activity-entry { gap: .7rem; grid-template-columns: auto minmax(0, 1fr); }
    .activity-spark { display: none; }
    .bureau-list { grid-template-columns: minmax(0, 1fr); }
    .bureau-card { align-items: center; grid-template-columns: 2rem minmax(0, 1fr) auto; min-height: 0; }
    .bureau-number { grid-row: auto; }
    .bureau-note { margin: 0; text-align: right; }
    .report-actions { align-items: stretch; flex-direction: column; }
    .refresh-button { width: 100%; }
    .page-footer { flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
  }
</style>
