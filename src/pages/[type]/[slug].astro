---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('archive', ({ data }) => data.status === 'published');
  return entries.map((entry) => ({
    params: { type: entry.data.type, slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'archive'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <header class="entry-header">
    <p class="eyebrow">{entry.data.type}</p>
    <div>
      <h1>{entry.data.title}</h1>
      <p class="entry-description">{entry.data.description}</p>
    </div>
  </header>
  <article class="entry-body">
    <Content />
  </article>
</BaseLayout>
