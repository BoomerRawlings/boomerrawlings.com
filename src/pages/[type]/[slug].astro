---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CuratorGuide from '../../components/CuratorGuide.astro';
import DocumentViewer from '../../components/DocumentViewer.astro';
import EvidenceFigure from '../../components/EvidenceFigure.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatFullDate, formatPartialDate, isoDate } from '../../lib/dates';

export async function getStaticPaths() {
  const entries = await getCollection('archive', ({ data }) =>
    data.status === 'published' && !data.externalUrl
  );
  return entries.map((entry) => ({
    params: { type: entry.data.type, slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'archive'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const visualEvidence = entry.data.visualEvidence ?? [];
const heroEvidence = visualEvidence.find(({ role }) => role === 'hero');
const processEvidence = visualEvidence.filter(({ role }) => role === 'process');
const proofEvidence = visualEvidence.filter(({ role }) => role === 'proof');
const hasSupportingEvidence = processEvidence.length > 0 || proofEvidence.length > 0;
const isWriting = entry.data.type === 'writing';
const canonical = new URL(`/${entry.data.type}/${entry.data.slug}/`, Astro.site).toString();
const personId = new URL('/#person', Astro.site).toString();
const websiteId = new URL('/#website', Astro.site).toString();
const pageId = `${canonical}#webpage`;
const metaTitles = new Map([
  ['horizon', 'Horizon Local-First Research Workspace'],
  ['paperfield', 'Paperfield Spatial Research Desk'],
  ['pocketllm', 'pocketLLM Local Pseudonymization Tool'],
  ['continuity-desk', 'Continuity Desk Editorial System'],
  ['research-publishing-systems', 'Research and Publishing Systems'],
  ['research-briefing-assistant', 'Research Briefing Assistant WIP'],
  ['organizing-icloud-media', 'iCloud Media Migration and Catalog'],
  ['interactive-systems', 'The Unrendered World and Small Projects'],
  ['social-justice-through-financial-literacy', 'Financial Literacy and Social Justice'],
  ['rhetorical-analysis-death-penalty', 'Death Penalty Rhetorical Analysis'],
  ['attention-bias-modification-aggression', 'Attention Bias Modification Study'],
  ['self-inflicted-pain-error-correction', 'Self-Inflicted Pain Error Correction Proposal'],
  ['the-age-of-curation', 'The Age of Curation Essay'],
]);
const representativeEvidence = visualEvidence.find((visual) => (
  visual.kind === 'video' || !visual.src.endsWith('.svg')
));
const representativeImageSource = representativeEvidence
  ? representativeEvidence.kind === 'video'
    ? representativeEvidence.poster
    : representativeEvidence.src
  : undefined;
const representativeImage = representativeImageSource
  ? new URL(representativeImageSource, Astro.site).toString()
  : undefined;
const socialEvidence = visualEvidence.find((visual) => {
  const width = visual.kind === 'video' ? visual.posterWidth : visual.width;
  const height = visual.kind === 'video' ? visual.posterHeight : visual.height;
  const source = visual.kind === 'video' ? visual.poster : visual.src;
  const aspectRatio = width / height;
  return aspectRatio >= 1.4
    && aspectRatio <= 2.2
    && !source.endsWith('.svg');
});
const socialImageSource = socialEvidence
  ? socialEvidence.kind === 'video'
    ? socialEvidence.poster
    : socialEvidence.src
  : undefined;
const socialImageType = socialImageSource?.endsWith('.png')
  ? 'image/png'
  : socialImageSource?.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
const socialImage = socialEvidence && socialImageSource
  ? {
      src: socialImageSource,
      alt: socialEvidence.alt,
      width: socialEvidence.kind === 'video' ? socialEvidence.posterWidth : socialEvidence.width,
      height: socialEvidence.kind === 'video' ? socialEvidence.posterHeight : socialEvidence.height,
      type: socialImageType,
    }
  : undefined;
const dateCreated = isWriting
  ? entry.data.producedDate
  : entry.data.date?.toISOString().slice(0, 7);
const contentSchema = isWriting
  ? {
      '@type': entry.data.writingKind === 'academic'
        ? ['Article', 'ScholarlyArticle']
        : 'Article',
      '@id': `${canonical}#article`,
      headline: entry.data.title,
      name: entry.data.title,
      description: entry.data.description,
      url: canonical,
      mainEntityOfPage: { '@id': pageId },
      author: { '@id': personId },
      inLanguage: 'en-US',
      datePublished: entry.data.publishedDate ? isoDate(entry.data.publishedDate) : undefined,
      dateCreated,
      keywords: entry.data.tags,
      isAccessibleForFree: true,
      encoding: entry.data.document
        ? {
            '@type': 'MediaObject',
            name: `${entry.data.title} PDF`,
            contentUrl: new URL(entry.data.document.src, Astro.site).toString(),
            encodingFormat: 'application/pdf',
          }
        : undefined,
      isPartOf: { '@id': websiteId },
    }
  : {
      '@type': 'CreativeWork',
      '@id': `${canonical}#project`,
      name: entry.data.title,
      description: entry.data.description,
      url: canonical,
      mainEntityOfPage: { '@id': pageId },
      creator: { '@id': personId },
      creativeWorkStatus: entry.data.projectStage,
      inLanguage: 'en-US',
      dateCreated,
      image: representativeImage,
      keywords: entry.data.tags,
      encoding: entry.data.document
        ? {
            '@type': 'MediaObject',
            name: `${entry.data.title} sample PDF`,
            contentUrl: new URL(entry.data.document.src, Astro.site).toString(),
            encodingFormat: 'application/pdf',
          }
        : undefined,
      isPartOf: { '@id': websiteId },
    };
const sectionName = entry.data.type === 'work'
  ? 'Projects'
  : entry.data.type === 'writing'
    ? 'Writing'
    : entry.data.type;
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: sectionName,
      item: new URL(`/${entry.data.type}/`, Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: entry.data.title,
      item: canonical,
    },
  ],
};
const eyebrow = isWriting && entry.data.writingKind
  ? `${entry.data.writingKind} writing`
  : entry.data.type === 'work'
    ? 'Project'
    : entry.data.type;
const isExternalVenue = (venue?: string) =>
  Boolean(venue && venue.toLowerCase() !== 'boomerrawlings.com');
---

<BaseLayout
  title={entry.data.title}
  metaTitle={metaTitles.get(entry.data.slug)}
  description={entry.data.description}
  image={socialImage}
  pageType={isWriting ? 'article' : 'website'}
  publishedTime={entry.data.publishedDate ? isoDate(entry.data.publishedDate) : undefined}
  structuredData={[contentSchema, breadcrumbSchema]}
>
  <header class:list={['entry-header', { 'entry-header--guided': entry.data.curatorNotes }]}>
    <p class="eyebrow">{eyebrow}</p>
    <div>
      <h1>{entry.data.title}</h1>
      <p class="entry-description">{entry.data.description}</p>
      {(isWriting || entry.data.projectStage) && (
        <div class="entry-meta">
          {entry.data.projectStage && <span>{entry.data.projectStage}</span>}
          {isWriting && <span>By <a href="/about/" rel="author">Boomer Rawlings</a></span>}
          {isWriting && entry.data.writingForm && <span>{entry.data.writingForm}</span>}
          {isWriting && isExternalVenue(entry.data.venue) && <span>{entry.data.venue}</span>}
          {isWriting && entry.data.publishedDate && (
            <time datetime={isoDate(entry.data.publishedDate)}>
              Published {formatFullDate(entry.data.publishedDate)}
            </time>
          )}
          {isWriting && entry.data.producedDate && (
            <time datetime={entry.data.producedDate}>
              Produced {formatPartialDate(entry.data.producedDate)}
            </time>
          )}
        </div>
      )}
    </div>
    {entry.data.curatorNotes && (
      <CuratorGuide
        headingId="curator-entry"
        messages={entry.data.curatorNotes}
        nextExhibit={entry.data.nextExhibit}
      />
    )}
  </header>
  {heroEvidence && (
    <div class="entry-evidence entry-evidence--hero">
      <div class="entry-evidence-inner">
        <EvidenceFigure entrySlug={entry.data.slug} {...heroEvidence} />
      </div>
    </div>
  )}
  {processEvidence.length > 0 && (
    <section class="entry-evidence entry-evidence--process" aria-labelledby={`${entry.data.slug}-process-evidence`}>
      <div class="entry-evidence-inner">
        <h2 id={`${entry.data.slug}-process-evidence`} class="entry-evidence-heading">How it works</h2>
        <div class="entry-evidence-grid">
          {processEvidence.map((visual) => (
            <EvidenceFigure entrySlug={entry.data.slug} {...visual} />
          ))}
        </div>
      </div>
    </section>
  )}
  <article class:list={[
    'entry-body',
    {
      'academic-entry': entry.data.writingKind === 'academic',
      'entry-body--with-evidence': hasSupportingEvidence,
      'entry-body--with-document': Boolean(entry.data.document),
    },
  ]}>
    <Content />
  </article>
  {entry.data.document && (
    <DocumentViewer
      src={entry.data.document.src}
      title={entry.data.title}
      pages={entry.data.document.pages}
      label={entry.data.document.label}
    />
  )}
  {proofEvidence.length > 0 && (
    <section class="entry-evidence entry-evidence--supporting" aria-labelledby={`${entry.data.slug}-visual-evidence`}>
      <div class="entry-evidence-inner">
        <h2 id={`${entry.data.slug}-visual-evidence`} class="entry-evidence-heading">Inside the project</h2>
        <div class="entry-evidence-grid">
          {proofEvidence.map((visual) => (
            <EvidenceFigure entrySlug={entry.data.slug} {...visual} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
