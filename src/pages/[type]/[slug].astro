---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import CuratorGuide from '../../components/CuratorGuide.astro';
import DocumentViewer from '../../components/DocumentViewer.astro';
import EvidenceFigure from '../../components/EvidenceFigure.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatFullDate, formatPartialDate, isoDate } from '../../lib/dates';

export async function getStaticPaths() {
  const entries = await getCollection('archive', ({ data }) =>
    data.status === 'published' && !data.externalUrl
  );
  return entries.map((entry) => ({
    params: { type: entry.data.type, slug: entry.data.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'archive'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const visualEvidence = entry.data.visualEvidence ?? [];
const heroEvidence = visualEvidence.find(({ role }) => role === 'hero');
const processEvidence = visualEvidence.filter(({ role }) => role === 'process');
const proofEvidence = visualEvidence.filter(({ role }) => role === 'proof');
const hasSupportingEvidence = processEvidence.length > 0 || proofEvidence.length > 0;
const isWriting = entry.data.type === 'writing';
const eyebrow = isWriting && entry.data.writingKind
  ? `${entry.data.writingKind} writing`
  : entry.data.type === 'work'
    ? 'Project'
    : entry.data.type;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <header class:list={['entry-header', { 'entry-header--guided': entry.data.curatorNotes }]}>
    <p class="eyebrow">{eyebrow}</p>
    <div>
      <h1>{entry.data.title}</h1>
      <p class="entry-description">{entry.data.description}</p>
      {isWriting && (
        <div class="entry-meta">
          {entry.data.writingForm && <span>{entry.data.writingForm}</span>}
          {entry.data.venue && <span>{entry.data.venue}</span>}
          {entry.data.publishedDate && (
            <time datetime={isoDate(entry.data.publishedDate)}>
              Published {formatFullDate(entry.data.publishedDate)}
            </time>
          )}
          {entry.data.producedDate && (
            <time datetime={entry.data.producedDate}>
              Produced {formatPartialDate(entry.data.producedDate)}
            </time>
          )}
        </div>
      )}
    </div>
    {entry.data.curatorNotes && (
      <CuratorGuide
        headingId="curator-entry"
        messages={entry.data.curatorNotes}
        nextExhibit={entry.data.nextExhibit}
      />
    )}
  </header>
  {heroEvidence && (
    <div class="entry-evidence entry-evidence--hero">
      <div class="entry-evidence-inner">
        <EvidenceFigure entrySlug={entry.data.slug} {...heroEvidence} />
      </div>
    </div>
  )}
  {processEvidence.length > 0 && (
    <section class="entry-evidence entry-evidence--process" aria-labelledby={`${entry.data.slug}-process-evidence`}>
      <div class="entry-evidence-inner">
        <h2 id={`${entry.data.slug}-process-evidence`} class="entry-evidence-heading">How it works</h2>
        <div class="entry-evidence-grid">
          {processEvidence.map((visual) => (
            <EvidenceFigure entrySlug={entry.data.slug} {...visual} />
          ))}
        </div>
      </div>
    </section>
  )}
  <article class:list={[
    'entry-body',
    {
      'academic-entry': entry.data.writingKind === 'academic',
      'entry-body--with-evidence': hasSupportingEvidence,
      'entry-body--with-document': Boolean(entry.data.document),
    },
  ]}>
    <Content />
  </article>
  {entry.data.document && (
    <DocumentViewer
      src={entry.data.document.src}
      title={entry.data.title}
      pages={entry.data.document.pages}
    />
  )}
  {proofEvidence.length > 0 && (
    <section class="entry-evidence entry-evidence--supporting" aria-labelledby={`${entry.data.slug}-visual-evidence`}>
      <div class="entry-evidence-inner">
        <h2 id={`${entry.data.slug}-visual-evidence`} class="entry-evidence-heading">Inside the project</h2>
        <div class="entry-evidence-grid">
          {proofEvidence.map((visual) => (
            <EvidenceFigure entrySlug={entry.data.slug} {...visual} />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
