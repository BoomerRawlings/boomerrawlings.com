---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Boomer Rawlings',
  description = 'Psychology, research, experimental software, writing, and photography by Boomer Rawlings.',
} = Astro.props;

const pageTitle = title === 'Boomer Rawlings' ? title : title + ' — Boomer Rawlings';
const canonical = new URL(Astro.url.pathname, Astro.site);
const navItems = [
  ['Work', '/work/'],
  ['Research', '/research/'],
  ['Writing', '/writing/'],
  ['Photography', '/photography/'],
  ['About', '/about/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f0e6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Boomer Rawlings, home">
        <span class="wordmark-mark" aria-hidden="true">BR</span>
        <span>Boomer Rawlings</span>
      </a>
      <nav aria-label="Primary navigation">
        <ul>
          {navItems.map(([label, href]) => (
            <li><a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Psychology · Research · Experimental Software</p>
      <p><a href="/archive/">Archive</a> <span aria-hidden="true">/</span> © {new Date().getFullYear()} Boomer Rawlings</p>
    </footer>
  </body>
</html>
