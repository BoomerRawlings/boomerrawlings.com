---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-400-italic.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/teko/latin-500.css';
import '@fontsource/teko/latin-600.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Boomer Rawlings',
  description = 'Psychology, research, experimental software, writing, and photography by Boomer Rawlings.',
} = Astro.props;

const pageTitle = title === 'Boomer Rawlings' ? title : title + ' — Boomer Rawlings';
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
const navItems = [
  ['Projects', '/work/'],
  ['All Work', '/all/'],
  ['About', '/about/'],
];

const isCurrent = (href: string) =>
  href === '/work/'
    ? Astro.url.pathname.startsWith('/work/')
    : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#182b49" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'home-page': isHome }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'site-header--home': isHome }]}>
      <a class="wordmark" href="/" aria-label="Boomer Rawlings, home">
        <span class="wordmark-name">Boomer Rawlings</span>
        <span class="wordmark-description">Portfolio</span>
      </a>
      <nav aria-label="Primary navigation">
        <ul>
          {navItems.map(([label, href]) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
                {isCurrent(href) && <span class="nav-indicator" aria-hidden="true"></span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Boomer Rawlings</p>
      <p>
        <a href="mailto:boomerrawlings@gmail.com">boomerrawlings@gmail.com</a><br />
        <a href="mailto:boomer@boomerrawlings.com">boomer@boomerrawlings.com</a>
      </p>
      <p><a href="/">boomerrawlings.com</a></p>
    </footer>
  </body>
</html>
