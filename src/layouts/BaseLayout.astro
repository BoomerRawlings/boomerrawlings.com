---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-400-italic.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/teko/latin-500.css';
import '@fontsource/teko/latin-600.css';
import '../styles/global.css';

interface SeoImage {
  src: string;
  alt: string;
  width: number;
  height: number;
  type?: string;
}

interface Props {
  title?: string;
  metaTitle?: string;
  description?: string;
  image?: SeoImage;
  pageType?: 'website' | 'profile' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  publishedTime?: string;
}

const siteName = 'Boomer Rawlings';
const siteDescription = 'Portfolio of Boomer Rawlings: psychology, local-first software, research systems, academic writing, and visual work.';
const siteUrl = new URL('/', Astro.site).toString();
const personId = new URL('/#person', Astro.site).toString();
const websiteId = new URL('/#website', Astro.site).toString();
const profileId = new URL('/about/#profile', Astro.site).toString();
const defaultImage: SeoImage = {
  src: '/images/boomer-rawlings-social.jpg',
  alt: 'Boomer Rawlings, psychology, research, and software portfolio.',
  width: 1200,
  height: 630,
  type: 'image/jpeg',
};

const {
  title = siteName,
  metaTitle,
  description = siteDescription,
  image = defaultImage,
  pageType = 'website',
  structuredData = [],
  noindex = false,
  publishedTime,
} = Astro.props;

const titleBase = metaTitle ?? title;
const pageTitle = titleBase === siteName ? titleBase : `${titleBase} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const socialImage = new URL(image.src, Astro.site).toString();
const isHome = Astro.url.pathname === '/';
const isAbout = Astro.url.pathname === '/about/';
const pageId = `${canonical}#webpage`;
const personSchema = {
  '@type': 'Person',
  '@id': personId,
  name: siteName,
  url: siteUrl,
  mainEntityOfPage: { '@id': profileId },
  image: {
    '@type': 'ImageObject',
    url: new URL('/images/boomer-rawlings-headshot.webp', Astro.site).toString(),
    width: 900,
    height: 1350,
    caption: 'Boomer Rawlings',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Southwestern College',
    url: 'https://www.swccd.edu/',
  },
  knowsAbout: [
    'Psychology',
    'Research methods',
    'Local-first software',
    'Academic writing',
  ],
  sameAs: [
    'https://www.linkedin.com/in/boomerrawlings/',
    'https://github.com/BoomerRawlings',
    'https://orcid.org/0009-0000-5843-5750',
    'https://boomerrawlings.substack.com/',
  ],
};
const websiteSchema = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: siteName,
  alternateName: 'boomerrawlings.com',
  url: siteUrl,
  description: siteDescription,
  inLanguage: 'en-US',
  author: { '@id': personId },
};
const pageSchema = {
  '@type': isAbout || pageType === 'profile' ? 'ProfilePage' : 'WebPage',
  '@id': isAbout ? profileId : pageId,
  url: canonical,
  name: pageTitle,
  description,
  inLanguage: 'en-US',
  isPartOf: { '@id': websiteId },
  ...(isAbout || pageType === 'profile'
    ? { mainEntity: { '@id': personId } }
    : { author: { '@id': personId } }),
};
const additionalSchema = Array.isArray(structuredData) ? structuredData : [structuredData];
const schemaGraph = [websiteSchema, personSchema, pageSchema, ...additionalSchema];
const navItems = [
  ['Academics', '/cv/'],
  ['Writing', '/writing/'],
  ['Projects', '/work/'],
  ['All Work', '/all/'],
  ['About', '/about/'],
];

const isCurrent = (href: string) =>
  href === '/work/'
    ? Astro.url.pathname.startsWith('/work/')
    : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description} />
    <meta name="author" content={siteName} />
    <meta
      name="robots"
      content={noindex
        ? 'noindex,follow'
        : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
    />
    <meta name="application-name" content={siteName} />
    <meta name="theme-color" content="#182b49" />
    <meta property="og:type" content={pageType === 'article' ? 'article' : pageType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={image.type ?? 'image/jpeg'} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    {pageType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    {pageType === 'article' && <meta property="article:author" content={new URL('/about/', Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={image.alt} />
    <link rel="canonical" href={canonical} />
    <link rel="author" href="/about/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph })}></script>
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'home-page': isHome }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'site-header--home': isHome }]}>
      <a class="wordmark" href="/" aria-label="Boomer Rawlings, home">
        <span class="wordmark-name">Boomer Rawlings</span>
        <span class="wordmark-description">Portfolio</span>
      </a>
      <nav aria-label="Primary navigation">
        <ul>
          {navItems.map(([label, href]) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
                {label}
                {isCurrent(href) && <span class="nav-indicator" aria-hidden="true"></span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Boomer Rawlings</p>
      <div class="footer-contact">
        <p class="footer-email">
          <a href="mailto:boomerrawlings@gmail.com" aria-label="Email Boomer Rawlings">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 4H4a2 2 0 0 0-2 2v12c0 1.1.9 2 2 2h16a2 2 0 0 0 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5-8-5V6l8 5 8-5v2Z" />
            </svg>
            <span>Email</span>
          </a>
        </p>
        <ul class="footer-social" aria-label="Professional profiles">
          <li>
            <a href="https://www.linkedin.com/in/boomerrawlings/" target="_blank" rel="me noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45Z" />
              </svg>
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a href="https://github.com/BoomerRawlings" target="_blank" rel="me noopener noreferrer">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .3a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.24c-3.34.73-4.04-1.42-4.04-1.42-.55-1.39-1.33-1.76-1.33-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1.01-.32 3.3 1.23A11.5 11.5 0 0 1 12 6.09c1.02 0 2.04.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.31c0 .32.22.7.83.58A12 12 0 0 0 12 .3Z" />
              </svg>
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a href="https://orcid.org/0009-0000-5843-5750" target="_blank" rel="me noopener noreferrer">
              <svg class="footer-orcid-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <path d="M8 10v6M8 7.75v.01M12 8.75h2.25a3.25 3.25 0 0 1 0 6.5H12v-6.5Z" />
              </svg>
              <span>ORCID</span>
            </a>
          </li>
        </ul>
      </div>
      <p><a href="/">boomerrawlings.com</a></p>
    </footer>
  </body>
</html>
