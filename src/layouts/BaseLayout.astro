---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Boomer Rawlings',
  description = 'Psychology, research, experimental software, writing, and photography by Boomer Rawlings.',
} = Astro.props;

const pageTitle = title === 'Boomer Rawlings' ? title : title + ' — Boomer Rawlings';
const canonical = new URL(Astro.url.pathname, Astro.site);
const navItems = [
  ['Projects', '/work/'],
  ['Archive', '/archive/'],
  ['About', '/about/'],
];

const isCurrent = (href: string) =>
  href === '/work/'
    ? Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/work/')
    : Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f9f6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Boomer Rawlings, home">
        <span class="wordmark-name">Boomer Rawlings</span>
        <span class="wordmark-description">Public Archive</span>
      </a>
      <nav aria-label="Primary navigation">
        <ul>
          {navItems.map(([label, href]) => (
            <li><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Boomer Rawlings</p>
      <p><a href="mailto:boomerrawlings@gmail.com">boomerrawlings@gmail.com</a></p>
      <p><a href="/">boomerrawlings.com</a></p>
    </footer>
  </body>
</html>
