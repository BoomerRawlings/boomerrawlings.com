<section class="guitar-learning parietal-illustration" data-parietal-attention data-lesion="none" aria-label="Parietal attention illustration">
  <div class="guitar-actions"><div><h2>Explore each lobe's contribution</h2><p data-parietal-hint>Hover over a lobe to fade it. Click to place a lesion; click it again to remove the lesion.</p></div></div>
  <div class="learning-screen">
    <svg class="learning-circuit attention-circuit" viewBox="0 0 1280 720" role="group" aria-labelledby="parietal-title parietal-desc">
      <title id="parietal-title">Parietal lobes and the space attended above them</title><desc id="parietal-desc">Schematic view from above: left hemisphere on the left, right hemisphere on the right. Attention projects upward into the person's space. Hover or focus either lobe to preview its contribution. Click or press Enter to toggle a lesion; selecting the other lobe moves the lesion.</desc>
      <defs><marker id="attention-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerUnits="userSpaceOnUse" markerWidth="25" markerHeight="25" orient="auto"><path d="M0 0L10 5L0 10z" fill="#78abaa"/></marker></defs>
      <text x="48" y="32" class="diagram-eyebrow">SPATIAL ATTENTION</text><text x="48" y="77" class="diagram-heading">Parietal contributions to attention</text><text x="48" y="112" class="diagram-note">View from above · left and right match the person's hemispheres and space</text>
      <path d="M450 143H830" fill="none" stroke="#c7d0c9" stroke-width="1"/>
      <g data-space-side="left"><text x="520" y="174" text-anchor="middle" class="attention-region">Left space</text></g>
      <g><text x="640" y="174" text-anchor="middle" class="attention-region">Center</text></g>
      <g data-space-side="right"><text x="760" y="174" text-anchor="middle" class="attention-region">Right space</text></g>
      <!-- As in slide16: short, straight functional projections, not neural tracts. -->
      <g class="attention-contribution" data-parietal-side="left"><path d="M607 337L780 215" fill="none" stroke="#78abaa" stroke-width="7" marker-end="url(#attention-arrow)"/></g>
      <g class="attention-contribution" data-parietal-side="right"><path d="M674 337L528 215" fill="none" stroke="#78abaa" stroke-width="7" marker-end="url(#attention-arrow)"/><path d="M674 337L740 215" fill="none" stroke="#78abaa" stroke-width="7" marker-end="url(#attention-arrow)"/></g>
      <!-- Dorsal view: anterior above, posterior below; folded hemispheres flank the midline. -->
      <defs>
        <linearGradient id="cortical-gray" x1="0" x2="1"><stop offset="0" stop-color="#e1e2df"/><stop offset=".55" stop-color="#f4f4f1"/><stop offset="1" stop-color="#d9dcda"/></linearGradient>
        <g id="parietal-hemisphere" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <path d="M624 310C606 298 587 310 584 328C563 316 543 336 544 355C520 351 500 374 501 396C478 402 470 425 477 446C457 462 464 489 476 500C465 520 477 544 493 551C490 574 509 590 528 593C535 617 561 625 579 614C596 624 617 606 620 588C628 559 622 531 624 500C626 472 621 443 625 416C626 389 619 371 625 347C630 332 631 319 624 310Z" fill="url(#cortical-gray)" stroke="#969e9e" stroke-width="2.8"/>
          <path d="M600 326C582 340 602 357 587 372C574 383 554 373 542 389C530 403 543 417 530 429C518 440 492 426 486 447M613 362C598 376 615 392 603 408C591 420 570 410 562 427C555 444 570 455 556 467C539 479 518 462 508 479C497 495 508 508 492 522M599 435C587 448 602 467 587 482C575 496 549 485 541 504C534 522 556 532 543 548C531 560 509 547 509 571M609 507C594 518 610 535 595 549C580 563 562 552 560 575C559 592 581 594 581 609M527 374C518 389 534 397 527 409M487 465C501 457 508 444 503 434M575 339C562 351 575 359 568 370M603 581C592 573 580 578 583 591" stroke="#abb2af" stroke-width="6"/>
          <path d="M601 326C583 340 603 357 588 372C575 383 555 373 543 389C531 403 544 417 531 429C519 440 493 426 487 447M614 362C599 376 616 392 604 408C592 420 571 410 563 427C556 444 571 455 557 467C540 479 519 462 509 479C498 495 509 508 493 522M600 435C588 448 603 467 588 482C576 496 550 485 542 504C535 522 557 532 544 548C532 560 510 547 510 571M610 507C595 518 611 535 596 549C581 563 563 552 561 575C560 592 582 594 582 609" stroke="#f9f9f6" stroke-width="2.5"/>
        </g>
      </defs>
      <g class="parietal-lobe" data-parietal-lobe="left" transform="translate(0 35)" role="button" tabindex="0" aria-label="Toggle lesion in left parietal lobe" aria-pressed="false">
        <g class="lobe-tissue"><use href="#parietal-hemisphere"/><path class="parietal-patch" d="M488 463Q541 440 612 464L611 535Q553 550 497 523Q480 499 488 463Z" fill="#cde4e1" fill-opacity=".72" stroke="#649695" stroke-width="2.5"/></g>
        <text x="552" y="492" text-anchor="middle" fill="#1d3552" font-size="19" font-weight="600" pointer-events="none">Left parietal</text>
        <g class="lesion-mark" aria-hidden="true"><path d="M534 510L570 546M570 510L534 546" fill="none" stroke="#b64c3f" stroke-width="5"/><text x="552" y="576" text-anchor="middle" fill="#a54438">LESION</text></g>
      </g>
      <g class="parietal-lobe" data-parietal-lobe="right" transform="translate(0 35)" role="button" tabindex="0" aria-label="Toggle lesion in right parietal lobe" aria-pressed="false">
        <g class="lobe-tissue"><use href="#parietal-hemisphere" transform="translate(1280 0) scale(-1 1)"/><path class="parietal-patch" d="M792 463Q739 440 668 464L669 535Q727 550 783 523Q800 499 792 463Z" fill="#cde4e1" fill-opacity=".72" stroke="#649695" stroke-width="2.5"/></g>
        <text x="728" y="492" text-anchor="middle" fill="#1d3552" font-size="19" font-weight="600" pointer-events="none">Right parietal</text>
        <g class="lesion-mark" aria-hidden="true"><path d="M710 510L746 546M746 510L710 546" fill="none" stroke="#b64c3f" stroke-width="5"/><text x="728" y="576" text-anchor="middle" fill="#a54438">LESION</text></g>
      </g>
      <text x="552" y="683" text-anchor="middle" class="diagram-note">Mainly right space</text><text x="728" y="683" text-anchor="middle" class="diagram-note">Both sides; favors left</text>
      <text x="48" y="714" class="diagram-note">Arrows indicate coverage · their width does not compare strength or necessity</text>
    </svg>
    <div class="learning-caption" aria-live="polite"><span data-parietal-stage>BOTH CONTRIBUTIONS AVAILABLE</span><p data-parietal-caption>Right parietal attention covers both sides, favoring the left. Left parietal attention mainly supports the right.</p></div>
  </div>
  <div class="learning-controls"><button type="button" data-parietal-reset>↺ Clear lesion</button><button type="button" data-illustration-fullscreen>⛶ Fullscreen</button></div>
  <p class="learning-limit">One illustrative lesion at a time. Actual neglect and compensation vary. Removing the marker resets the illustration.</p>
</section>
