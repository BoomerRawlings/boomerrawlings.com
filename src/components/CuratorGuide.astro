---
import PortfolioMap from './PortfolioMap.astro';

interface GuideLink {
  href: string;
  label: string;
}

interface Props {
  heading?: string;
  headingId?: string;
  messages: string[];
  nextExhibit?: GuideLink;
  variant?: 'home' | 'compact';
}

const {
  heading = 'Pip says',
  headingId = 'pip-heading',
  messages,
  nextExhibit,
  variant = 'compact',
} = Astro.props;

if (messages.length === 0) {
  throw new Error('CuratorGuide requires at least one message.');
}

const messageId = `${headingId}-message`;
const formAction = nextExhibit?.href ?? Astro.url.pathname;
const messageSignal = ['[', '<', '·', '>', ']'];
const signalStyle = (index: number, phase = 0) =>
  `--pip-signal-delay: -${((index * 0.43) + phase).toFixed(2)}s; --pip-signal-speak-delay: ${index * 28}ms`;
---

<aside
  class:list={['curator-guide', `curator-guide--${variant}`]}
  aria-labelledby={headingId}
  data-pip-guide
  data-pip-steps={JSON.stringify(messages)}
>
  {variant === 'home'
    ? <PortfolioMap />
    : <span class="portfolio-curator" aria-hidden="true"></span>}
  <div class="curator-copy">
    <div class="curator-heading-row">
      <h2 id={headingId}>{heading}</h2>
      <button
        class="pip-sound-toggle"
        type="button"
        aria-label="Turn Pip’s sound off"
        aria-pressed="true"
        data-pip-sound
        hidden
      >
        Sound on
      </button>
    </div>
    <p id={messageId} class="curator-message" role="status" aria-live="polite" aria-atomic="true">
      <span data-pip-message>{messages[0]}</span>
    </p>
    <form
      class="curator-controls"
      action={formAction}
      method="get"
      data-pip-form
      data-pip-destination={nextExhibit?.label}
      data-pip-terminal={nextExhibit ? undefined : 'true'}
    >
      <div class="curator-progress-stack">
        <p class="curator-progress" data-pip-progress hidden>
          <span aria-hidden="true"><span data-pip-current>01</span> / {String(messages.length).padStart(2, '0')}</span>
          <span class="sr-only" data-pip-progress-label>Step 1 of {messages.length}</span>
        </p>
        <button class="curator-back" type="button" data-pip-back hidden>Back</button>
      </div>
      <button
        class="curator-next"
        type="submit"
        aria-controls={messageId}
        aria-label={nextExhibit ? `Continue to ${nextExhibit.label}` : 'Show Pip’s next note'}
      >
        <span data-pip-next-label>Next</span>
        <span class="pip-signal pip-signal--next" data-pip-signal="next" aria-hidden="true">
          {messageSignal.map((glyph, glyphIndex) => (
            <span class="pip-signal-glyph" style={signalStyle(glyphIndex, 1.1)}>{glyph}</span>
          ))}
        </span>
      </button>
    </form>
  </div>
</aside>

<script is:inline type="module" src="/scripts/pip.js"></script>
