---
import { selectedRows, rateLabel } from '../lib/campus-rates.js';
const {data} = Astro.props;
const rows = selectedRows(data);
const number = (value:number|null) => value === null ? 'Unavailable' : value.toLocaleString('en-US');
---
<section id="explorer" class="analysis-section" data-campus-explorer aria-labelledby="campus-explorer-heading">
  <div class="analysis-section-title"><span>01</span><div><h2 id="campus-explorer-heading">Compare reported rates</h2><p>Start with a category and population. Every rate retains its count and denominator.</p></div></div>
  <div class="campus-controls" id="campus-controls" hidden>
    <label class="campus-control-wide">Reported category<select id="campus-category">{data.categories.map((c:any)=><option value={c.id}>{c.label}</option>)}</select></label>
    <label class="campus-control-wide">Location / population<select id="campus-measure"><option value="enrollment">On campus / enrolled students</option><option value="housingEnrollment">Campus housing / enrolled students</option><option value="residents">Campus housing / documented residents</option></select></label>
    <label>Report year<select id="campus-period"><option value="2024">2024</option><option value="pooled">2022–2024 pooled annual rate</option><option value="2023">2023</option><option value="2022">2022</option></select></label>
    <label>Comparison group<select id="campus-group"><option value="all">All 42 institutions</option><option value="uc">University of California</option><option value="ivy">Ivy League</option><option value="public">Additional public universities</option><option value="private">Additional private universities</option></select></label>
    <label>Rate scale<select id="campus-scale"><option value="1000">Per 1,000</option><option value="10000">Per 10,000</option></select></label>
    <label>Display order<select id="campus-sort"><option value="name">Institution A–Z</option><option value="rateDesc">Reported rate: high to low</option><option value="rateAsc">Reported rate: low to high</option></select></label>
    <label class="campus-control-wide">Find an institution<input id="campus-search" type="search" placeholder="Name or state" autocomplete="off" /></label>
  </div>
  <p id="campus-category-definition" class="analysis-note">Sum of the listed Clery criminal-offense categories. Excludes VAWA counts, hate-crime classifications, arrests and disciplinary referrals. It is not a count of unique incidents or people.</p>
  <aside id="campus-measure-note" class="analysis-notice"><strong>What this measures.</strong> On-campus offenses reported in 2024, per 1,000 enrolled students. The denominator is fall enrollment. Reports can concern visitors, staff and earlier occurrences; this is not the probability that a student experiences a crime.</aside>
  <div class="campus-table-heading"><h3 id="campus-table-title">Listed criminal offenses · 2024</h3><p id="campus-results-status" role="status" aria-live="polite">42 institutions · alphabetical order</p></div>
  <div class="analysis-table-scroll campus-table-wrap" role="region" tabindex="0" aria-label="Campus reported rates, scroll horizontally for counts and populations">
    <table id="campus-results"><caption class="campus-sr-only">Reported criminal offenses per 1,000 enrolled students, 2024. Administrative reports, not individual risk.</caption><thead><tr><th scope="col">Institution</th><th scope="col">Rate per 1,000</th><th scope="col">Reported count</th><th scope="col">Fall enrollment</th></tr></thead><tbody>{rows.map((row:any)=><tr><th scope="row">{row.institution.name}</th><td class="campus-rate">{rateLabel(row.rate)}</td><td>{number(row.count)}</td><td>{number(row.population)}</td></tr>)}</tbody></table>
  </div>
  <p class="analysis-note">Housing is already included in on-campus counts. Rate sorting does not establish which campus is safer. <a href="#methods">Definitions and comparability limits</a>.</p>
  <div class="campus-tools" id="campus-tools" hidden><button type="button" id="campus-download">Download selection · CSV</button><button type="button" id="campus-share">Copy this view’s link</button><button type="button" id="campus-reset">Reset filters</button><span id="campus-action-status" role="status" aria-live="polite"></span></div>
  <noscript><p>The default table and methods are available without JavaScript. Interactive filters require JavaScript; <a href="/data-analysis/campus-safety/data/annual_rates.csv">download all annual rates</a>.</p></noscript>
  <section id="campus-detail" class="campus-detail" hidden aria-labelledby="campus-detail-heading">
    <h3 id="campus-detail-heading">Inspect two institutions</h3><p>Annual values use the category, population and scale selected above. Both charts share a zero baseline and the same scale.</p>
    <div class="campus-pair-selectors"><label>First institution<select id="campus-first">{data.institutions.map((i:any)=><option value={i.id} selected={i.shortName==='UC San Diego'}>{i.name}</option>)}</select></label><label>Second institution<select id="campus-second">{data.institutions.map((i:any)=><option value={i.id} selected={i.shortName==='San Diego State'}>{i.name}</option>)}</select></label></div>
    <div class="campus-pair" id="campus-pair"></div>
  </section>
  <script id="campus-dataset" type="application/json" set:html={JSON.stringify(data).replace(/</g,'\\u003c')} />
</section>
<script>
  import { measures, summarize, selectedRows, rateLabel, csvText } from '../lib/campus-rates.js';
  const root = document.querySelector('[data-campus-explorer]');
  if (root) {
    const data = JSON.parse(document.getElementById('campus-dataset')!.textContent!);
    const ids = {category:'campus-category',measure:'campus-measure',period:'campus-period',group:'campus-group',scale:'campus-scale',sort:'campus-sort',search:'campus-search',first:'campus-first',second:'campus-second'};
    const controls = Object.fromEntries(Object.entries(ids).map(([key,id])=>[key,document.getElementById(id) as HTMLInputElement|HTMLSelectElement]));
    const defaults = Object.fromEntries(Object.entries(controls).map(([key,input])=>[key,input.value]));
    const $ = (id:string)=>document.getElementById(id)!;
    const n = (value:number|null)=>value === null ? 'Unavailable' : value.toLocaleString('en-US');
    const el = (tag:string,text?:string,className?:string)=>{const node=document.createElement(tag); if(text!==undefined)node.textContent=text; if(className)node.className=className;return node;};
    const params = new URL(location.href).searchParams;
    for (const [key,input] of Object.entries(controls)) {
      const value=params.get(key);
      if(value!==null && (input instanceof HTMLInputElement || Array.from(input.options).some(o=>o.value===value))) input.value=value;
    }
    let current:any[]=[];
    function state(){return {...Object.fromEntries(Object.entries(controls).map(([key,input])=>[key,input.value])),scale:Number(controls.scale.value)} as any;}
    function saveView(){const url=new URL(location.href);for(const [key,input] of Object.entries(controls)){if(input.value===defaults[key])url.searchParams.delete(key);else url.searchParams.set(key,input.value);}history.replaceState(null,'',url);}
    function drawPair(s:any){
      const pair=[controls.first.value,controls.second.value].map(id=>data.institutions.find((inst:any)=>inst.id===id));
      const rates=pair.map(inst=>data.years.map((year:number)=>({...summarize(inst,s.category,String(year),s.measure,s.scale),year})));
      const maximum=Math.max(1,...rates.flat().map(row=>row.rate??0));
      const container=$('campus-pair');container.replaceChildren();
      pair.forEach((inst,index)=>{
        const card=el('article',undefined,'campus-card');card.append(el('h4',inst.name));
        card.append(el('p',`${inst.branchCount} federal reporting ${inst.branchCount===1?'campus':'campuses'} · ${inst.state}`,'analysis-note'));
        const chart=el('div',undefined,'campus-year-bars');
        rates[index].forEach(row=>{
          const line=el('div',undefined,'campus-year-row');line.append(el('span',String(row.year)));
          const track=el('span',undefined,'campus-bar-track');track.setAttribute('aria-hidden','true');const bar=el('span',undefined,'campus-bar');bar.style.width=`${(row.rate??0)/maximum*100}%`;track.append(bar);line.append(track,el('strong',rateLabel(row.rate)));chart.append(line);
        });card.append(chart,el('p',`Rate per ${n(s.scale)} ${measures[s.measure].population}.`,'analysis-note'));
        const table=el('table',undefined,'campus-mini-table');const head=el('thead');const hr=el('tr');['Year','Offenses','Population'].forEach(v=>{const th=el('th',v);th.setAttribute('scope','col');hr.append(th);});head.append(hr);table.append(head);const body=el('tbody');rates[index].forEach(row=>{const tr=el('tr');const th=el('th',String(row.year));th.setAttribute('scope','row');tr.append(th,el('td',n(row.count)),el('td',n(row.population)));body.append(tr);});table.append(body);card.append(table);
        inst.notes.forEach((note:string)=>card.append(el('p',note,'analysis-note')));
        if(s.measure==='residents')card.append(el('p',inst.residentNote,'campus-scope-note'));
        const details=el('details');details.append(el('summary','Reporting campuses and source records'));const list=el('ul');inst.campuses.forEach((campus:any)=>list.append(el('li',`${campus.name} (${campus.id})`)));details.append(list);
        const link=el('a','Download campus crosswalk') as HTMLAnchorElement;link.href='/data-analysis/campus-safety/data/campus_crosswalk.csv';details.append(link);card.append(details);container.append(card);
      });
    }
    function render(){
      const s=state();current=selectedRows(data,s);const category=data.categories.find((c:any)=>c.id===s.category);const definition=measures[s.measure];const pooled=s.period==='pooled';
      $('campus-category-definition').textContent=category.description;
      const per=`per ${n(s.scale)} ${definition.population}`;
      $('campus-table-title').textContent=`${category.label} · ${pooled?'2022–2024 pooled annual rate':s.period}`;
      const available=current.filter(row=>row.rate!==null).length;
      $('campus-results-status').textContent=`${current.length} ${current.length===1?'institution':'institutions'} · ${available} ${available===1?'rate':'rates'} available${s.sort==='name'?' · alphabetical order':' · descriptive order, not a safety ranking'}`;
      $('campus-measure-note').textContent=s.measure==='residents'
        ? `Approximate housing normalization: residential-facility offenses ${per}${pooled?' per year':''}. Occupancy is documented for the ten UCs and San Diego State only. Housing-property boundaries have not been matched to Clery geography; this is not a resident victimization rate. ${pooled?'The denominator sums three fall occupancy snapshots.':'The denominator is fall occupancy in the selected year.'}`
        : `${s.measure==='housingEnrollment'?'Residential-facility':'On-campus'} reported offenses ${per}${pooled?' per year':''}. ${pooled?'The denominator sums three fall enrollment headcounts.':'The denominator is fall enrollment in the selected year.'} Reports may involve nonstudents and earlier occurrences. ${s.measure==='housingEnrollment'?'Enrollment includes students living elsewhere; this does not measure resident risk.':'Institutions may combine multiple reporting campuses; inspect their scope below.'}`;
      const table=$('campus-results');table.replaceChildren();const caption=el('caption',`${category.label}, ${per}; ${pooled?'2022–2024 pooled':s.period}. Administrative reporting measure, not individual risk.`,'campus-sr-only');table.append(caption);
      const thead=el('thead');const tr=el('tr');['Institution',`Rate per ${n(s.scale)}`,'Reported count',`${pooled?'Sum of fall':'Fall'} ${s.measure==='residents'?'occupancy':'enrollment'}`].forEach(text=>{const th=el('th',text);th.setAttribute('scope','col');tr.append(th);});thead.append(tr);table.append(thead);const tbody=el('tbody');
      const max=Math.max(1,...current.map(row=>row.rate??0));
      for(const row of current){const tr=el('tr');const name=el('th');name.setAttribute('scope','row');const button=el('button',row.institution.name,'campus-institution-button') as HTMLButtonElement;button.type='button';button.setAttribute('aria-label',`Inspect ${row.institution.name}`);button.addEventListener('click',()=>{controls.first.value=row.institution.id;drawPair(state());saveView();$('campus-detail-heading').setAttribute('tabindex','-1');$('campus-detail-heading').focus();$('campus-detail').scrollIntoView({block:'start',behavior:'smooth'});});name.append(button);if(row.institution.branchCount>1)name.append(el('span',`${row.institution.branchCount} reporting campuses`,'campus-row-scope'));tr.append(name);const td=el('td',undefined,'campus-rate');td.append(el('strong',rateLabel(row.rate)));if(row.rate!==null){const bar=el('span',undefined,'campus-table-bar');bar.style.width=`${row.rate/max*100}%`;bar.setAttribute('aria-hidden','true');td.append(bar);}tr.append(td,el('td',n(row.count)),el('td',n(row.population)));tbody.append(tr);}
      if(!current.length){const tr=el('tr');const td=el('td','No institutions match these filters. Clear the search or change the comparison group.');td.setAttribute('colspan','4');tr.append(td);tbody.append(tr);}table.append(tbody);drawPair(s);saveView();
    }
    Object.entries(controls).forEach(([key,input])=>input.addEventListener(key==='search'?'input':'change',render));
    $('campus-download').addEventListener('click',()=>{const s=state();const definition=measures[s.measure];const rows=[['institution','unitid','category','geography','population_basis','period','rate_scale','reported_count','population_sum','years','rate','source_collection','interpretation'],...current.map(row=>[row.institution.name,row.institution.id,s.category,definition.geography,definition.denominator,s.period,s.scale,row.count,row.population,row.years,row.rate,2025,s.measure==='residents'?'Approximate; housing boundaries unmatched':'Administrative reports; not individual risk'])];const blob=new Blob([csvText(rows)],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`campus-safety-${s.category}-${s.measure}-${s.period}.csv`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);$('campus-action-status').textContent='Selection downloaded.';});
    $('campus-share').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(location.href);$('campus-action-status').textContent='View link copied.';}catch{$('campus-action-status').textContent='Copy the address from your browser to share this view.';}});
    $('campus-reset').addEventListener('click',()=>{for(const [key,input]of Object.entries(controls))input.value=defaults[key];render();$('campus-action-status').textContent='Filters reset.';});
    render();['campus-controls','campus-tools','campus-detail'].forEach(id=>$(id).hidden=false);
  }
</script>
