---
import mikwhaleAtlas from '../assets/aristotter/characters/mikwhale/character-motion-v3.webp';
---

<div class="character-frame-shell">
  <div
    class="character-frame"
    data-frame-character="mikwhale"
    data-frame="neutral"
    role="img"
    aria-label="Mikwhale Bakunin, a small blue whale with wild brown side curls, a huge beard, and a dark cravat"
    style={`background-image: url("${mikwhaleAtlas.src}")`}
  ></div>
</div>

<style>
  .character-frame-shell {
    align-items: end;
    display: flex;
    height: 100%;
    justify-content: center;
    max-width: 100%;
    width: 100%;
  }

  .character-frame {
    aspect-ratio: 3 / 4;
    background-position: 0 0;
    background-repeat: no-repeat;
    background-size: 800% 400%;
    height: 100%;
    max-width: 100%;
    pointer-events: none;
  }

  .character-frame[data-frame='neutral'] { background-position: 0 0; }
  .character-frame[data-frame='inhale-mid'] { background-position: 14.285714% 0; }
  .character-frame[data-frame='inhale'] { background-position: 28.571429% 0; }
  .character-frame[data-frame='blink-quarter'] { background-position: 42.857143% 0; }
  .character-frame[data-frame='blink-half'] { background-position: 57.142857% 0; }
  .character-frame[data-frame='blink-three-quarter'] { background-position: 71.428571% 0; }
  .character-frame[data-frame='blink-closed'] { background-position: 85.714286% 0; }
  .character-frame[data-frame='wide-mid'] { background-position: 100% 0; }
  .character-frame[data-frame='small-mid'] { background-position: 0 33.333333%; }
  .character-frame[data-frame='small'] { background-position: 14.285714% 33.333333%; }
  .character-frame[data-frame='open-mid'] { background-position: 28.571429% 33.333333%; }
  .character-frame[data-frame='open'] { background-position: 42.857143% 33.333333%; }
  .character-frame[data-frame='round-mid'] { background-position: 57.142857% 33.333333%; }
  .character-frame[data-frame='round'] { background-position: 71.428571% 33.333333%; }
  .character-frame[data-frame='smile-mid'] { background-position: 85.714286% 33.333333%; }
  .character-frame[data-frame='smile'] { background-position: 100% 33.333333%; }
  .character-frame[data-frame='gesture-00'] { background-position: 0 66.666667%; }
  .character-frame[data-frame='gesture-01'] { background-position: 14.285714% 66.666667%; }
  .character-frame[data-frame='gesture-02'] { background-position: 28.571429% 66.666667%; }
  .character-frame[data-frame='gesture-03'] { background-position: 42.857143% 66.666667%; }
  .character-frame[data-frame='gesture-04'] { background-position: 57.142857% 66.666667%; }
  .character-frame[data-frame='gesture-05'] { background-position: 71.428571% 66.666667%; }
  .character-frame[data-frame='gesture-06'] { background-position: 85.714286% 66.666667%; }
  .character-frame[data-frame='gesture-07'] { background-position: 100% 66.666667%; }
  .character-frame[data-frame='gesture-08'] { background-position: 0 100%; }
  .character-frame[data-frame='gesture-09'] { background-position: 14.285714% 100%; }
  .character-frame[data-frame='gesture-10'] { background-position: 28.571429% 100%; }
  .character-frame[data-frame='gesture-11'] { background-position: 42.857143% 100%; }
  .character-frame[data-frame='gesture-12'] { background-position: 57.142857% 100%; }
  .character-frame[data-frame='gesture-13'] { background-position: 71.428571% 100%; }
  .character-frame[data-frame='gesture-14'] { background-position: 85.714286% 100%; }
  .character-frame[data-frame='gesture-15'] { background-position: 100% 100%; }
</style>
