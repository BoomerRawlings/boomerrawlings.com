                            <ellipse cx="618.5" cy="47" rx="56" ry="27" fill="#5d8b9a" />
                          </g>
                          <g class="puppet__paint" clip-path="url(#mikwhale-clip-head)"><use href="#mikwhale-rig-paint" /></g>
                          <g class="puppet__part puppet__part--eye" data-part="eye-left" data-idle-part="eye-left" data-pivot="472 369" data-idle-origin="472px 369px" style="--part-pivot: 472px 369px">
                            <g class="puppet__voice-layer" data-voice-part="eye-left" data-voice-origin="472px 369px">
                              <g class="puppet__paint" clip-path="url(#mikwhale-clip-eye-left)"><use href="#mikwhale-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--eye" data-part="eye-right" data-idle-part="eye-right" data-pivot="765 369" data-idle-origin="765px 369px" style="--part-pivot: 765px 369px">
                            <g class="puppet__voice-layer" data-voice-part="eye-right" data-voice-origin="765px 369px">
                              <g class="puppet__paint" clip-path="url(#mikwhale-clip-eye-right)"><use href="#mikwhale-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--fur" data-part="fur" data-idle-part="fur" data-pivot="618.5 502" data-idle-origin="618.5px 502px" style="--part-pivot: 618.5px 502px">
                            <g class="puppet__voice-layer" data-voice-part="fur" data-voice-origin="618.5px 502px">
                              <g class="puppet__paint" clip-path="url(#mikwhale-clip-fur)"><use href="#mikwhale-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--nose" data-part="nose" data-idle-part="nose" data-pivot="618.5 47" data-idle-origin="618.5px 47px" style="--part-pivot: 618.5px 47px">
                            <g class="puppet__voice-layer" data-voice-part="nose" data-voice-origin="618.5px 47px">
                              <g class="puppet__paint" clip-path="url(#mikwhale-clip-nose)"><use href="#mikwhale-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--mouth" data-part="mouth" data-pivot="618.5 538" style="--part-pivot: 618.5px 538px">
                            <g class="puppet__voice-layer" data-voice-part="mouth" data-voice-origin="618.5px 538px">
                              <g transform="translate(618.5 538)">
                                <g class="character__mouth" data-mouth="mikwhale">
                                  <ellipse class="character__mouth-cavity" rx="38.5" ry="16" vector-effect="non-scaling-stroke"></ellipse>
                                  <path class="character__mouth-tongue" d="M -23 7 Q 0 22 23 7 Q 18 25 0 27 Q -18 25 -23 7 Z"></path>
                                </g>
                              </g>
