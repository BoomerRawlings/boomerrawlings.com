    grid-template-rows: auto auto auto auto;
    max-width: 86rem;
    min-height: min(48rem, calc(100svh - 3rem));
    min-width: 0;
    overflow: visible;
    position: relative;
    width: 100%;
  }

  .character--pyotter {
    grid-column: 1;
    grid-row: 1;
  }

  .current-object {
    grid-column: 2;
    grid-row: 1;
  }

  .character--mikwhale {
    grid-column: 3;
    grid-row: 1;
  }

  .character {
    align-self: end;
    display: grid;
    justify-items: center;
    min-width: 0;
    overflow: visible;
  }

  .character figure {
    display: grid;
    justify-items: center;
    margin: 0;
    min-width: 0;
    overflow: visible;
    width: 100%;
  }

  .character__art {
    align-items: end;
    display: flex;
    height: clamp(15rem, 50vh, 31rem);
    justify-content: center;
    min-width: 0;
    overflow: visible;
    transform-origin: 50% 94%;
    width: min(100%, 28rem);
  }

  .character__performance,
  .character__idle {
    align-items: end;
    display: flex;
    height: 100%;
    justify-content: center;
    max-width: 100%;
    min-width: 0;
    transform-origin: 50% 94%;
    width: 100%;
  }

  .character__performance {
    transform: none;
  }

  .character__sprite {
    display: block;
    height: 100%;
    max-width: 100%;
    overflow: visible;
    width: auto;
  }

  .character__puppet,
  .character__puppet .puppet {
    overflow: visible;
  }

  .character__puppet .puppet__part,
  .character__puppet .puppet__voice-layer {
    pointer-events: none;
    transform-box: view-box;
    transform-origin: var(--part-pivot, center);
  }

  .character__puppet .puppet__part {
    transform:
      translate(var(--part-x, 0), var(--part-y, 0))
      rotate(var(--part-rotate, 0deg))
      scale(var(--part-scale-x, 1), var(--part-scale-y, 1));
  }

  .character__puppet .puppet__voice-layer {
    transition: transform 360ms cubic-bezier(0.22, 0.72, 0.2, 1);
  }

  .character__puppet .puppet__underpaint {
    pointer-events: none;
  }

  .character__mouth {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.62, 0.08);
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 28ms linear,
      transform 54ms cubic-bezier(0.2, 0.78, 0.2, 1);
    will-change: opacity, transform;
  }

  .character__mouth-cavity {
    fill: #301b15;
    paint-order: stroke fill;
    stroke: #4a2b1d;
    stroke-width: 1.25;
  }

  .character--mikwhale .character__mouth-cavity {
    fill: #271611;
    stroke: #4a3024;
  }

  .character__mouth-tongue {
    fill: #d57e78;
    opacity: 0;
    transition: opacity 28ms linear;
  }

  .character--mikwhale .character__mouth-tongue {
    fill: #aa6461;
  }

  .character[data-viseme='small'] .character__mouth {
    opacity: 1;
    transform: scale(0.58, 0.38);
  }

  .character[data-viseme='open'] .character__mouth {
    opacity: 1;
    transform: scale(0.82, 1.05);
  }

  .character[data-viseme='wide'] .character__mouth {
    opacity: 1;
    transform: scale(1.18, 0.56);
  }

  .character[data-viseme='round'] .character__mouth {
    opacity: 1;
    transform: scale(0.56, 1.08);
  }

  .character[data-viseme='smile'] .character__mouth {
    opacity: 1;
    transform: scale(1.08, 0.72);
  }

  .character[data-viseme='open'] .character__mouth-tongue,
  .character[data-viseme='wide'] .character__mouth-tongue,
  .character[data-viseme='smile'] .character__mouth-tongue {
    opacity: 0.9;
  }

  .character--mikwhale .character__art {
    height: clamp(15.6rem, 52vh, 32.2rem);
  }

  .character figcaption {
    color: var(--muted);
    font-size: clamp(0.72rem, 1.2vw, 0.92rem);
    font-weight: 600;
    margin-top: 0.25rem;
    text-align: center;
  }

  .dialogue {
    align-self: end;
    background: rgb(255 250 240 / 96%);
    border: 1px solid rgb(75 46 28 / 23%);
    border-radius: 1rem;
    box-shadow: 0 0.65rem 1.8rem rgb(57 31 16 / 8%);
    margin-bottom: clamp(0.5rem, 1.5vh, 1rem);
    max-width: 22rem;
    min-height: 5.35rem;
    padding: 0.75rem 0.9rem 0.8rem;
    position: relative;
    width: min(100%, 22rem);
  }

  .dialogue::after {
    background: var(--paper);
    border-bottom: 1px solid rgb(75 46 28 / 23%);
    border-right: 1px solid rgb(75 46 28 / 23%);
    bottom: -0.38rem;
    content: '';
    height: 0.75rem;
    left: 50%;
    position: absolute;
    transform: translateX(-50%) rotate(45deg);
    width: 0.75rem;
  }

  .dialogue strong {
    color: #9a6432;
    display: block;
    font-size: 0.66rem;
    letter-spacing: 0.11em;
    margin-bottom: 0.22rem;
    text-transform: uppercase;
  }

  .dialogue p {
    font-size: clamp(0.86rem, 1.2vw, 1.02rem);
    line-height: 1.35;
    margin: 0;
    text-wrap: pretty;
  }

  .current-object {
    align-self: end;
    display: grid;
    justify-items: center;
    margin-bottom: clamp(2.3rem, 7vh, 5.3rem);
    min-width: 0;
    position: relative;
    z-index: 4;
  }

  .current-object__anchor {
    height: clamp(4.8rem, 10vw, 7.8rem);
    transform-origin: 50% 78%;
    width: clamp(4.8rem, 10vw, 7.8rem);
  }

  .current-object__art,
  .current-object__art img {
    height: 100%;
    width: 100%;
  }

  .current-object__art {
    position: relative;
  }

  .current-object__art img {
    display: block;
    object-fit: contain;
    position: absolute;
  }

  .current-object p {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.035em;
    margin: 0.28rem 0 0;
    min-height: 1rem;
    text-align: center;
  }

  .current-object__anchor[data-placement='otter'] {
    transform: translate3d(clamp(-8rem, -12vw, -4rem), 0.8rem, 0) rotate(-4deg);
  }

  .current-object__anchor[data-placement='middle'] {
    transform: translate3d(0, 0.75rem, 0) scale(0.96);
  }

  .current-object__anchor[data-placement='whale'] {
    transform: translate3d(clamp(4rem, 12vw, 8rem), 0.8rem, 0) rotate(4deg);
  }

  .object-drawer {
    align-self: start;
    background: rgb(255 250 240 / 58%);
    border: 1px solid rgb(75 46 28 / 20%);
    border-radius: 1rem;
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0 auto;
    max-width: 58rem;
    min-inline-size: 0;
    padding: 0.45rem 0.55rem 0.5rem;
    width: 100%;
  }

  .object-drawer__heading {
    align-items: baseline;
    display: flex;
    gap: 0.75rem;
    justify-content: space-between;
    padding: 0.05rem 0.25rem 0.22rem;
  }

  .object-drawer__heading strong {
    color: #6e4629;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .object-drawer__heading span {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .object-drawer__rail {
    display: grid;
    gap: 0.45rem;
    grid-auto-columns: clamp(4.75rem, 7vw, 5.6rem);
    grid-auto-flow: column;
    list-style: none;
    margin: 0;
    min-width: 0;
    overscroll-behavior-inline: contain;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.32rem 0.25rem 0.58rem;
    scroll-padding-inline: 0.4rem;
    scroll-snap-type: inline proximity;
    scrollbar-color: rgb(112 73 43 / 54%) rgb(112 73 43 / 10%);
    scrollbar-width: thin;
  }

  .object-drawer__rail::-webkit-scrollbar {
    height: 0.55rem;
  }

  .object-drawer__rail::-webkit-scrollbar-thumb {
    background: rgb(112 73 43 / 48%);
    border: 2px solid transparent;
    border-radius: 999px;
    background-clip: padding-box;
  }

  .object-drawer__rail::-webkit-scrollbar-track {
    background: rgb(112 73 43 / 9%);
    border-radius: 999px;
  }

  .object-drawer__rail li {
    min-width: 0;
    position: relative;
    scroll-snap-align: center;
  }

  .object-drawer__choice {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .object-drawer__choice + label {
    align-items: center;
    background: rgb(255 250 240 / 78%);
    border: 1px solid rgb(75 46 28 / 22%);
    border-radius: 0.8rem;
    color: #63442f;
    cursor: pointer;
    display: grid;
    font-size: 0.66rem;
    font-weight: 650;
    gap: 0.12rem;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 5.4rem;
    justify-items: center;
    padding: 0.38rem 0.32rem 0.34rem;
    position: relative;
    transition:
      background 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease,
      transform 150ms ease;
    user-select: none;
  }

  .object-drawer__choice + label img {
    display: block;
    height: 3.3rem;
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    pointer-events: none;
    width: 3.3rem;
  }

  .object-drawer__choice + label span {
    line-height: 1;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .object-drawer__choice[data-current='true'] + label::after {
    background: #8b552a;
    border-radius: 999px;
    color: #fffaf0;
    content: 'Next';
    font-size: 0.46rem;
    font-weight: 750;
    letter-spacing: 0.035em;
    line-height: 1;
    padding: 0.18rem 0.28rem;
    position: absolute;
    right: 0.26rem;
    text-transform: uppercase;
    top: 0.26rem;
  }

  .object-drawer__choice:checked + label {
    background: #fff4d9;
    border-color: #9c642e;
    box-shadow: 0 0 0 2px rgb(208 139 54 / 22%) inset;
    transform: translateY(-1px);
  }

  .object-drawer__choice:focus-visible + label {
    outline: 3px solid #d08b36;
    outline-offset: 2px;
  }

  .object-drawer:not(:disabled) .object-drawer__choice + label:hover {
    background: #fff7e8;
    border-color: rgb(75 46 28 / 42%);
    transform: translateY(-1px);
  }

  .object-drawer:disabled .object-drawer__choice + label {
    cursor: wait;
    opacity: 0.72;
  }

  .placement-controls,
  .answer-choices,
  .name-form {
    align-self: start;
    grid-column: 1 / -1;
    margin: 0 auto;
    max-width: 58rem;
    width: 100%;
  }

  .placement-controls {
    grid-row: 3;
  }

  .answer-choices,
  .name-form {
    grid-row: 2;
  }

  .voice-toggle {
    align-items: center;
    align-self: start;
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    display: inline-flex;
    font: 650 0.72rem/1 var(--workshop-sans);
    gap: 0.48rem;
    grid-column: 1 / -1;
    grid-row: 4;
    justify-self: end;
    min-height: 2.35rem;
    padding: 0.55rem 0.72rem;
    transition:
      background 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .voice-toggle:hover {
    background: rgb(255 250 240 / 72%);
    color: #513421;
    transform: translateY(-1px);
  }

  .voice-toggle:focus-visible {
    outline: 3px solid #d08b36;
    outline-offset: 2px;
  }

  .voice-toggle:disabled {
    cursor: default;
    opacity: 0.56;
    transform: none;
  }

  .voice-toggle__mark {
    background: currentColor;
    clip-path: polygon(0 34%, 36% 34%, 78% 0, 78% 100%, 36% 66%, 0 66%);
    display: block;
    height: 0.74rem;
    position: relative;
    width: 0.78rem;
  }

  .voice-toggle__mark::after {
    border: 1.5px solid currentColor;
    border-bottom-color: transparent;
    border-left-color: transparent;
    border-radius: 50%;
    border-top-color: transparent;
    content: '';
    height: 0.7rem;
    left: 0.48rem;
    opacity: 0;
    position: absolute;
    top: 0.02rem;
    transform: rotate(0deg);
    width: 0.42rem;
  }

  .voice-toggle[aria-pressed='true'] {
    color: #8b552a;
  }

  .voice-toggle[aria-pressed='true'] .voice-toggle__mark::after {
    opacity: 1;
  }

  .placement-controls,
  .answer-choices > div {
    display: grid;
    gap: clamp(0.35rem, 1vw, 0.7rem);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .placement-controls button,
  .answer-choices button,
  .name-form button {
    background: rgb(255 250 240 / 76%);
    border: 1px solid rgb(75 46 28 / 30%);
    border-radius: 999px;
    color: #513421;
    cursor: pointer;
    font: 600 clamp(0.74rem, 1.2vw, 0.92rem)/1.2 var(--workshop-sans);
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    transition:
      background 150ms ease,
      border-color 150ms ease,
      color 150ms ease,
      transform 150ms ease;
  }

  .placement-controls button:hover,
  .answer-choices button:hover,
  .name-form button:hover {
    background: #4a2d1b;
    border-color: #4a2d1b;
    color: #fff7e7;
    transform: translateY(-1px);
  }

  .placement-controls button:focus-visible,
  .answer-choices button:focus-visible,
  .name-form button:focus-visible,
  .name-form input:focus-visible {
    outline: 3px solid #d08b36;
    outline-offset: 3px;
  }

  .answer-choices {
    border: 0;
    padding: 0;
  }

  .answer-choices legend {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
    margin: 0 auto 0.55rem;
    text-align: center;
  }

  .name-form {
    max-width: 28rem;
  }

  .name-form > label {
    color: var(--muted);
    display: block;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin: 0 0 0.35rem 0.85rem;
    text-transform: uppercase;
  }

  .name-form > div {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .name-form input {
    background: rgb(255 250 240 / 92%);
    border: 1px solid rgb(75 46 28 / 32%);
    border-radius: 999px;
    color: var(--ink);
    font: 600 1rem/1 var(--workshop-sans);
    min-height: 3rem;
    min-width: 0;
    padding: 0.75rem 1rem;
  }

  .name-form button {
    padding-inline: 1.15rem;
  }

  .name-form > p {
    color: #9a3c2f;
    font-size: 0.76rem;
    margin: 0.4rem 0 0 0.85rem;
    min-height: 1rem;
  }

  [hidden] {
    display: none !important;
  }

  .current-object__anchor.is-arriving {
    animation: object-arrive 620ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .current-object__anchor.is-handled .current-object__art {
    animation: object-handle 2.2s ease-in-out;
  }

  .character.is-speaking [data-voice-part='head'],
  .character.is-speaking [data-voice-part='fur'],
  .character.is-speaking [data-voice-part='nose'] {
    transform: translate(0, -0.12%);
  }

  .character.is-acting [data-voice-part='head'] {
    transform: rotate(-0.7deg);
  }

  .character.is-acting [data-voice-part='paw-left'] {
    transform: rotate(-1.8deg);
  }

  .character.is-acting [data-voice-part='paw-right'] {
    transform: rotate(1.8deg);
  }

  .character.is-thinking [data-voice-part='head'] {
    transform: rotate(-0.85deg);
  }

  .character.is-thinking [data-voice-part='eye-left'],
  .character.is-thinking [data-voice-part='eye-right'] {
    transform: translate(-0.18%, 0.08%);
  }

  .character.is-bright [data-voice-part='head'] {
    transform: translate(0, -0.28%) scale(1.004);
  }

  .character.is-bright [data-voice-part='ear-left'] {
    transform: rotate(-1.2deg);
  }

  .character.is-bright [data-voice-part='ear-right'] {
    transform: rotate(1.2deg);
  }

  .character.is-paused [data-voice-part='chest'] {
    transform: scale(1.001, 0.999);
  }

  .character.is-looking-outward [data-voice-part='eye-left'],
  .character.is-looking-outward [data-voice-part='eye-right'] {
    transform: translate(0.24%, -0.04%);
  }

  @keyframes object-arrive {
    0% { opacity: 0; transform: translate3d(0, -0.9rem, 0) scale(0.82); }
    68% { opacity: 1; transform: translate3d(0, 0.12rem, 0) scale(1.04); }
    100% { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
  }

  @keyframes welcome-drift {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(-0.22deg); }
    50% { transform: translate3d(0, -0.16rem, 0) rotate(0.18deg); }
  }

  @keyframes object-handle {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0); }
    42% { transform: translate3d(0, -0.18rem, 0) rotate(-1.2deg); }
    68% { transform: translate3d(0, -0.06rem, 0) rotate(0.7deg); }
  }

  @media (max-width: 48rem) {
    .prologue {
      padding: 0.65rem;
    }

    .prologue__stage {
      gap: 0.3rem;
      grid-template-columns: minmax(0, 1fr) clamp(3.8rem, 17vw, 5.2rem) minmax(0, 1fr);
      grid-template-rows: auto auto auto auto auto;
      min-height: calc(100svh - 1.3rem);
    }

    .workshop-welcome {
      align-self: start;
      grid-column: 1 / -1;
      grid-row: 1;
      justify-self: center;
      left: auto;
      max-width: 36rem;
      position: relative;
      top: auto;
      transform: none;
      width: min(100%, 36rem);
    }

    .workshop-welcome__float {
      filter: drop-shadow(0 0.45rem 0.5rem rgb(75 46 28 / 9%));
    }

    .workshop-welcome__plaque {
      border-width: 0.15rem;
      border-radius: 1.7rem 1.6rem 1.45rem 1.55rem / 1.35rem 1.45rem 1.2rem 1.3rem;
      gap: 0.35rem;
      grid-template-columns: 2.55rem minmax(0, 1fr) 2.55rem;
      min-height: 5.1rem;
      padding: 0.48rem 0.55rem 0.55rem;
    }

    .workshop-welcome__plaque::after {
      inset: 0.34rem;
    }

    .workshop-welcome__kicker {
      border-width: 1px;
      font-size: 0.68rem;
      margin-bottom: 0.18rem;
      padding: 0.25rem 0.55rem 0.22rem;
    }

    .workshop-welcome h1 {
      font-size: clamp(1.42rem, 6.8vw, 2.15rem);
      line-height: 0.92;
    }

    .workshop-welcome__tagline {
      font-size: clamp(0.72rem, 2.4vw, 0.8rem);
      margin-top: 0.24rem;
    }

    .workshop-welcome__leaf,
    .workshop-welcome__ripples {
      height: 2.5rem;
      width: 2.5rem;
    }

    .character--pyotter,
    .current-object,
    .character--mikwhale {
      grid-row: 2;
    }

    .object-drawer,
    .answer-choices,
    .name-form {
      grid-row: 3;
    }

    .placement-controls {
      grid-row: 4;
    }

    .voice-toggle {
      grid-row: 5;
    }

    .character__art {
      height: clamp(10.5rem, 45vw, 14rem);
    }

    .character--mikwhale .character__art {
      height: clamp(11rem, 47vw, 14.7rem);
    }

    .character figcaption {
      font-size: 0.66rem;
      line-height: 1.05;
      min-height: 1.4rem;
    }

    .dialogue {
      border-radius: 0.8rem;
      min-height: 6.4rem;
      padding: 0.58rem 0.65rem 0.65rem;
    }

    .dialogue p {
      font-size: clamp(0.76rem, 3vw, 0.88rem);
      line-height: 1.28;
    }

    .current-object {
      margin-bottom: 2.4rem;
    }

    .current-object__anchor {
      height: clamp(3.8rem, 17vw, 5rem);
      width: clamp(3.8rem, 17vw, 5rem);
    }

    .current-object p {
      font-size: 0.64rem;
      line-height: 1.05;
    }

    .object-drawer {
      border-radius: 0.82rem;
      padding: 0.38rem 0.35rem 0.42rem;
    }

    .object-drawer__rail {
      gap: 0.35rem;
      grid-auto-columns: 4.35rem;
      padding-inline: 0.22rem;
    }

    .object-drawer__choice + label {
      border-radius: 0.68rem;
      font-size: 0.61rem;
      height: 4.8rem;
      padding: 0.3rem 0.25rem;
    }

    .object-drawer__choice + label img {
      height: 2.9rem;
      width: 2.9rem;
    }

    .placement-controls,
    .answer-choices > div {
      gap: 0.28rem;
    }

    .placement-controls button,
    .answer-choices button {
      border-radius: 0.72rem;
      font-size: 0.69rem;
      min-height: 3.15rem;
      padding: 0.55rem 0.35rem;
    }

    .name-form {
      max-width: 24rem;
    }
  }

  @media (min-width: 48.01rem) and (max-height: 52rem) {
    .prologue {
      padding: clamp(0.5rem, 1.4vh, 0.8rem);
    }

    .prologue__stage {
      gap: clamp(0.3rem, 1vh, 0.65rem);
      min-height: calc(100svh - 2rem);
    }

    .workshop-welcome {
      max-width: 24rem;
      top: 0.25rem;
      width: min(36vw, 24rem);
    }

    .workshop-welcome__plaque {
      border-width: 0.15rem;
