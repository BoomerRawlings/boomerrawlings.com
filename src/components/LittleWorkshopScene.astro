---
import PyotterPuppet from './PyotterPuppet.astro';
import MikwhalePuppet from './MikwhalePuppet.astro';
import appleImage from '../assets/companions/objects/apple-v1.png';
import ballImage from '../assets/companions/objects/ball-v1.png';
import batteryImage from '../assets/companions/objects/battery-v1.png';
import bellImage from '../assets/companions/objects/bell-v1.png';
import blockImage from '../assets/companions/objects/block-v1.png';
import bookImage from '../assets/companions/objects/book-v1.png';
import boxImage from '../assets/companions/objects/box-v1.png';
import coinImage from '../assets/companions/objects/coin-v1.png';
import cookieImage from '../assets/companions/objects/cookie-v1.png';
import cupImage from '../assets/companions/objects/cup-v1.png';
import flowerImage from '../assets/companions/objects/flower-v1.png';
import hammerImage from '../assets/companions/objects/hammer-v1.png';
import keyImage from '../assets/companions/objects/key-v1.png';
import lampImage from '../assets/companions/objects/lamp-v1.png';
import magnetImage from '../assets/companions/objects/magnet-v1.png';
import paperImage from '../assets/companions/objects/paper-v1.png';
import pencilImage from '../assets/companions/objects/pencil-v1.png';
import seedImage from '../assets/companions/objects/seed-v1.png';
import strawberryImage from '../assets/companions/objects/strawberry-v1.png';
import stringImage from '../assets/companions/objects/string-v1.png';

const objectSprites = [
  { id: 'apple', label: 'Apple', image: appleImage },
  { id: 'ball', label: 'Ball', image: ballImage },
  { id: 'flower', label: 'Flower', image: flowerImage },
  { id: 'cup', label: 'Cup', image: cupImage },
  { id: 'book', label: 'Book', image: bookImage },
  { id: 'cookie', label: 'Cookie', image: cookieImage },
  { id: 'pencil', label: 'Pencil', image: pencilImage },
  { id: 'paper', label: 'Paper', image: paperImage },
  { id: 'block', label: 'Block', image: blockImage },
  { id: 'string', label: 'String', image: stringImage },
  { id: 'key', label: 'Key', image: keyImage },
  { id: 'coin', label: 'Coin', image: coinImage },
  { id: 'seed', label: 'Seed', image: seedImage },
  { id: 'box', label: 'Box', image: boxImage },
  { id: 'hammer', label: 'Hammer', image: hammerImage },
  { id: 'battery', label: 'Battery', image: batteryImage },
  { id: 'lamp', label: 'Lamp', image: lampImage },
  { id: 'magnet', label: 'Magnet', image: magnetImage },
  { id: 'bell', label: 'Bell', image: bellImage },
  { id: 'strawberry', label: 'Strawberry', image: strawberryImage },
] as const;
---

<section class="prologue" data-prologue aria-labelledby="prologue-title">
  <header class="workshop-welcome">
    <div class="workshop-welcome__float">
      <div class="workshop-welcome__plaque">
        <span class="workshop-welcome__leaf" aria-hidden="true">
          <span></span>
        </span>

        <div class="workshop-welcome__copy">
          <p class="workshop-welcome__kicker">Welcome to</p>
          <h1 id="prologue-title">
            <span>The Little</span>{' '}<span>Workshop</span>
          </h1>
          <p class="workshop-welcome__tagline">Tiny friends. Big ideas. Plenty to share.</p>
        </div>

        <span class="workshop-welcome__ripples" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </div>
    </div>
  </header>

  <div class="prologue__stage" data-prologue-stage>
    <article class="character character--pyotter" data-character="pyotter">
      <aside class="dialogue" data-dialogue="pyotter" hidden>
        <strong>Otter</strong>
        <p data-dialogue-text></p>
      </aside>
      <figure>
        <div class="character__art">
          <div class="character__performance" data-performance="pyotter">
            <PyotterPuppet />
          </div>
        </div>
        <figcaption>Pyotter Kropotkin</figcaption>
      </figure>
    </article>

    <div class="current-object">
      <div
        class="current-object__anchor"
        data-object-anchor
        role="img"
        aria-label="Current object"
        hidden
      >
        <div class="current-object__art">
          {
            objectSprites.map(({ id, image }) => (
              <img
                src={image.src}
                width={image.width}
                height={image.height}
                alt=""
                aria-hidden="true"
                data-object-sprite={id}
                decoding="async"
                hidden
              />
            ))
          }
        </div>
      </div>
      <p data-object-label></p>
    </div>

    <article class="character character--mikwhale" data-character="mikwhale">
      <aside class="dialogue" data-dialogue="mikwhale" hidden>
        <strong>Whale</strong>
        <p data-dialogue-text></p>
      </aside>
      <figure>
        <div class="character__art">
          <div class="character__performance" data-performance="mikwhale">
            <MikwhalePuppet />
          </div>
        </div>
        <figcaption>Mikwhale Bakunin</figcaption>
      </figure>
    </article>

    <fieldset class="object-drawer" data-object-drawer hidden>
      <legend class="visually-hidden">Choose an object</legend>
      <div class="object-drawer__heading">
        <strong>Objects</strong>
        <span data-object-drawer-status aria-live="polite">Choose one</span>
      </div>
      <ul class="object-drawer__rail" data-object-drawer-rail>
        {
          objectSprites.map(({ id, label, image }) => (
            <li data-object-drawer-slot={id} hidden>
              <input
                class="object-drawer__choice"
                type="radio"
                id={`workshop-object-${id}`}
                name="workshop-object"
                value={id}
                data-object-choice={id}
                data-object-name={label}
              />
              <label for={`workshop-object-${id}`}>
                <img
                  src={image.src}
                  width={image.width}
                  height={image.height}
                  alt=""
                  aria-hidden="true"
                  decoding="async"
                  draggable="false"
                />
                <span>{label}</span>
              </label>
            </li>
          ))
        }
      </ul>
    </fieldset>

    <div class="placement-controls" data-placement-controls hidden>
      <button type="button" data-placement="otter">Give to Otter</button>
      <button type="button" data-placement="middle">Set Between Them</button>
      <button type="button" data-placement="whale">Give to Whale</button>
    </div>

    <fieldset class="answer-choices" data-strawberry-choices hidden>
      <legend>Do you like strawberries?</legend>
      <div>
        <button type="button" data-strawberry-answer="yes">Yes.</button>
        <button type="button" data-strawberry-answer="never-tried">Never tried one.</button>
        <button type="button" data-strawberry-answer="no">No.</button>
      </div>
    </fieldset>

    <form class="name-form" data-name-form hidden novalidate>
      <label for="workshop-name">Name</label>
      <div>
        <input
          id="workshop-name"
          name="name"
          type="text"
          autocomplete="name"
          enterkeyhint="done"
          dir="auto"
          aria-describedby="workshop-name-error"
        />
        <button type="submit">Tell them</button>
      </div>
      <p id="workshop-name-error" data-name-error aria-live="polite"></p>
    </form>

    <button
      class="voice-toggle"
      type="button"
      data-voice-toggle
      aria-pressed="false"
      aria-label="Turn character voices on"
    >
      <span class="voice-toggle__mark" aria-hidden="true"></span>
      <span data-voice-toggle-label>Hear voices</span>
    </button>

    <output class="visually-hidden" data-prologue-live aria-live="polite"></output>
  </div>
</section>

<script>
  import {
    littleWorkshopPrologue,
    objectReuseDialogue,
    type PrologueActionCue,
    type PrologueBeat,
    type PrologueBranch,
    type PrologueInteraction,
    type ProloguePlacement,
  } from '../data/little-workshop-prologue';
  import {
    communicationLevelForInteractionCount,
    createInitialState,
    loadState,
    normalizePlayerName,
    recordName,
    recordObjectReuse,
    recordPlacement,
    recordStrawberry,
    resetState,
    saveState,
    type ChoiceKind,
    type LittleWorkshopState,
  } from '../scripts/little-workshop-state';
  import {
    createLittleWorkshopVoiceEngine,
    type VoiceEngineState,
    type VoicePlaybackResult,
    type VoiceSpeaker,
  } from '../scripts/little-workshop-voice';
  import { createLittleWorkshopFrameAnimationEngine } from '../scripts/little-workshop-frame-animation';

  type RuntimePhase =
    | 'booting'
    | 'introduction'
    | 'awaiting-object'
    | 'awaiting-placement'
    | 'acting'
    | 'dialogue'
    | 'awaiting-strawberry'
    | 'awaiting-name'
    | 'complete';

  type WorkshopElement = HTMLElement & {
    __disposePrologue?: () => void;
  };

  type SelectedObject = {
    id: string;
    label: string;
    isCurrent: boolean;
  };

  const workshop = document.querySelector<WorkshopElement>('[data-prologue]');
  if (!workshop) throw new Error('Little Workshop prologue failed to initialize');
  workshop.__disposePrologue?.();

  const must = <ElementType extends Element>(selector: string): ElementType => {
    const element = workshop.querySelector<ElementType>(selector);
    if (!element) throw new Error('Missing Little Workshop element: ' + selector);
    return element;
  };

  const stage = must<HTMLElement>('[data-prologue-stage]');
  const objectAnchor = must<HTMLElement>('[data-object-anchor]');
  const objectLabel = must<HTMLElement>('[data-object-label]');
  const objectDrawer = must<HTMLFieldSetElement>('[data-object-drawer]');
  const objectDrawerRail = must<HTMLElement>('[data-object-drawer-rail]');
  const objectDrawerStatus = must<HTMLElement>('[data-object-drawer-status]');
  const objectChoices = Array.from(
    objectDrawer.querySelectorAll<HTMLInputElement>('[data-object-choice]'),
  );
  const placementControls = must<HTMLElement>('[data-placement-controls]');
  const placementButtons = Array.from(
    placementControls.querySelectorAll<HTMLButtonElement>('[data-placement]'),
  );
  const strawberryChoices = must<HTMLFieldSetElement>('[data-strawberry-choices]');
  const strawberryButtons = Array.from(
    strawberryChoices.querySelectorAll<HTMLButtonElement>('[data-strawberry-answer]'),
  );
  const nameForm = must<HTMLFormElement>('[data-name-form]');
  const nameInput = must<HTMLInputElement>('#workshop-name');
  const nameError = must<HTMLElement>('[data-name-error]');
  const voiceToggle = must<HTMLButtonElement>('[data-voice-toggle]');
  const voiceToggleLabel = must<HTMLElement>('[data-voice-toggle-label]');
  const live = must<HTMLOutputElement>('[data-prologue-live]');
  const pyotter = must<HTMLElement>('[data-character="pyotter"]');
  const mikwhale = must<HTMLElement>('[data-character="mikwhale"]');
  const characterElements = { pyotter, mikwhale };
  const dialogueElements = {
    pyotter: must<HTMLElement>('[data-dialogue="pyotter"]'),
    mikwhale: must<HTMLElement>('[data-dialogue="mikwhale"]'),
  };
  const dialogueTextElements = {
    pyotter: must<HTMLElement>('[data-dialogue="pyotter"] [data-dialogue-text]'),
    mikwhale: must<HTMLElement>('[data-dialogue="mikwhale"] [data-dialogue-text]'),
  };
  const objectSpriteElements = Array.from(
    workshop.querySelectorAll<HTMLImageElement>('[data-object-sprite]'),
  );

  const abortController = new AbortController();
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const query = new URLSearchParams(window.location.search);
  const debugEnabled =
    query.has('debug') ||
    window.location.hostname === '127.0.0.1' ||
    window.location.hostname === 'localhost';
  const requestedDebugSpeed = Number(query.get('speed'));
  workshop.dataset.debugEnabled = String(debugEnabled);
  const placementValues = new Set<ProloguePlacement>(['otter', 'middle', 'whale']);
  const testTargets: Partial<Record<number, ProloguePlacement>> = {
    44: 'otter',
    45: 'middle',
    46: 'whale',
  };
  const experimentObjects = new Set([
    'ball',
    'block',
    'string',
    'hammer',
    'battery',
    'lamp',
    'magnet',
    'pencil',
  ]);
  const technologyObjects = new Set(['battery', 'lamp', 'magnet']);
  const canonicalObjectId = (objectId: string) =>
    objectId === 'book-copy' ? 'book' : objectId;
  const objectChoiceById = new Map(
    objectChoices.map((choice) => [choice.value, choice] as const),
  );

  let currentInteraction: PrologueInteraction | null = null;
  let runtimePhase: RuntimePhase = 'booting';
  let runToken = 0;
  let timeScale =
    debugEnabled && Number.isFinite(requestedDebugSpeed)
      ? Math.max(0, Math.min(4, requestedDebugSpeed))
      : 1;
  let activeWait: (() => void) | null = null;
  let restoreFocus = false;
  let restoreObjectFocus = false;
  let objectFocusId: string | null = null;
  let selectedObject: SelectedObject | null = null;
  let currentSetupPlayed = false;
  let debugObserver: MutationObserver | null = null;

  const updateVoiceControl = (status?: VoiceEngineState) => {
    const preferences = voiceEngine.getPreferences();
    const supported = voiceEngine.isSupported();
    const currentStatus = status ?? voiceEngine.getStatus();
    const enabled = preferences.enabled && supported;
    voiceToggle.setAttribute('aria-pressed', String(enabled));
    voiceToggle.disabled = currentStatus === 'disposed';
    voiceToggleLabel.textContent = !supported
      ? 'Voices unavailable'
      : enabled
        ? 'Voices on'
        : 'Hear voices';
    voiceToggle.setAttribute(
      'aria-label',
      !supported
        ? 'Character voices are unavailable in this browser'
        : enabled
          ? 'Turn character voices off'
          : 'Turn character voices on',
    );
    workshop.dataset.voiceState = currentStatus;
  };

  const frameAnimationEngine = createLittleWorkshopFrameAnimationEngine({
    root: workshop,
    reducedMotionQuery: reducedMotion,
    seed: 0x50594f54,
    onStateChange: (state) => {
      workshop.dataset.animationState = state;
    },
    onVariantStart: ({ character, variant }) => {
      characterElements[character].dataset.idleVariant = variant.id;
    },
  });
  const voiceEngine = createLittleWorkshopVoiceEngine();
  voiceEngine.setHooks({
    onStatus: ({ state }) => updateVoiceControl(state),
    onUtteranceStart: (event) => {
      frameAnimationEngine.startSpeech(event);
    },
    onViseme: (event) => {
      frameAnimationEngine.viseme(event);
    },
    onUtteranceEnd: (event) => {
      frameAnimationEngine.endSpeech(event);
    },
  });
  updateVoiceControl();
  workshop.dataset.animationState = frameAnimationEngine.start();

  if (debugEnabled) {
    workshop.dataset.debugSpeed = String(timeScale);
    debugObserver = new MutationObserver(() => {
      const requestedScale = Number(workshop.dataset.debugSpeed ?? '1');
      timeScale = Number.isFinite(requestedScale)
        ? Math.max(0, Math.min(4, requestedScale))
        : 1;
      if (timeScale === 0) activeWait?.();
    });
    debugObserver.observe(workshop, {
      attributes: true,
      attributeFilter: ['data-debug-speed'],
    });
  }

  const setPhase = (phase: RuntimePhase) => {
    runtimePhase = phase;
    workshop.dataset.phase = phase;
    workshop.setAttribute(
      'aria-busy',
      String(
        phase === 'acting',
      ),
    );
  };

  const beginRun = () => {
    runToken += 1;
    activeWait?.();
    activeWait = null;
    voiceEngine.cancel('cancelled');
    frameAnimationEngine.cancelSpeech();
    return runToken;
  };

  const wait = (milliseconds: number) =>
    new Promise<void>((resolve) => {
      const scaled = Math.max(0, milliseconds * timeScale);
      if (scaled === 0) {
        window.requestAnimationFrame(() => resolve());
        return;
      }
      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        window.clearTimeout(timer);
        if (activeWait === finish) activeWait = null;
        resolve();
      };
      const timer = window.setTimeout(finish, scaled);
      activeWait = finish;
    });

  const setDrawerEnabled = (enabled: boolean) => {
    objectDrawer.disabled = !enabled;
    for (const choice of objectChoices) choice.disabled = !enabled;
  };

  const hideActionInputs = () => {
    placementControls.hidden = true;
    strawberryChoices.hidden = true;
    nameForm.hidden = true;
    for (const button of placementButtons) button.disabled = true;
    for (const button of strawberryButtons) button.disabled = true;
  };

  const hideInputs = () => {
    hideActionInputs();
    objectDrawer.hidden = true;
    setDrawerEnabled(false);
  };

  const clearDialogue = () => {
    for (const id of ['pyotter', 'mikwhale'] as const) {
      dialogueElements[id].hidden = true;
      dialogueTextElements[id].textContent = '';
      characterElements[id].classList.remove('is-speaking');
    }
  };

  const clearObject = () => {
    for (const sprite of objectSpriteElements) sprite.hidden = true;
    objectAnchor.hidden = true;
    objectAnchor.removeAttribute('data-placement');
    objectAnchor.classList.remove('is-arriving', 'is-handled');
    objectAnchor.setAttribute('aria-label', 'No object selected');
    objectLabel.textContent = '';
  };

  const setObject = (objectId: string, label: string) => {
    const spriteId = canonicalObjectId(objectId);
    for (const sprite of objectSpriteElements) {
      sprite.hidden = sprite.dataset.objectSprite !== spriteId;
    }
    objectAnchor.hidden = false;
    objectAnchor.removeAttribute('data-placement');
    objectAnchor.setAttribute('aria-label', label);
    objectLabel.textContent = label;
    objectAnchor.classList.remove('is-arriving');
    void objectAnchor.offsetWidth;
    objectAnchor.classList.add('is-arriving');
  };

  const announceBeat = (beat: PrologueBeat): VoicePlaybackResult => {
    const id = beat.speaker;
    dialogueTextElements[id].textContent = beat.text;
    dialogueElements[id].hidden = false;
    characterElements[id].classList.add('is-speaking');
    live.textContent = beat.label + ': ' + beat.text;
    return voiceEngine.speak(id, beat.text);
  };

  const beatDuration = (beat: PrologueBeat) =>
    Math.max(1800, Math.min(4200, 900 + beat.text.length * 27));

  const playBeats = async (
    beats: readonly PrologueBeat[],
    token: number,
  ): Promise<boolean> => {
    for (const beat of beats) {
      if (token !== runToken) return false;
      const speech = announceBeat(beat);
      const speechDuration = speech.started ? speech.plan.totalDurationMs + 80 : 0;
      await wait(Math.max(beatDuration(beat), speechDuration));
      characterElements[beat.speaker].classList.remove('is-speaking');
    }
    return token === runToken;
  };

  const stateValue = (state: LittleWorkshopState, key: string | undefined): unknown => {
    if (!key) return undefined;
    for (const section of [
      state.PLAYER_STATE,
      state.PREFERENCES,
      state.RELATIONSHIP,
      state.HISTORY,
      state.WORLD,
    ]) {
      if (key in section) return (section as unknown as Record<string, unknown>)[key];
    }
    return undefined;
  };

  const stateBranchMatches = (
    branch: PrologueBranch,
    state: LittleWorkshopState,
  ) => {
    if (branch.when.source !== 'state') return false;
    const actual = stateValue(state, branch.when.key);
    if (branch.when.operator === 'equals') return Object.is(actual, branch.when.value);
    return false;
  };

  const matchingStateBranch = (
    interaction: PrologueInteraction,
    state: LittleWorkshopState,
  ) => interaction.branches?.find((branch) => stateBranchMatches(branch, state));

  const unlockedObjectIds = (interactionCount: number) =>
    Array.from(
      new Set(
        littleWorkshopPrologue
          .slice(0, Math.min(interactionCount + 1, 48))
          .map((interaction) => canonicalObjectId(interaction.object.id)),
      ),
    );

  const updateDrawerSelection = (objectId: string | null, label?: string) => {
    for (const choice of objectChoices) choice.checked = choice.value === objectId;
    objectDrawerStatus.textContent = objectId && label ? `Selected: ${label}` : 'Choose one';
  };

  const showObjectDrawer = (
    interaction: PrologueInteraction,
    state: LittleWorkshopState,
  ) => {
    const currentId = canonicalObjectId(interaction.object.id);
    const unlocked = new Set(unlockedObjectIds(state.PLAYER_STATE.interaction_count));
    for (const choice of objectChoices) {
      const slot = choice.closest<HTMLElement>('[data-object-drawer-slot]');
      if (slot) slot.hidden = !unlocked.has(choice.value);
      const isCurrent = choice.value === currentId;
      if (isCurrent) choice.dataset.current = 'true';
      else delete choice.dataset.current;
      const label = choice.dataset.objectName ?? choice.value;
      choice.setAttribute(
        'aria-label',
        isCurrent ? `${label}. Next object.` : label,
      );
    }

    selectedObject = null;
    updateDrawerSelection(null);
    clearObject();
    objectDrawer.hidden = false;
    setDrawerEnabled(true);
    setPhase('awaiting-object');

    const focusId = objectFocusId ?? currentId;
    const choice = objectChoiceById.get(focusId);
    const tile = choice?.nextElementSibling as HTMLElement | null;
    window.requestAnimationFrame(() => {
      if (tile) {
        const railRect = objectDrawerRail.getBoundingClientRect();
        const tileRect = tile.getBoundingClientRect();
        const centeredLeft =
          objectDrawerRail.scrollLeft +
          tileRect.left +
          tileRect.width / 2 -
          railRect.left -
          railRect.width / 2;
        objectDrawerRail.scrollTo({
          behavior: reducedMotion.matches ? 'auto' : 'smooth',
          left: Math.max(0, centeredLeft),
        });
      }
      if (restoreObjectFocus) choice?.focus({ preventScroll: true });
      restoreObjectFocus = false;
      objectFocusId = null;
    });
  };

  const showPlacementControls = () => {
    placementControls.hidden = false;
    for (const button of placementButtons) {
      button.disabled = false;
      const placement = button.dataset.placement;
      const label = selectedObject?.label ?? 'object';
      const action =
        placement === 'otter'
          ? `Give ${label} to Otter`
          : placement === 'whale'
            ? `Give ${label} to Whale`
            : `Set ${label} between them`;
      button.setAttribute('aria-label', action);
    }
    setDrawerEnabled(true);
    setPhase('awaiting-placement');
  };

  const showInteractionInput = (interaction: PrologueInteraction) => {
    if (interaction.input?.kind === 'placement-choice') {
      strawberryChoices.hidden = false;
      for (const button of strawberryButtons) button.disabled = false;
      setPhase('awaiting-strawberry');
      if (restoreFocus) strawberryButtons[0]?.focus();
      restoreFocus = false;
      return;
    }
    if (interaction.input?.kind === 'free-text') {
      nameForm.hidden = false;
      nameError.textContent = '';
      setPhase('awaiting-name');
      nameInput.focus();
      return;
    }
    showPlacementControls();
  };

  const clearMotionClasses = () => {
    for (const character of [pyotter, mikwhale]) {
      character.classList.remove(
        'is-acting',
        'is-thinking',
        'is-bright',
        'is-paused',
      );
    }
    objectAnchor.classList.remove('is-handled');
  };

  const cueMotionClass = (action: string) => {
    const normalized = action.toLowerCase();
    if (/freeze|wait|still|rest|pause/.test(normalized)) return 'is-paused';
    if (/inspect|audit|think|consider|measure|mark|record|compare/.test(normalized)) {
      return 'is-thinking';
    }
    if (/ring|start|bounce|offer|share|smile|laugh|excited|nod|catch/.test(normalized)) {
      return 'is-bright';
    }
    return 'is-acting';
  };

  const playActionCues = async (
    cues: readonly PrologueActionCue[],
    token: number,
  ) => {
    clearMotionClasses();
    for (const cue of cues) {
      const targets =
        cue.actor === 'both'
          ? [pyotter, mikwhale]
          : cue.actor === 'environment'
            ? []
            : [characterElements[cue.actor]];
      for (const target of targets) target.classList.add(cueMotionClass(cue.action));
    }
    objectAnchor.classList.add('is-handled');
    await wait(reducedMotion.matches ? 40 : 2200);
    if (token === runToken) clearMotionClasses();
  };

  const deriveChoiceKinds = (
    interaction: PrologueInteraction,
    placement: ProloguePlacement,
  ): ChoiceKind[] => {
    const choices = new Set<ChoiceKind>();
    const objectId = interaction.object.id.replace('-copy', '');
    if (placement === 'middle') choices.add('sharing');
    if (placement === 'whale') {
      choices.add('autonomy');
      choices.add('distributed_solution');
    }
    if (
      placement === 'otter' &&
      ['apple', 'book', 'seed', 'cookie', 'flower'].includes(objectId)
    ) {
      choices.add('sharing');
    }
    if (experimentObjects.has(objectId)) choices.add('experimentation');
    if (technologyObjects.has(objectId)) choices.add('automation');
    if (technologyObjects.has(objectId) && placement === 'otter') {
      choices.add('centralized_solution');
    }
    if (technologyObjects.has(objectId) && placement !== 'otter') {
      choices.add('distributed_solution');
    }
    return Array.from(choices);
  };

  const interpolateObject = (beats: readonly PrologueBeat[], label: string) =>
    beats.map((beat) => ({
      ...beat,
      text: beat.text.replaceAll('{{object}}', label.toLocaleLowerCase()),
    }));

  const selectObject = async (objectId: string) => {
    if (
      (runtimePhase !== 'awaiting-object' && runtimePhase !== 'awaiting-placement') ||
      !currentInteraction ||
      currentInteraction.sequence > 48
    ) {
      return;
    }
    const choice = objectChoiceById.get(canonicalObjectId(objectId));
    const slot = choice?.closest<HTMLElement>('[data-object-drawer-slot]');
    if (!choice || choice.disabled || slot?.hidden) return;

    const interaction = currentInteraction;
    const selectedId = canonicalObjectId(choice.value);
    const isCurrent = selectedId === canonicalObjectId(interaction.object.id);
    const label = isCurrent
      ? interaction.object.label
      : (choice.dataset.objectName ?? choice.value);
    const token = beginRun();
    selectedObject = { id: selectedId, label, isCurrent };
    hideActionInputs();
    setDrawerEnabled(false);
    clearDialogue();
    updateDrawerSelection(selectedId, label);
    setObject(selectedId, label);
    setPhase('introduction');

    if (isCurrent && !currentSetupPlayed) {
      const state = loadState();
      const branch = matchingStateBranch(interaction, state);
      const setupBeats = branch
        ? [...interaction.setup, ...branch.beats]
        : interaction.setup;
      if (!(await playBeats(setupBeats, token))) return;
      currentSetupPlayed = true;
    } else if (!isCurrent) {
      const awareness = loadState().PLAYER_STATE.communication_level >= 3 ? 'aware' : 'unaware';
      const beats = interpolateObject(objectReuseDialogue.setup[awareness], label);
      if (!(await playBeats(beats, token))) return;
    }

    if (token !== runToken) return;
    showPlacementControls();
    live.textContent = `${label} selected. Choose where to place it.`;
  };

  const renderCompleteState = (state: LittleWorkshopState) => {
    const name = state.PLAYER_STATE.name ?? 'you';
    workshop.dataset.sequence = '50';
    workshop.dataset.interactionId = 'name-exchange';
    hideInputs();
    clearDialogue();
    setObject('paper', 'Name Paper');
    dialogueTextElements.pyotter.textContent = name + '.';
    dialogueTextElements.mikwhale.textContent = 'Fair.';
    dialogueElements.pyotter.hidden = false;
    dialogueElements.mikwhale.hidden = false;
    pyotter.classList.add('is-looking-outward');
    mikwhale.classList.add('is-looking-outward');
    live.textContent = 'Pyotter and Mikwhale know your name. The prologue is complete.';
    setPhase('complete');
  };

  const renderCurrentInteraction = async () => {
    const token = beginRun();
    hideInputs();
    clearObject();
    clearMotionClasses();
    pyotter.classList.remove('is-looking-outward');
    mikwhale.classList.remove('is-looking-outward');
    clearDialogue();
    const state = loadState();
    if (state.PLAYER_STATE.interaction_count >= littleWorkshopPrologue.length) {
      renderCompleteState(state);
      return;
    }

    const interaction = littleWorkshopPrologue[state.PLAYER_STATE.interaction_count];
    currentInteraction = interaction;
    selectedObject = null;
    currentSetupPlayed = false;
    workshop.dataset.sequence = String(interaction.sequence);
    workshop.dataset.interactionId = interaction.id;

    if (interaction.sequence <= 48 && !interaction.input) {
      showObjectDrawer(interaction, state);
      return;
    }

    setObject(interaction.object.id, interaction.object.label);
    setPhase('introduction');
    const branch = matchingStateBranch(interaction, state);
    const setupBeats = branch
      ? [...interaction.setup, ...branch.beats]
      : interaction.setup;
    if (!(await playBeats(setupBeats, token))) return;
    if (token !== runToken) return;
    showInteractionInput(interaction);
  };

  const choosePlacement = async (placement: ProloguePlacement) => {
    if (runtimePhase !== 'awaiting-placement' || !currentInteraction || !selectedObject) return;
    const interaction = currentInteraction;
    const object = selectedObject;
    const token = beginRun();
    hideActionInputs();
    setDrawerEnabled(false);
    setPhase('acting');
    objectAnchor.dataset.placement = placement;
    const outcome = object.isCurrent
      ? interaction.placements[placement]
      : objectReuseDialogue.placements[placement];
    await playActionCues(outcome.actionCues, token);
    if (token !== runToken) return;
    setPhase('dialogue');
    if (!(await playBeats(outcome.beats, token))) return;
    if (token !== runToken) return;

    if (object.isCurrent) {
      const expectedTarget = testTargets[interaction.sequence];
      const authoredOutcome = interaction.placements[placement];
      recordPlacement({
        target: placement,
        object_id: interaction.object.id,
        choices: deriveChoiceKinds(interaction, placement),
        state_effects: authoredOutcome.stateEffects,
        test_response: expectedTarget
          ? expectedTarget === placement
            ? 'complied'
            : 'resisted'
          : undefined,
      });
      restoreObjectFocus = interaction.sequence < 48;
      restoreFocus = interaction.sequence === 48;
      objectFocusId = null;
    } else {
      recordObjectReuse({ target: placement, object_id: object.id });
      restoreObjectFocus = true;
      objectFocusId = object.id;
    }
    await wait(350);
    if (token === runToken) void renderCurrentInteraction();
  };

  const answerStrawberry = async (answer: string) => {
    if (
      runtimePhase !== 'awaiting-strawberry' ||
      !currentInteraction ||
      currentInteraction.input?.kind !== 'placement-choice'
    ) {
      return;
    }
    const option = currentInteraction.input.options.find((item) => item.value === answer);
    if (!option) return;
    const interaction = currentInteraction;
    const token = beginRun();
    restoreFocus = true;
    hideInputs();
    setPhase('acting');
    objectAnchor.dataset.placement = option.placement;
    const outcome = interaction.placements[option.placement];
    await playActionCues(outcome.actionCues, token);
    if (token !== runToken) return;
    setPhase('dialogue');
    if (!(await playBeats(outcome.beats, token))) return;
    if (token !== runToken) return;
    recordStrawberry(option.value, undefined, outcome.stateEffects);
    await wait(350);
    if (token === runToken) void renderCurrentInteraction();
  };

  const interpolateName = (text: string, name: string) =>
    text.replaceAll('{{observerName}}', name);

  const nameBranch = (
    interaction: PrologueInteraction,
    name: string,
  ): PrologueBranch | undefined => {
    const branches = interaction.branches ?? [];
    const lowerName = name.toLocaleLowerCase();
    const matching = branches.find((branch) => {
      if (branch.when.source !== 'input' || branch.when.operator !== 'matches') return false;
      if (!Array.isArray(branch.when.value)) return false;
      return branch.when.value.some(
        (value) => typeof value === 'string' && value.toLocaleLowerCase() === lowerName,
      );
    });
    return (
      matching ??
      branches.find(
        (branch) =>
          branch.when.source === 'input' && branch.when.operator === 'default',
      )
    );
  };

  const submitName = async () => {
    if (
      runtimePhase !== 'awaiting-name' ||
      !currentInteraction ||
      currentInteraction.input?.kind !== 'free-text'
    ) {
      return;
    }
    const normalized = normalizePlayerName(nameInput.value);
    if (!normalized) {
      nameError.textContent = 'A name needs at least one visible character.';
      nameInput.focus();
      return;
    }

    const interaction = currentInteraction;
    const branch = nameBranch(interaction, normalized);
    const token = beginRun();
    hideInputs();
    setPhase('dialogue');
    if (branch?.actionCues) await playActionCues(branch.actionCues, token);
    if (token !== runToken) return;
    const beats = (branch?.beats ?? []).map((beat) => ({
      ...beat,
      text: interpolateName(beat.text, normalized),
    }));
    if (!(await playBeats(beats, token))) return;
    if (token !== runToken) return;
    recordName(normalized, undefined, branch?.stateEffects);
    pyotter.classList.add('is-looking-outward');
    mikwhale.classList.add('is-looking-outward');
    live.textContent = 'Pyotter and Mikwhale know your name. The prologue is complete.';
    setPhase('complete');
  };

  const unlockVoiceFromGesture = () => {
    if (!voiceEngine.getPreferences().enabled) return;
    void voiceEngine.unlockFromGesture();
  };

  voiceToggle.addEventListener(
    'click',
    () => {
      const enable = !voiceEngine.getPreferences().enabled;
      voiceEngine.setEnabled(enable);
      if (enable) unlockVoiceFromGesture();
      else frameAnimationEngine.cancelSpeech();
      updateVoiceControl();
    },
    { signal: abortController.signal },
  );

  for (const button of placementButtons) {
    button.addEventListener(
      'click',
      () => {
        unlockVoiceFromGesture();
        const placement = button.dataset.placement;
        if (placementValues.has(placement as ProloguePlacement)) {
          void choosePlacement(placement as ProloguePlacement);
        }
      },
      { signal: abortController.signal },
    );
  }

  for (const choice of objectChoices) {
    choice.addEventListener(
      'change',
      () => {
        unlockVoiceFromGesture();
        if (choice.checked) void selectObject(choice.value);
      },
      { signal: abortController.signal },
    );
  }

  for (const button of strawberryButtons) {
    button.addEventListener(
      'click',
      () => {
        unlockVoiceFromGesture();
        void answerStrawberry(button.dataset.strawberryAnswer ?? '');
      },
      { signal: abortController.signal },
    );
  }

  nameForm.addEventListener(
    'submit',
    (event) => {
      event.preventDefault();
      unlockVoiceFromGesture();
      void submitName();
    },
    { signal: abortController.signal },
  );

  const dispose = () => {
    beginRun();
    abortController.abort();
    debugObserver?.disconnect();
    clearMotionClasses();
    frameAnimationEngine.dispose();
    void voiceEngine.dispose();
    delete workshop.__disposePrologue;
  };
  workshop.__disposePrologue = dispose;
  document.addEventListener('astro:before-swap', dispose, {
    once: true,
    signal: abortController.signal,
  });

  if (debugEnabled) {
    const debugWindow = window as typeof window & {
      __littleWorkshopPrologue?: {
        snapshot: () => unknown;
        setSpeed: (scale: number) => void;
        reset: () => void;
        jumpTo: (sequence: number) => void;
        selectObject: (objectId: string) => void;
        choose: (placement: ProloguePlacement) => void;
        answerStrawberry: (answer: string) => void;
        submitName: (name: string) => void;
      };
    };
    const debugApi = {
      snapshot: () => ({
        phase: runtimePhase,
        sequence: currentInteraction?.sequence ?? null,
        interactionId: currentInteraction?.id ?? null,
        selectedObject,
        voice: {
          status: voiceEngine.getStatus(),
          preferences: voiceEngine.getPreferences(),
          pyotterFrame:
            workshop.querySelector<HTMLElement>('[data-frame-character="pyotter"]')?.dataset.frame ??
            'neutral',
          mikwhaleFrame:
            workshop.querySelector<HTMLElement>('[data-frame-character="mikwhale"]')?.dataset.frame ??
            'neutral',
        },
        idle: {
          status: frameAnimationEngine.getState(),
          pyotter: frameAnimationEngine.getCurrentVariant('pyotter')?.id ?? null,
          mikwhale: frameAnimationEngine.getCurrentVariant('mikwhale')?.id ?? null,
        },
        state: loadState(),
      }),
      setSpeed: (scale) => {
        timeScale = Number.isFinite(scale) ? Math.max(0, Math.min(4, scale)) : 1;
        if (timeScale === 0) activeWait?.();
      },
      reset: () => {
        resetState();
        void renderCurrentInteraction();
      },
      jumpTo: (sequence) => {
        const nextSequence = Math.max(1, Math.min(50, Math.floor(sequence)));
        const state = createInitialState();
        state.PLAYER_STATE.interaction_count = nextSequence - 1;
        state.PLAYER_STATE.communication_level =
          communicationLevelForInteractionCount(nextSequence - 1);
        state.WORLD.communication_protocol.current_level =
          state.PLAYER_STATE.communication_level;
        saveState(state);
        void renderCurrentInteraction();
      },
      selectObject: (objectId) => void selectObject(objectId),
      choose: (placement) => void choosePlacement(placement),
      answerStrawberry: (answer) => void answerStrawberry(answer),
      submitName: (name) => {
        nameInput.value = name;
        void submitName();
      },
    };
    Object.defineProperty(debugWindow, '__littleWorkshopPrologue', {
      configurable: true,
      value: debugApi,
      writable: true,
    });
  }

  if (debugEnabled && query.get('reset') === '1') resetState();
  const requestedDebugStep = Number(query.get('step'));
  if (
    debugEnabled &&
    Number.isInteger(requestedDebugStep) &&
    requestedDebugStep >= 1 &&
    requestedDebugStep <= 50
  ) {
    const state = createInitialState();
    state.PLAYER_STATE.interaction_count = requestedDebugStep - 1;
    state.PLAYER_STATE.communication_level =
      communicationLevelForInteractionCount(requestedDebugStep - 1);
    state.WORLD.communication_protocol.current_level =
      state.PLAYER_STATE.communication_level;
    saveState(state);
  }

  void renderCurrentInteraction();
</script>

