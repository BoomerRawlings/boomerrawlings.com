                        </g>
                      </g>
                    </g>
                  </g>

                  <g class="puppet__part puppet__part--tail" data-part="tail" data-idle-part="tail" data-pivot="618.5 1030" data-idle-origin="618.5px 1030px" style="--part-pivot: 618.5px 1030px">
                    <g class="puppet__voice-layer" data-voice-part="tail" data-voice-origin="618.5px 1030px">
                      <g class="puppet__paint" clip-path="url(#mikwhale-clip-tail)"><use href="#mikwhale-rig-paint" /></g>
                      <g class="puppet__part puppet__part--foot" data-part="foot-left" data-idle-part="foot-left" data-pivot="565 1137" data-idle-origin="565px 1137px" style="--part-pivot: 565px 1137px">
                        <g class="puppet__voice-layer" data-voice-part="foot-left" data-voice-origin="565px 1137px">
                          <g class="puppet__paint" clip-path="url(#mikwhale-clip-foot-left)"><use href="#mikwhale-rig-paint" /></g>
                        </g>
                      </g>
                      <g class="puppet__part puppet__part--foot" data-part="foot-right" data-idle-part="foot-right" data-pivot="672 1137" data-idle-origin="672px 1137px" style="--part-pivot: 672px 1137px">
                        <g class="puppet__voice-layer" data-voice-part="foot-right" data-voice-origin="672px 1137px">
                          <g class="puppet__paint" clip-path="url(#mikwhale-clip-foot-right)"><use href="#mikwhale-rig-paint" /></g>
