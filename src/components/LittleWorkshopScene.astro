---
import pyotterImage from '../assets/companions/scene/pyotter-front-transparent-v1.png';
import mikwhaleImage from '../assets/mikwhale/reference/mikwhale-master-transparent.png';
import PyotterPuppet from './PyotterPuppet.astro';
import MikwhalePuppet from './MikwhalePuppet.astro';
import appleImage from '../assets/companions/objects/apple-v1.png';
import ballImage from '../assets/companions/objects/ball-v1.png';
import batteryImage from '../assets/companions/objects/battery-v1.png';
import bellImage from '../assets/companions/objects/bell-v1.png';
import blockImage from '../assets/companions/objects/block-v1.png';
import bookImage from '../assets/companions/objects/book-v1.png';
import boxImage from '../assets/companions/objects/box-v1.png';
import coinImage from '../assets/companions/objects/coin-v1.png';
import cookieImage from '../assets/companions/objects/cookie-v1.png';
import cupImage from '../assets/companions/objects/cup-v1.png';
import flowerImage from '../assets/companions/objects/flower-v1.png';
import hammerImage from '../assets/companions/objects/hammer-v1.png';
import keyImage from '../assets/companions/objects/key-v1.png';
import lampImage from '../assets/companions/objects/lamp-v1.png';
import magnetImage from '../assets/companions/objects/magnet-v1.png';
import paperImage from '../assets/companions/objects/paper-v1.png';
import pencilImage from '../assets/companions/objects/pencil-v1.png';
import seedImage from '../assets/companions/objects/seed-v1.png';
import strawberryImage from '../assets/companions/objects/strawberry-v1.png';
import stringImage from '../assets/companions/objects/string-v1.png';

const objectSprites = [
  { id: 'apple', label: 'Apple', image: appleImage },
  { id: 'ball', label: 'Ball', image: ballImage },
  { id: 'flower', label: 'Flower', image: flowerImage },
  { id: 'cup', label: 'Cup', image: cupImage },
  { id: 'book', label: 'Book', image: bookImage },
  { id: 'cookie', label: 'Cookie', image: cookieImage },
  { id: 'pencil', label: 'Pencil', image: pencilImage },
  { id: 'paper', label: 'Paper', image: paperImage },
  { id: 'block', label: 'Block', image: blockImage },
  { id: 'string', label: 'String', image: stringImage },
  { id: 'key', label: 'Key', image: keyImage },
  { id: 'coin', label: 'Coin', image: coinImage },
  { id: 'seed', label: 'Seed', image: seedImage },
  { id: 'box', label: 'Box', image: boxImage },
  { id: 'hammer', label: 'Hammer', image: hammerImage },
  { id: 'battery', label: 'Battery', image: batteryImage },
  { id: 'lamp', label: 'Lamp', image: lampImage },
  { id: 'magnet', label: 'Magnet', image: magnetImage },
  { id: 'bell', label: 'Bell', image: bellImage },
  { id: 'strawberry', label: 'Strawberry', image: strawberryImage },
] as const;
---

<section class="prologue" data-prologue aria-labelledby="prologue-title">
  <div class="prologue__stage" data-prologue-stage>
    <header class="workshop-welcome">
      <div class="workshop-welcome__float">
        <div class="workshop-welcome__plaque">
          <span class="workshop-welcome__leaf" aria-hidden="true">
            <span></span>
          </span>

          <div class="workshop-welcome__copy">
            <p class="workshop-welcome__kicker">Welcome to</p>
            <h1 id="prologue-title">
              <span>The Little</span>{' '}<span>Workshop</span>
            </h1>
            <p class="workshop-welcome__tagline">Tiny friends. Big ideas. Plenty to share.</p>
          </div>

          <span class="workshop-welcome__ripples" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </div>
      </div>
    </header>

    <article class="character character--pyotter" data-character="pyotter">
      <aside class="dialogue" data-dialogue="pyotter" hidden>
        <strong>Otter</strong>
        <p data-dialogue-text></p>
      </aside>
      <figure>
        <div class="character__art">
          <div class="character__performance" data-performance="pyotter">
            <PyotterPuppet />
            <div class="character__legacy-puppet" hidden aria-hidden="true">
              <svg
                class="character__sprite character__puppet"
                viewBox={`0 0 ${pyotterImage.width} ${pyotterImage.height}`}
                role="img"
                aria-labelledby="pyotter-portrait-title pyotter-portrait-description"
                preserveAspectRatio="xMidYMid meet"
                shape-rendering="geometricPrecision"
              >
                <title id="pyotter-portrait-title">Pyotter Kropotkin, a tiny brown otter with round gold glasses and an enormous cream-colored ruff</title>
                <desc id="pyotter-portrait-description">An articulated portrait whose face, ruff, paws, body, feet, and tucked tail can move independently.</desc>
                <defs>
                  <image
                    id="pyotter-rig-paint"
                    href={pyotterImage.src}
                    width={pyotterImage.width}
                    height={pyotterImage.height}
                    preserveAspectRatio="none"
                  />
                  <clipPath id="pyotter-clip-tail" clipPathUnits="userSpaceOnUse">
                    <path d="M 244 347 C 277 350 298 376 301 409 C 303 431 293 450 271 461 L 238 458 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-torso" clipPathUnits="userSpaceOnUse">
                    <path d="M 92 317 C 77 345 69 380 71 414 C 73 448 91 469 126 474 L 244 474 C 278 469 296 448 298 414 C 300 380 292 345 277 317 L 256 302 L 112 302 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-chest" clipPathUnits="userSpaceOnUse">
                    <path d="M 78 242 C 102 230 267 230 291 242 L 288 336 C 258 354 111 354 81 336 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-paw-left" clipPathUnits="userSpaceOnUse">
                    <path d="M 77 270 C 96 260 128 269 143 292 C 159 317 159 352 143 373 C 132 388 107 387 91 371 C 73 353 66 291 77 270 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-paw-right" clipPathUnits="userSpaceOnUse">
                    <path d="M 292 270 C 273 260 241 269 226 292 C 210 317 210 352 226 373 C 237 388 262 387 278 371 C 296 353 303 291 292 270 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-foot-left" clipPathUnits="userSpaceOnUse">
                    <path d="M 72 444 C 91 435 137 436 155 450 C 166 459 158 481 144 486 L 93 486 C 75 482 68 457 72 444 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-foot-right" clipPathUnits="userSpaceOnUse">
                    <path d="M 297 444 C 278 435 232 436 214 450 C 203 459 211 481 225 486 L 276 486 C 294 482 301 457 297 444 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-ear-left" clipPathUnits="userSpaceOnUse">
                    <path d="M 45 70 H 108 V 145 H 45 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-ear-right" clipPathUnits="userSpaceOnUse">
                    <path d="M 261 70 H 324 V 145 H 261 Z" />
                  </clipPath>
                  <clipPath id="pyotter-clip-head" clipPathUnits="userSpaceOnUse">
                    <path
                      clip-rule="evenodd"
                      d="M 184.5 27 C 121 23 76 65 73 122 C 71 152 82 180 102 198 L 267 198 C 287 180 298 152 296 122 C 293 65 248 23 184.5 27 Z M 124 135 A 23 32 0 1 0 124 199 A 23 32 0 1 0 124 135 Z M 245 135 A 23 32 0 1 0 245 199 A 23 32 0 1 0 245 135 Z M 184.5 163 A 32 29 0 1 0 184.5 221 A 32 29 0 1 0 184.5 163 Z"
                    />
                  </clipPath>
                  <clipPath id="pyotter-clip-eye-left" clipPathUnits="userSpaceOnUse">
                    <ellipse cx="124" cy="167" rx="26" ry="35" />
                  </clipPath>
                  <clipPath id="pyotter-clip-eye-right" clipPathUnits="userSpaceOnUse">
                    <ellipse cx="245" cy="167" rx="26" ry="35" />
                  </clipPath>
                  <clipPath id="pyotter-clip-fur" clipPathUnits="userSpaceOnUse">
                    <path
                      clip-rule="evenodd"
                      d="M 45 166 C 55 151 79 152 99 166 C 122 181 247 181 270 166 C 290 152 314 151 324 166 C 337 187 324 227 306 250 C 283 279 235 289 184.5 302 C 134 289 86 279 63 250 C 45 227 32 187 45 166 Z M 184.5 157 A 49 46 0 1 0 184.5 249 A 49 46 0 1 0 184.5 157 Z"
                    />
                  </clipPath>
                  <clipPath id="pyotter-clip-nose" clipPathUnits="userSpaceOnUse">
                    <path d="M 136 157 H 233 V 249 H 136 Z" />
                  </clipPath>
                </defs>

                <g class="puppet" data-puppet="pyotter" aria-hidden="true">
                  <g class="puppet__part puppet__part--tail" data-part="tail" data-idle-part="tail" data-pivot="254 389" data-idle-origin="254px 389px" style="--part-pivot: 254px 389px">
                    <g class="puppet__voice-layer" data-voice-part="tail" data-voice-origin="254px 389px">
                      <g class="puppet__paint" clip-path="url(#pyotter-clip-tail)"><use href="#pyotter-rig-paint" /></g>
                    </g>
                  </g>

                  <g class="puppet__part puppet__part--torso" data-part="torso" data-idle-part="torso" data-pivot="184.5 459" data-idle-origin="184.5px 459px" style="--part-pivot: 184.5px 459px">
                    <g class="puppet__voice-layer" data-voice-part="torso" data-voice-origin="184.5px 459px">
                      <g class="puppet__paint" clip-path="url(#pyotter-clip-torso)"><use href="#pyotter-rig-paint" /></g>

                      <g class="puppet__part puppet__part--chest" data-part="chest" data-idle-part="chest" data-pivot="184.5 316" data-idle-origin="184.5px 316px" style="--part-pivot: 184.5px 316px">
                        <g class="puppet__voice-layer" data-voice-part="chest" data-voice-origin="184.5px 316px">
                          <g class="puppet__paint" clip-path="url(#pyotter-clip-chest)"><use href="#pyotter-rig-paint" /></g>
                        </g>
                      </g>
                      <g class="puppet__part puppet__part--paw" data-part="paw-left" data-idle-part="paw-left" data-pivot="105 292" data-idle-origin="105px 292px" style="--part-pivot: 105px 292px">
                        <g class="puppet__voice-layer" data-voice-part="paw-left" data-voice-origin="105px 292px">
                          <g class="puppet__paint" clip-path="url(#pyotter-clip-paw-left)"><use href="#pyotter-rig-paint" /></g>
                        </g>
                      </g>
                      <g class="puppet__part puppet__part--paw" data-part="paw-right" data-idle-part="paw-right" data-pivot="264 292" data-idle-origin="264px 292px" style="--part-pivot: 264px 292px">
                        <g class="puppet__voice-layer" data-voice-part="paw-right" data-voice-origin="264px 292px">
                          <g class="puppet__paint" clip-path="url(#pyotter-clip-paw-right)"><use href="#pyotter-rig-paint" /></g>
                        </g>
                      </g>

                      <g class="puppet__part puppet__part--head" data-part="head" data-idle-part="head" data-pivot="184.5 244" data-idle-origin="184.5px 244px" style="--part-pivot: 184.5px 244px">
                        <g class="puppet__voice-layer" data-voice-part="head" data-voice-origin="184.5px 244px">
                          <g class="puppet__part puppet__part--ear" data-part="ear-left" data-idle-part="ear-left" data-pivot="91 118" data-idle-origin="91px 118px" style="--part-pivot: 91px 118px">
                            <g class="puppet__voice-layer" data-voice-part="ear-left" data-voice-origin="91px 118px">
                              <g class="puppet__paint" clip-path="url(#pyotter-clip-ear-left)"><use href="#pyotter-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--ear" data-part="ear-right" data-idle-part="ear-right" data-pivot="278 118" data-idle-origin="278px 118px" style="--part-pivot: 278px 118px">
                            <g class="puppet__voice-layer" data-voice-part="ear-right" data-voice-origin="278px 118px">
                              <g class="puppet__paint" clip-path="url(#pyotter-clip-ear-right)"><use href="#pyotter-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__underpaint" aria-hidden="true">
                            <ellipse cx="124" cy="167" rx="23" ry="32" fill="#f7f0e5" />
                            <ellipse cx="245" cy="167" rx="23" ry="32" fill="#f7f0e5" />
                            <ellipse cx="184.5" cy="192" rx="32" ry="29" fill="#efe2d1" />
                          </g>
                          <g class="puppet__paint" clip-path="url(#pyotter-clip-head)"><use href="#pyotter-rig-paint" /></g>
                          <g class="puppet__part puppet__part--eye" data-part="eye-left" data-idle-part="eye-left" data-pivot="124 167" data-idle-origin="124px 167px" style="--part-pivot: 124px 167px">
                            <g class="puppet__voice-layer" data-voice-part="eye-left" data-voice-origin="124px 167px">
                              <g class="puppet__paint" clip-path="url(#pyotter-clip-eye-left)"><use href="#pyotter-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--eye" data-part="eye-right" data-idle-part="eye-right" data-pivot="245 167" data-idle-origin="245px 167px" style="--part-pivot: 245px 167px">
                            <g class="puppet__voice-layer" data-voice-part="eye-right" data-voice-origin="245px 167px">
                              <g class="puppet__paint" clip-path="url(#pyotter-clip-eye-right)"><use href="#pyotter-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--fur" data-part="fur" data-idle-part="fur" data-pivot="184.5 218" data-idle-origin="184.5px 218px" style="--part-pivot: 184.5px 218px">
                            <g class="puppet__voice-layer" data-voice-part="fur" data-voice-origin="184.5px 218px">
                              <g class="puppet__paint" clip-path="url(#pyotter-clip-fur)"><use href="#pyotter-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--nose" data-part="nose" data-idle-part="nose" data-pivot="184.5 190" data-idle-origin="184.5px 190px" style="--part-pivot: 184.5px 190px">
                            <g class="puppet__voice-layer" data-voice-part="nose" data-voice-origin="184.5px 190px">
                              <g class="puppet__paint" clip-path="url(#pyotter-clip-nose)"><use href="#pyotter-rig-paint" /></g>
                            </g>
                          </g>
                          <g class="puppet__part puppet__part--mouth" data-part="mouth" data-pivot="184.5 216.5" style="--part-pivot: 184.5px 216.5px">
                            <g class="puppet__voice-layer" data-voice-part="mouth" data-voice-origin="184.5px 216.5px">
                              <g transform="translate(184.5 216.5)">
                                <g class="character__mouth" data-mouth="pyotter">
                                  <ellipse class="character__mouth-cavity" rx="20.5" ry="9.5" vector-effect="non-scaling-stroke"></ellipse>
                                  <path class="character__mouth-tongue" d="M -12 4 Q 0 12 12 4 Q 9 13 0 14 Q -9 13 -12 4 Z"></path>
                                </g>
                              </g>
                            </g>
                          </g>
                        </g>
                      </g>
                    </g>
                  </g>

                  <g class="puppet__part puppet__part--foot" data-part="foot-left" data-idle-part="foot-left" data-pivot="119 461" data-idle-origin="119px 461px" style="--part-pivot: 119px 461px">
                    <g class="puppet__voice-layer" data-voice-part="foot-left" data-voice-origin="119px 461px">
                      <g class="puppet__paint" clip-path="url(#pyotter-clip-foot-left)"><use href="#pyotter-rig-paint" /></g>
                    </g>
                  </g>
                  <g class="puppet__part puppet__part--foot" data-part="foot-right" data-idle-part="foot-right" data-pivot="250 461" data-idle-origin="250px 461px" style="--part-pivot: 250px 461px">
                    <g class="puppet__voice-layer" data-voice-part="foot-right" data-voice-origin="250px 461px">
                      <g class="puppet__paint" clip-path="url(#pyotter-clip-foot-right)"><use href="#pyotter-rig-paint" /></g>
                    </g>
                  </g>
                </g>
              </svg>
            </div>
          </div>
        </div>
        <figcaption>Pyotter Kropotkin</figcaption>
      </figure>
    </article>

    <div class="current-object">
      <div
        class="current-object__anchor"
        data-object-anchor
        role="img"
        aria-label="Current object"
        hidden
      >
        <div class="current-object__art">
          {
            objectSprites.map(({ id, image }) => (
              <img
                src={image.src}
                width={image.width}
                height={image.height}
                alt=""
                aria-hidden="true"
                data-object-sprite={id}
                decoding="async"
                hidden
              />
            ))
          }
        </div>
      </div>
      <p data-object-label></p>
    </div>

    <article class="character character--mikwhale" data-character="mikwhale">
      <aside class="dialogue" data-dialogue="mikwhale" hidden>
        <strong>Whale</strong>
        <p data-dialogue-text></p>
      </aside>
      <figure>
        <div class="character__art">
          <div class="character__performance" data-performance="mikwhale">
            <MikwhalePuppet />
            <div class="character__legacy-puppet" hidden aria-hidden="true">
              <svg
                class="character__sprite character__puppet"
                viewBox={`0 0 ${mikwhaleImage.width} ${mikwhaleImage.height}`}
                role="img"
                aria-labelledby="mikwhale-portrait-title mikwhale-portrait-description"
                preserveAspectRatio="xMidYMid meet"
                shape-rendering="geometricPrecision"
              >
                <title id="mikwhale-portrait-title">Mikwhale Bakunin, a small blue whale with wild brown side curls, a huge beard, and a dark cravat</title>
                <desc id="mikwhale-portrait-description">An articulated portrait whose eyes, blowhole, head, curls, beard, flippers, belly, body, flukes, and tail base can move independently.</desc>
                <defs>
                  <image
                    id="mikwhale-rig-paint"
                    href={mikwhaleImage.src}
                    width={mikwhaleImage.width}
                    height={mikwhaleImage.height}
                    preserveAspectRatio="none"
                  />
                  <clipPath id="mikwhale-clip-tail" clipPathUnits="userSpaceOnUse">
                    <path d="M 438 959 C 488 1018 543 1082 618.5 1155 C 694 1082 749 1018 799 959 L 789 1128 L 448 1128 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-torso" clipPathUnits="userSpaceOnUse">
                    <path d="M 303 553 C 252 626 239 754 267 864 C 296 974 366 1057 473 1101 L 531 1027 C 472 937 441 827 445 684 L 398 575 Z" />
                    <path d="M 934 553 C 985 626 998 754 970 864 C 941 974 871 1057 764 1101 L 706 1027 C 765 937 796 827 792 684 L 839 575 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-chest" clipPathUnits="userSpaceOnUse">
                    <path d="M 352 610 C 414 590 823 590 885 610 C 883 739 860 895 802 1009 C 754 1039 696 1051 618.5 1054 C 541 1051 483 1039 435 1009 C 377 895 354 739 352 610 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-paw-left" clipPathUnits="userSpaceOnUse">
                    <path d="M 207 558 C 246 537 321 553 357 612 C 398 679 399 827 342 909 C 313 952 259 951 224 916 C 177 869 179 618 207 558 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-paw-right" clipPathUnits="userSpaceOnUse">
                    <path d="M 1030 558 C 991 537 916 553 880 612 C 839 679 838 827 895 909 C 924 952 978 951 1013 916 C 1060 869 1058 618 1030 558 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-foot-left" clipPathUnits="userSpaceOnUse">
                    <path d="M 302 1061 C 372 1028 529 1053 618.5 1138 C 565 1216 458 1231 349 1210 C 304 1201 282 1092 302 1061 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-foot-right" clipPathUnits="userSpaceOnUse">
                    <path d="M 935 1061 C 865 1028 708 1053 618.5 1138 C 672 1216 779 1231 888 1210 C 933 1201 955 1092 935 1061 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-ear-left" clipPathUnits="userSpaceOnUse">
                    <path d="M 170 58 C 229 47 354 48 414 72 C 398 133 374 211 353 300 C 333 386 354 453 420 484 C 360 527 219 509 174 443 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-ear-right" clipPathUnits="userSpaceOnUse">
                    <path d="M 1067 58 C 1008 47 883 48 823 72 C 839 133 863 211 884 300 C 904 386 883 453 817 484 C 877 527 1018 509 1063 443 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-head" clipPathUnits="userSpaceOnUse">
                    <path
                      clip-rule="evenodd"
                      d="M 618.5 11 C 456 7 347 100 339 263 C 335 346 361 415 416 475 C 482 517 755 517 821 475 C 876 415 902 346 898 263 C 890 100 781 7 618.5 11 Z M 472 312 A 48 57 0 1 0 472 426 A 48 57 0 1 0 472 312 Z M 765 312 A 48 57 0 1 0 765 426 A 48 57 0 1 0 765 312 Z M 618.5 20 A 56 27 0 1 0 618.5 74 A 56 27 0 1 0 618.5 20 Z"
                    />
                  </clipPath>
                  <clipPath id="mikwhale-clip-eye-left" clipPathUnits="userSpaceOnUse">
                    <ellipse cx="472" cy="369" rx="53" ry="62" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-eye-right" clipPathUnits="userSpaceOnUse">
                    <ellipse cx="765" cy="369" rx="53" ry="62" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-fur" clipPathUnits="userSpaceOnUse">
                    <path d="M 257 393 C 319 375 379 407 423 437 C 472 409 535 407 618.5 430 C 702 407 765 409 814 437 C 858 407 918 375 980 393 C 995 471 973 601 911 674 C 844 753 735 769 618.5 771 C 502 769 393 753 326 674 C 264 601 242 471 257 393 Z" />
                  </clipPath>
                  <clipPath id="mikwhale-clip-nose" clipPathUnits="userSpaceOnUse">
                    <ellipse cx="618.5" cy="47" rx="61" ry="31" />
                  </clipPath>
                </defs>

                <g class="puppet" data-puppet="mikwhale" aria-hidden="true">
                  <g class="puppet__part puppet__part--torso" data-part="torso" data-idle-part="torso" data-pivot="618.5 1035" data-idle-origin="618.5px 1035px" style="--part-pivot: 618.5px 1035px">
                    <g class="puppet__voice-layer" data-voice-part="torso" data-voice-origin="618.5px 1035px">
                      <g class="puppet__paint" clip-path="url(#mikwhale-clip-torso)"><use href="#mikwhale-rig-paint" /></g>

                      <g class="puppet__part puppet__part--chest" data-part="chest" data-idle-part="chest" data-pivot="618.5 985" data-idle-origin="618.5px 985px" style="--part-pivot: 618.5px 985px">
                        <g class="puppet__voice-layer" data-voice-part="chest" data-voice-origin="618.5px 985px">
                          <g class="puppet__paint" clip-path="url(#mikwhale-clip-chest)"><use href="#mikwhale-rig-paint" /></g>
                        </g>
                      </g>
                      <g class="puppet__part puppet__part--paw" data-part="paw-left" data-idle-part="paw-left" data-pivot="348 634" data-idle-origin="348px 634px" style="--part-pivot: 348px 634px">
                        <g class="puppet__voice-layer" data-voice-part="paw-left" data-voice-origin="348px 634px">
                          <g class="puppet__paint" clip-path="url(#mikwhale-clip-paw-left)"><use href="#mikwhale-rig-paint" /></g>
                        </g>
                      </g>
                      <g class="puppet__part puppet__part--paw" data-part="paw-right" data-idle-part="paw-right" data-pivot="889 634" data-idle-origin="889px 634px" style="--part-pivot: 889px 634px">
