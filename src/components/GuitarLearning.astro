<section class="guitar-learning" data-guitar-learning aria-label="Guitar learning illustration">
  <div class="guitar-actions"><div><h2>Try a movement outcome</h2><p>Choose a strum. One slow cycle plays, then rests with the learned change.</p></div><div class="guitar-buttons"><button type="button" data-strum="good">Strum guitar well</button><button type="button" data-strum="poor">Strum guitar poorly</button><button type="button" data-learning-reset>↺ Reset</button></div></div>
  <div class="learning-screen" data-fullscreen-surface>
    <svg class="learning-circuit" viewBox="0 0 1280 680" role="img" aria-labelledby="learning-title learning-desc">
      <title id="learning-title">Learning from a guitar strum</title><desc id="learning-desc">Complete basal ganglia context. Green arrows excite, red bars inhibit, and purple dopamine modulates. Circle size within striatum represents learned cortical input strength, not neuron size or firing rate.</desc>
      <defs><marker id="learn-excite" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#418329"/></marker><marker id="learn-inhibit" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="9" markerHeight="10" orient="auto"><path d="M8 0V10" stroke="#D52B30" stroke-width="3"/></marker><marker id="learn-dopamine" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="#BA4DA8"/></marker></defs>
      <text x="48" y="32" class="diagram-eyebrow">BASAL GANGLIA</text><text x="48" y="76" class="diagram-heading">Learning from a strum</text>
      <text x="825" y="34" class="diagram-note">Striatal circle size = learned input strength</text><text x="825" y="60" class="diagram-note">Traces = relative firing frequency</text>
      <g class="circuit-connections" fill="none" stroke-width="2.5">
        <path data-flow="input" data-cortex-edge d="M560 182V228" stroke="#418329" marker-end="url(#learn-excite)"/>
        <path data-flow="dopamine" data-dopamine-edge d="M250 250L300 215H530V228" stroke="#BA4DA8" marker-end="url(#learn-dopamine)"/>
        <path data-flow="nogo" d="M448 430V448" stroke="#D52B30" marker-end="url(#learn-inhibit)"/>
        <path data-flow="go" d="M650 430V543" stroke="#D52B30" marker-end="url(#learn-inhibit)"/>
        <path data-flow="gpe" d="M445 518L306 543" stroke="#D52B30" marker-end="url(#learn-inhibit)"/>
        <path data-flow="stn" d="M395 582H590" stroke="#418329" marker-end="url(#learn-excite)"/>
        <path data-flow="gpi" d="M775 583L1034 441" stroke="#D52B30" marker-end="url(#learn-inhibit)"/>
        <path data-flow="thalamus" d="M1056 347L851 191" stroke="#418329" marker-end="url(#learn-excite)"/>
      </g>
      <g data-signal-layer aria-hidden="true"></g>
      <g class="circuit-node" data-cortex><rect x="388" y="101" width="547" height="81"/><text x="662" y="135" class="node-title">Cortex</text><text x="505" y="151" class="node-detail">Movement input</text><text x="810" y="151" class="node-detail">Return</text></g>
      <g class="circuit-node" data-snc><rect x="60" y="226" width="190" height="92"/><text x="155" y="261" class="node-title">SNc</text><text x="155" y="281" class="dopamine-label" data-dopamine-label>Dopamine baseline</text></g>
      <text x="60" y="345" class="diagram-note">Substantia nigra</text><text x="60" y="368" class="diagram-note">pars compacta</text>
      <text x="300" y="199" class="dopamine-label">dopamine · modulates</text>
      <g class="circuit-node"><rect x="346" y="235" width="408" height="195"/><text x="550" y="266" class="node-title">Striatum</text><line x1="550" x2="550" y1="281" y2="418" class="diagram-divider"/>
        <text x="448" y="293" class="node-detail node-bold">D2 · No-Go</text><text x="650" y="293" class="node-detail node-bold">D1 · Go</text>
        <circle data-nogo-marker class="strength-marker strength-marker--nogo" cx="448" cy="351" r="32"/><circle data-go-marker class="strength-marker strength-marker--go" cx="650" cy="351" r="32"/>
        <text x="448" y="359" class="strength-label">NO</text><text x="650" y="359" class="strength-label">YES</text>
      </g>
      <g class="circuit-node" data-gpe><rect x="362" y="455" width="174" height="63"/><text x="449" y="484" class="node-title">GPe</text></g>
      <g class="circuit-node" data-stn><rect x="219" y="550" width="176" height="63"/><text x="307" y="579" class="node-title">STN</text></g>
      <g class="circuit-node" data-gpi><rect x="598" y="550" width="176" height="67"/><text x="686" y="579" class="node-title">GPi</text></g>
      <g class="circuit-node" data-thalamus><rect x="987" y="346" width="227" height="88"/><text x="1100" y="379" class="node-title">Thalamus</text><text x="1100" y="399" class="node-detail">Excitatory return</text></g>
      <g data-rate-layer aria-hidden="true"></g>
      <text x="855" y="590" class="diagram-note" fill="#D52B30">■ GABA · inhibits</text><text x="855" y="620" class="diagram-note" fill="#418329">▶ Glutamate · excites</text>
      <text x="48" y="660" class="diagram-note" data-learning-summary>GPi provides the ongoing inhibitory brake on the thalamus.</text>
    </svg>
    <div class="learning-caption" aria-live="polite"><span data-learning-step-label>READY</span><p data-learning-caption>The striatal circles begin at their reference size. Choose an outcome to see how it changes future movement selection.</p></div>
  </div>
  <div class="learning-progress" aria-label="Explanation steps">{['Attempt', 'Outcome', 'Dopamine', 'Learning', 'Learned bias'].map((name, i) => <span data-learning-step={i}><small>{i + 1}</small>{name}</span>)}</div>
  <div class="learning-controls"><button type="button" data-learning-play disabled>Ⅱ Pause cycle</button><span data-learning-count>0 / 3 learning trials</span><button type="button" data-learning-fullscreen>⛶ Fullscreen</button></div>
  <p class="learning-limit">Up to three strums, then reset. Circle size represents learned cortical–striatal strength. Timing and size changes are illustrative.</p>
</section>
