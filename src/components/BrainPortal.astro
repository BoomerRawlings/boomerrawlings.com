---
import '../styles/brain-portal.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/teko/400.css';
---
<section id="brain-portal" class="portal-loading" aria-label="Brain study space">
  <canvas id="portal-canvas" aria-hidden="true"></canvas>
  <div class="portal-atmosphere" aria-hidden="true"></div>
  <div class="portal-frame" aria-hidden="true"><span>COGNITION / MEMORY / DISCOVERY</span><span>BR — NEUROSCIENCE</span></div>
  <header class="portal-header" inert>
    <button class="portal-brand" id="portal-home" aria-label="Brain study home"><span class="portal-brand-mark" aria-hidden="true">B</span><span>BRAIN<small>NEURAL STUDY INTERFACE</small></span></button>
    <div class="portal-utility"><button id="portal-back" hidden>← Back</button><button id="portal-motion" aria-pressed="true" aria-label="Pause ambient motion">Ⅱ <span>Motion</span></button><a href="/" aria-label="Boomer Rawlings home">BR ↗</a></div>
  </header>
  <div id="portal-stage" class="portal-stage" inert aria-live="off"></div>
  <footer class="portal-footer"><span class="portal-atlas-credit"><a href="https://download.alleninstitute.org/informatics-archive/allen_human_reference_atlas_3d_2020/version_1/" target="_blank" rel="noopener noreferrer">Ding et al. / Allen Institute</a><b>·</b><a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a><small>Simplified atlas geometry</small></span><span>BOOMER RAWLINGS <b> / </b> NEUROSCIENCE</span></footer>
  <div id="portal-intro" role="status" aria-label="BRAIN. Boomer’s ridiculously ambitious interactive neuroscience. The study space opens shortly.">
    <div class="intro-coordinate" aria-hidden="true">BRAIN / INITIALIZING STUDY SPACE</div>
    <div class="intro-reticle" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="intro-wordmark" aria-hidden="true"><span class="intro-wordmark-text">BRAIN</span><small>EVERY CONNECTION BEGINS SOMEWHERE</small></div>
    <div id="intro-expansion" aria-hidden="true"><span class="intro-expansion-line">BOOMER’S RIDICULOUSLY</span><span class="intro-expansion-line">AMBITIOUS INTERACTIVE</span><span class="intro-expansion-line">NEUROSCIENCE</span></div>
    <div class="intro-copy"><p class="intro-label">A NEW CONNECTION<span>YOUR NEURAL STUDY SPACE</span></p><div class="intro-progress" aria-hidden="true"></div><p class="intro-status" aria-hidden="true"><span>PRINTING A NEW POSSIBILITY</span><span>THOUGHT BECOMES STRUCTURE</span><span>READY TO EXPLORE</span></p></div>
  </div>
</section>
<noscript><style>#brain-portal {display:none!important} #brain-legacy {display:block!important}</style></noscript>
