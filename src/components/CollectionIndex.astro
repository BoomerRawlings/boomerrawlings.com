---
import { getCollection } from 'astro:content';
import CuratorGuide from './CuratorGuide.astro';

interface Props {
  type: 'work' | 'research' | 'writing' | 'photography';
  title: string;
  introduction: string;
  eyebrow: string;
  includeSlugs?: string[];
  guide?: {
    messages: string[];
    nextExhibit: {
      href: string;
      label: string;
    };
  };
  source?: {
    href: string;
    label: string;
  };
}

const { type, title, introduction, eyebrow, includeSlugs, guide, source } = Astro.props;
const entries = (await getCollection('archive', ({ data }) =>
  data.status === 'published' && (includeSlugs ? includeSlugs.includes(data.slug) : data.type === type)
)).sort((a, b) => {
  if (includeSlugs) return includeSlugs.indexOf(a.data.slug) - includeSlugs.indexOf(b.data.slug);
  if (!a.data.date && !b.data.date) return a.data.title.localeCompare(b.data.title);
  if (!a.data.date) return 1;
  if (!b.data.date) return -1;
  return b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title);
});
---

<section class:list={['page-intro', { 'page-intro--guided': guide }]}>
  <p class="eyebrow">{eyebrow}</p>
  <h1>{title}</h1>
  {source ? (
    <div class="page-deck">
      <p>{introduction}</p>
      <a href={source.href}>{source.label}</a>
    </div>
  ) : (
    <p class="page-deck">{introduction}</p>
  )}
  {guide && (
    <CuratorGuide
      headingId={`curator-${type}`}
      messages={guide.messages}
      nextExhibit={guide.nextExhibit}
    />
  )}
</section>

{entries.length > 0 && (
  <section class="listing" aria-label={title}>
    <ol>
      {entries.map((entry) => (
        <li>
          <a href={entry.data.externalUrl ?? '/' + entry.data.type + '/' + entry.data.slug + '/'}>
            <strong>
              {entry.data.title}
              {entry.data.projectStage && <> <span class="project-stage">{entry.data.projectStage}</span></>}
            </strong>
            <small>{entry.data.description}</small>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}
