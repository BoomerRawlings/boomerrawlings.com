%%{init: {"flowchart": {"curve": "linear", "nodeSpacing": 38, "rankSpacing": 52, "padding": 8}}}%%
flowchart LR
  accTitle: Local-first media intelligence and catalog signal path
  accDescr: A read-only source moves through identity, preparation, verification, analysis, evidence capture, indexing, and local viewing. Uncertain state stops before a model call.

  source["01 / SOURCE"]
  identity["02 / IDENTIFY"]
  prepare["03 / PREPARE"]
  gate{"04"}
  analyze["05 / ANALYZE"]
  commit["06 / RECORD"]
  catalog["07 / INDEX"]
  viewer["08 / VIEW"]
  source --> identity --> prepare --> gate
  gate --> analyze --> commit --> catalog --> viewer

  classDef stage fill:transparent,stroke:transparent,color:#f5f0e6,font-family:Arial Narrow,font-size:28px,font-weight:600
  classDef first fill:transparent,stroke:transparent,color:#ffcd00,font-family:Arial Narrow,font-size:28px,font-weight:600
  classDef decision fill:#ffcd00,stroke:#c69214,color:#182b49,stroke-width:2px,font-family:Arial Narrow,font-size:22px,font-weight:700
  classDef last fill:transparent,stroke:transparent,color:#00c6d7,font-family:Arial Narrow,font-size:28px,font-weight:600
  class source first
  class identity,prepare,analyze,commit,catalog stage
  class gate decision
  class viewer last

  linkStyle default stroke:#00c6d7,stroke-width:2.5px,color:#f5f0e6
